// Восстанавливает код маркировки, автоматически определяя границы AI.
// Поддерживает строки как с разделителями GS, так и без них.
Функция ВосстановитьКодМаркировки(Знач RawString) Экспорт

	// Очистка от текстовых меток разделителей.
	ЧистаяСтрока = СтрЗаменить(RawString, "[GS]", "");
	ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, "[FNC1]", "");
	ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, "<GS>", "");
	ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, " ", "");
	ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, Символ(29), "");
	ЧистаяСтрока = СокрЛП(ЧистаяСтрока);

	// Удаляем служебный FNC1, если он есть в начале.
	Если Лев(ЧистаяСтрока, 1) = Символ(232) Тогда
		ЧистаяСтрока = Сред(ЧистаяСтрока, 2);
	КонецЕсли;

	КодМаркировки = Новый Соответствие;
	КодМаркировки.Вставить("01", "");
	КодМаркировки.Вставить("21", "");
	КодМаркировки.Вставить("91", "");
	КодМаркировки.Вставить("92", "");

	Позиция = 1;
	ДлинаСтроки = СтрДлина(ЧистаяСтрока);

	Пока Позиция <= ДлинаСтроки Цикл
		Если Позиция + 1 <= ДлинаСтроки Тогда
			ВозможныйAI = Сред(ЧистаяСтрока, Позиция, 2);

			Если ВозможныйAI = "01" И КодМаркировки.Получить("01") = "" Тогда
				// GTIN всегда 14 цифр.
				Если Позиция + 15 <= ДлинаСтроки Тогда
					КодМаркировки.Вставить("01", Сред(ЧистаяСтрока, Позиция + 2, 14));
					Позиция = Позиция + 16;
					Продолжить;
				КонецЕсли;

			ИначеЕсли ВозможныйAI = "21" И КодМаркировки.Получить("21") = "" Тогда
				// Серийный номер - до следующего AI или до конца.
				СледующийAI = НайтиСледующийAI(ЧистаяСтрока, Позиция + 2);
				Если СледующийAI.Найдено Тогда
					Длина = СледующийAI.Позиция - (Позиция + 2);
					КодМаркировки.Вставить("21", Сред(ЧистаяСтрока, Позиция + 2, Длина));
					Позиция = СледующийAI.Позиция;
				Иначе
					КодМаркировки.Вставить("21", Сред(ЧистаяСтрока, Позиция + 2));
					Позиция = ДлинаСтроки + 1;
				КонецЕсли;
				Продолжить;

			ИначеЕсли ВозможныйAI = "91" И КодМаркировки.Получить("91") = "" Тогда
				// Ключ проверки - ровно 4 символа.
				Если Позиция + 5 <= ДлинаСтроки Тогда
					КодМаркировки.Вставить("91", Сред(ЧистаяСтрока, Позиция + 2, 4));
					Позиция = Позиция + 6;
				Иначе
					КодМаркировки.Вставить("91", Сред(ЧистаяСтрока, Позиция + 2));
					Позиция = ДлинаСтроки + 1;
				КонецЕсли;
				Продолжить;

			ИначеЕсли ВозможныйAI = "92" И КодМаркировки.Получить("92") = "" Тогда
				// Код проверки - всё до конца.
				КодМаркировки.Вставить("92", Сред(ЧистаяСтрока, Позиция + 2));
				Позиция = ДлинаСтроки + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Если КодМаркировки.Получить("01") = "" Тогда
		Возврат ЧистаяСтрока;
	КонецЕсли;

	Результат = "01" + КодМаркировки.Получить("01");

	Значение21 = КодМаркировки.Получить("21");
	Если Значение21 <> Неопределено И Значение21 <> "" Тогда
		Результат = Результат + "21" + Значение21;

		Значение91 = КодМаркировки.Получить("91");
		Значение92 = КодМаркировки.Получить("92");

		Если (Значение91 <> Неопределено И Значение91 <> "")
			ИЛИ (Значение92 <> Неопределено И Значение92 <> "") Тогда
			Результат = Результат + Символ(29);
		КонецЕсли;
	КонецЕсли;

	Значение91 = КодМаркировки.Получить("91");
	Если Значение91 <> Неопределено И Значение91 <> "" Тогда
		Результат = Результат + "91" + Значение91;

		Значение92 = КодМаркировки.Получить("92");
		Если Значение92 <> Неопределено И Значение92 <> "" Тогда
			Результат = Результат + Символ(29);
		КонецЕсли;
	КонецЕсли;

	Значение92 = КодМаркировки.Получить("92");
	Если Значение92 <> Неопределено И Значение92 <> "" Тогда
		Результат = Результат + "92" + Значение92;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Ищет ближайший AI 91 или 92 начиная с указанной позиции.
Функция НайтиСледующийAI(СтрокаПоиска, НачПозиция)
	Результат = Новый Структура("Найдено, Позиция, AI", Ложь, 0, "");
	ДлинаСтроки = СтрДлина(СтрокаПоиска);

	// Сначала ищем AI 91 с ожидаемой структурой: четыре символа и затем AI 92.
	// Это не позволяет принять "92" внутри серийного номера за начало хвоста.
	ПозицияAI = СтрНайти(СтрокаПоиска, "91",, НачПозиция);
	Пока ПозицияAI > 0 Цикл
		Если ПозицияAI + 8 <= ДлинаСтроки
			И Сред(СтрокаПоиска, ПозицияAI + 6, 2) = "92" Тогда
			Результат.Найдено = Истина;
			Результат.Позиция = ПозицияAI;
			Результат.AI = "91";
			Возврат Результат;
		КонецЕсли;

		ПозицияAI = СтрНайти(СтрокаПоиска, "91",, ПозицияAI + 2);
	КонецЦикла;

	// Если связки 91/92 нет, сохраняем прежнее поведение для отдельных AI.
	Позиция91 = СтрНайти(СтрокаПоиска, "91",, НачПозиция);
	Позиция92 = СтрНайти(СтрокаПоиска, "92",, НачПозиция);
	Если Позиция91 > 0 И (Позиция92 = 0 ИЛИ Позиция91 < Позиция92) Тогда
		Результат.Найдено = Истина;
		Результат.Позиция = Позиция91;
		Результат.AI = "91";
	ИначеЕсли Позиция92 > 0 Тогда
		Результат.Найдено = Истина;
		Результат.Позиция = Позиция92;
		Результат.AI = "92";
	КонецЕсли;

	Возврат Результат;
КонецФункции
