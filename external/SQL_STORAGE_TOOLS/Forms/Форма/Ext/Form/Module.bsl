// По выбранному полю хранения строки отбора заполняет тип и пустое значение.
&НаКлиенте
Процедура ПриИзмененииПоляОтбора(ТекущиеДанные, ЭлементЗначения)

	ТипЗначения = ТипЗначенияСравнения(ТекущиеДанные);
	ЭлементЗначения.ОграничениеТипа = ТипЗначения;
	ТекущиеДанные.Значение = ТипЗначения.ПривестиЗначение(Неопределено);

КонецПроцедуры

// Возвращает имя поля 1С строки отбора по ее таблице и полю хранения, пустую строку, если поле не найдено.
&НаКлиенте
Функция ИмяПоляОтбора(ТекущиеДанные)

	ИмяПоля = ДанныеВыбора().ИменаПолей[ТекущиеДанные.ИмяТаблицыХранения + "." + ТекущиеДанные.ПолеХранения];

	Возврат ?(ИмяПоля = Неопределено, "", ИмяПоля);

КонецФункции

// Возвращает ограничение типа значения строки отбора: для LIKE - строка, иначе тип поля.
&НаКлиенте
Функция ТипЗначенияСравнения(ТекущиеДанные)

	Если ТекущиеДанные.ВидСравнения = "LIKE" Тогда
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;

	Возврат ТипЗначенияПоляОтбора(ТекущиеДанные.ОбъектМетаданных, ИмяПоляОтбора(ТекущиеДанные));

КонецФункции

&НаКлиенте
Функция ТипЗначенияПоляОтбора(ОбъектМетаданных, Поле)

	Если ТипыПолейОтбора = Неопределено Тогда
		ТипыПолейОтбора = Новый Соответствие;
	КонецЕсли;

	Ключ = ОбъектМетаданных + "|" + Поле;
	ТипЗначения = ТипыПолейОтбора[Ключ];
	Если ТипЗначения = Неопределено Тогда
		ТипЗначения = ТипЗначенияОтбора(ОбъектМетаданных, Поле);
		ТипыПолейОтбора.Вставить(Ключ, ТипЗначения);
	КонецЕсли;

	Возврат ТипЗначения;

КонецФункции

&НаСервере
Функция ТипЗначенияОтбора(ОбъектМетаданных, Поле)

	Возврат ПолучитьКонтекст().ТипЗначенияПоля(ОбъектМетаданных, Поле);

КонецФункции

// Возвращает кэш списков выбора таблиц и полей, при необходимости получает его с сервера.
&НаКлиенте
Функция ДанныеВыбора()

	Если КэшВыбора = Неопределено Тогда
		КэшВыбора = ДанныеВыбораНаСервере();
	КонецЕсли;

	Возврат КэшВыбора;

КонецФункции

&НаСервере
Функция ДанныеВыбораНаСервере()

	Данные = Неопределено;
	Сообщение = "";
	Если Не ПолучитьКонтекст().ДанныеВыбора(Данные, Сообщение) Тогда
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Данные = Новый Структура("ГлавныйОбъект, ОсновныеТаблицы, Таблицы, ИменаТаблиц, Поля, ИменаПолей",
			"",
			Новый Соответствие,
			Новый СписокЗначений,
			Новый Соответствие,
			Новый Соответствие,
			Новый Соответствие);
	КонецЕсли;

	Возврат Данные;

КонецФункции

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(Элемент, Список)

	Элемент.СписокВыбора.Очистить();
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементСписка Из Список Цикл
		Элемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ВидЗапросаПриИзменении(Элемент)

	ОбновитьСкрипт();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыборку(Команда)

	Если ВыполнитьВыборкуНаСервере() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВизуализация;
		ТекущийЭлемент = Элементы.Визуализация;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВыполнитьВыборкуНаСервере()

	Контекст = ПолучитьКонтекст();
	Сообщение = "";
	Если Не Контекст.ВывестиВыборкуSQL(Сообщение) Тогда
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Возврат Ложь;
	КонецЕсли;
	СохранитьКонтекст(Контекст);

	Возврат Истина;

КонецФункции

// Перестраивает SQLСкрипт по виду запроса; ошибка формирования выводится в поле скрипта комментарием.
&НаСервере
Процедура ОбновитьСкрипт()

	Скрипт = "";
	Сообщение = "";
	Если ПолучитьКонтекст().СформироватьСкрипт(Скрипт, Сообщение) Тогда
		Объект.SQLСкрипт = Скрипт;
	Иначе
		Объект.SQLСкрипт = "-- " + Сообщение;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуВнешнейОбработки(Действие, ВремяЗапуска = Неопределено, ВремяЗавершения = Неопределено)
	
	ВремяЗапуска = ТекущаяДатаСеанса();
	Контекст = ПолучитьКонтекст();

	Контекст.ВыполнитьКоманду(Действие, Неопределено);
	
	СохранитьКонтекст(Контекст);
	ВремяЗавершения = ТекущаяДатаСеанса();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВнешнейОбработки(Команда)
	
	Перем ВремяЗапуска, ВремяЗавершения;
	ВыполнитьКомандуВнешнейОбработки(Команда.Имя, ВремяЗапуска, ВремяЗавершения);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВизуализация;
	
	
	Если Объект.ОткрыватьЛоги Тогда
		
		Отбор = Новый Структура("Пользователь, СобытиеЖурналаРегистрации, ДатаНачала, ДатаОкончания, Данные, Сеанс, Уровень");
	
		Отбор.ДатаНачала = ВремяЗапуска;
		Отбор.ДатаОкончания = ВремяЗавершения;
		Отбор.СобытиеЖурналаРегистрации = СобытиеЖурналаРегистрации(Команда.Имя);
			
		ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(Отбор, ЭтаФорма);

	КонецЕсли;
	
	Если ПустаяСтрока(Объект.АдресВременноеХранилище) Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = Неопределено;
	Если ОбнаружитьФайлДляОтображения(Объект.АдресВременноеХранилище, ИмяФайла) Тогда
		ТД = Новый ТекстовыйДокумент;
		ПрочитатьВТекстовыйДокумент(ТД, ИмяФайла);
		ТД.Показать("Остатки для маркетплейса");
	КонецЕсли;
	
	//ПоместитьВоВременноеХранилище(Неопределено, Объект.УникальныйИдентификатор);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОбнаружитьФайлДляОтображения(Адрес, ИмяФайла)
	
	Если ПустаяСтрока(Адрес) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИнформацияДляПоказа = ПолучитьИзВременногоХранилища(Адрес);
	
	Если ТипЗнч(ИнформацияДляПоказа) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИнформацияДляПоказа.Свойство("ИмяФайла", ИмяФайла) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции	

&НаСервереБезКонтекста
Функция ПрочитатьВТекстовыйДокумент(ТД, ИмяФайла)
	ТД.Прочитать(ИмяФайла);
КонецФункции	

&НаСервере
Функция СобытиеЖурналаРегистрации(Параметр = Неопределено)
	Контекст = ПолучитьКонтекст();
	Возврат Контекст.ПолучитьИмяСобытия(Параметр);
КонецФункции

&НаКлиенте
Процедура ОтчетПриИзменении(Элемент)

	Если ВыполнитьОтчет = "" Тогда
		Возврат;
	КонецЕсли;

	ПрименитьВизуализацию(ВыполнитьОтчет);
	ВыполнитьОтчет = "";
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВизуализация;
	ТекущийЭлемент = Элементы.Визуализация;

КонецПроцедуры

&НаСервере
Процедура ПрименитьВизуализацию(Действие, ДопПараметры = Неопределено)
	
	Элементы.Визуализация.Доступность = Ложь;
	Контекст = ПолучитьКонтекст();
	Контекст.ПрименитьВизуализацию(Действие, ДопПараметры);
	СохранитьКонтекст(Контекст);
	Элементы.Визуализация.Доступность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьЛоги(Команда)
	
	ИмяСобытия = СобытиеЖурналаРегистрации();
	Отбор = ПолучитьОтборПоВсемСобытиям(ИмяСобытия);
	ЖурналРегистрацииКлиент.ОткрытьЖурналРегистрации(Отбор, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УчетныеДанные(Команда)

	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	ЧастиИмени[ЧастиИмени.ВГраница()] = "ФормаУчетныхДанных";
	ОткрытьФорму(СтрСоединить(ЧастиИмени, "."), , ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьОбъектыМетаданных(Команда)

	ВыбранныеОбъекты = Новый СписокЗначений;
	Для Каждого Строка Из Объект.ОбъектыМетаданных Цикл
		ВыбранныеОбъекты.Добавить(Строка.ПолноеИмя);
	КонецЦикла;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыбранныеОбъектыМетаданных", ВыбранныеОбъекты);
	ПараметрыФормы.Вставить("СпособГруппировкиОбъектов", "Везде");

	// Только объекты с основной таблицей хранения.
	Коллекции = Новый СписокЗначений;
	Коллекции.ЗагрузитьЗначения(СтрРазделить("Справочники,Документы,Перечисления,ПланыВидовХарактеристик,ПланыСчетов,"
		+ "ПланыВидовРасчета,ПланыОбмена,РегистрыСведений,РегистрыНакопления,РегистрыБухгалтерии,РегистрыРасчета,"
		+ "БизнесПроцессы,Задачи", ","));
	ПараметрыФормы.Вставить("КоллекцииВыбираемыхОбъектовМетаданных", Коллекции);

	ОткрытьФорму("ОбщаяФорма.ВыборОбъектовМетаданных",
		ПараметрыФормы,
		ЭтаФорма,
		,
		,
		,
		Новый ОписаниеОповещения("ПодобратьОбъектыМетаданныхЗавершение", ЭтаФорма),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьОбъектыМетаданныхЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;

	ПрежнийГлавный = "";
	Для Каждого СтрокаОбъекта Из Объект.ОбъектыМетаданных Цикл
		Если СтрокаОбъекта.Главный Тогда
			ПрежнийГлавный = СтрокаОбъекта.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;

	Объект.ОбъектыМетаданных.Очистить();
	Для Каждого Элемент Из Результат Цикл
		Объект.ОбъектыМетаданных.Добавить().ПолноеИмя = Элемент.Значение;
	КонецЦикла;
	Объект.ВыбранныеПоля.Очистить();
	Объект.ОсновнойОтборЗапроса.Очистить();
	Объект.ОтборСоединений.Очистить();
	КэшВыбора = Неопределено;

	Если Объект.ОбъектыМетаданных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Главные = Объект.ОбъектыМетаданных.НайтиСтроки(Новый Структура("ПолноеИмя", ПрежнийГлавный));
	Если Главные.Количество() > 0 Тогда
		Главные[0].Главный = Истина;
	Иначе
		Объект.ОбъектыМетаданных[0].Главный = Истина;
	КонецЕсли;

	СформироватьСтруктуруХранения();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВизуализация;
	ТекущийЭлемент = Элементы.Визуализация;

КонецПроцедуры

&НаСервере
Процедура СформироватьСтруктуруХранения()

	ПрименитьВизуализацию("STORAGE_STRUCTURE");
	ОбновитьСкрипт();

КонецПроцедуры

&НаСервере
Функция ПолучитьОтборПоВсемСобытиям(ИмяСобытия)

	Отбор = Новый Структура("Пользователь, СобытиеЖурналаРегистрации, ДатаНачала, ДатаОкончания, Данные, Сеанс, Уровень");
	
	ЗначенияОтбора = ПолучитьЗначенияОтбораЖурналаРегистрации("Событие");
	
	СписокСобытий = Новый Массив();
	Для Каждого К Из ЗначенияОтбора.Событие Цикл
		Если Найти(К.Ключ, ИмяСобытия) > 0 Тогда
			СписокСобытий.Добавить(К.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокСобытий.Количество() > 0 Тогда
		Отбор.СобытиеЖурналаРегистрации = СписокСобытий;
	КонецЕсли;
	
	Возврат Отбор;

КонецФункции

#Region Контекст

&НаСервере
Функция ПолучитьКонтекст()
	Возврат РеквизитФормыВЗначение("Объект");
КонецФункции

&НаСервере
Процедура СохранитьКонтекст(Контекст)
	ЗначениеВРеквизитФормы(Контекст, "Объект");
КонецПроцедуры

#EndRegion
