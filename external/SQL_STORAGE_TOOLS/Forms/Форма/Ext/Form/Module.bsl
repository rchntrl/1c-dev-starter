Процедура ПриОткрытии(Отказ)

КонецПроцедуры

&НаКлиенте
Процедура УзелПланаОбменаОткрытие(Элемент, СтандартнаяОбработка)
	Стандартнаяобработка = Ложь;
	ОбменДаннымиКлиент.ОткрытьСоставОтправляемыхДанных(Объект.УзелПланаОбмена);
КонецПроцедуры

&НаКлиенте
Процедура ВизуализацияОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)

	СтандартнаяОбработка = Ложь;
	ЗначениеРасшифровки = Неопределено;
	ПредставлениеСсылки = "";
	Если ДобавитьОтборПоРасшифровке(Расшифровка, ЗначениеРасшифровки, ПредставлениеСсылки) Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЗапрос;
	ИначеЕсли ТипЗнч(ЗначениеРасшифровки) = Тип("Строка") И СтрНачинаетсяС(ЗначениеРасшифровки, "e1cib/") Тогда
		// Навигационная ссылка ссылочного поля выборки SQL (СпособОткрытияСсылки = "НавигационнаяСсылка").
		ПерейтиПоНавигационнойСсылке(ЗначениеРасшифровки);
	ИначеЕсли ЗначениеЗаполнено(ЗначениеРасшифровки) Тогда
		// Ссылка 1С ссылочного поля выборки SQL (СпособОткрытияСсылки = "Ссылка"): вместо 0x... в ячейке - ее представление.
		Если ЗначениеЗаполнено(ПредставлениеСсылки) И Элемент.ТекущаяОбласть <> Неопределено Тогда
			Элемент.ТекущаяОбласть.Текст = ПредставлениеСсылки;
		КонецЕсли;
		ПоказатьЗначение(, ЗначениеРасшифровки);
	КонецЕсли;

КонецПроцедуры

// По ПутьПоляХранения расшифровки определяет таблицу поля: поле основной таблицы главного объекта добавляется
// строкой в ОсновнойОтборЗапроса, поле присоединенной таблицы - строкой в ОтборСоединений, по полю
// неприсоединенной таблицы добавляется или включается соединение с ней.
// Иначе возвращает в ЗначениеРасшифровки значение поля, если в элементе расшифровки оно одно,
// а для ссылки - ее представление в ПредставлениеСсылки.
&НаСервере
Функция ДобавитьОтборПоРасшифровке(Знач Расшифровка, ЗначениеРасшифровки, ПредставлениеСсылки)

	// В отчете выборки SQL нет ПутьПоляХранения: по нему возвращается только значение поля, например ссылка.
	Если ПустаяСтрока(Объект.ДанныеРасшифровки) Тогда
		Возврат Ложь;
	КонецЕсли;

	ДанныеРасшифровкиКомпоновки = ПолучитьИзВременногоХранилища(Объект.ДанныеРасшифровки);
	ЭлементРасшифровки = ДанныеРасшифровкиКомпоновки.Элементы.Получить(Расшифровка);

	СобственныеПоля = ЭлементРасшифровки.ПолучитьПоля();
	Если СобственныеПоля.Количество() = 1 Тогда
		ЗначениеРасшифровки = СобственныеПоля.Получить(0).Значение;
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеРасшифровки)) Тогда
			ПредставлениеСсылки = Строка(ЗначениеРасшифровки);
		КонецЕсли;
	КонецЕсли;

	Поля = Новый Соответствие;
	СобратьПоляРасшифровки(ЭлементРасшифровки, Поля);
	ПутьПоля = Поля["ПутьПоляХранения"];
	Если ПутьПоля = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ЧастиПути = СтрРазделить(ПутьПоля, ".");
	ИмяТаблицыХранения = ЧастиПути[0];
	ПолеХранения = ЧастиПути[1];
	ИмяПоля = ?(Поля["ИмяПоля"] = Неопределено, "", Поля["ИмяПоля"]);

	Контекст = ПолучитьКонтекст();
	ГлавныйОбъект = Контекст.ГлавныйОбъект();
	ГлавнаяТаблица = "";
	Сообщение = "";
	Если Не Контекст.ОсновнаяТаблицаОбъекта(ГлавныйОбъект, ГлавнаяТаблица, Сообщение) Тогда
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Возврат Ложь;
	КонецЕсли;

	Если ИмяТаблицыХранения = ГлавнаяТаблица Тогда
		ТаблицаОтбора = Объект.ОсновнойОтборЗапроса;
		ЭлементТаблицы = Элементы.ОсновнойОтборЗапроса;
		Элементы.ГруппаНастройкиЗапроса.ТекущаяСтраница = Элементы.ГруппаОсновнойОтбор;
		ОбъектМетаданных = ГлавныйОбъект;
	Иначе
		Соединения = Объект.Соединения.НайтиСтроки(Новый Структура("Использование, ИмяТаблицыХранения", Истина, ИмяТаблицыХранения));
		Если Соединения.Количество() = 0 Тогда
			ВключитьСоединениеПоРасшифровке(Контекст, ИмяТаблицыХранения, Поля["ИмяТаблицы"], ИмяПоля, ПолеХранения);
			ОбновитьСкрипт();
			Возврат Истина;
		КонецЕсли;
		ТаблицаОтбора = Объект.ОтборСоединений;
		ЭлементТаблицы = Элементы.ОтборСоединений;
		Элементы.ГруппаНастройкиЗапроса.ТекущаяСтраница = Элементы.ГруппаСоединения;
		ОбъектМетаданных = Соединения[0].ИмяТаблицы;
	КонецЕсли;

	ТипЗначения = Контекст.ТипЗначенияПоля(ОбъектМетаданных, ИмяПоля);

	СтрокаОтбора = ТаблицаОтбора.Добавить();
	СтрокаОтбора.Использование = Истина;
	СтрокаОтбора.ОбъектМетаданных = ОбъектМетаданных;
	СтрокаОтбора.ИмяТаблицыХранения = ИмяТаблицыХранения;
	СтрокаОтбора.ПолеХранения = ПолеХранения;
	СтрокаОтбора.ВидСравнения = "=";
	СтрокаОтбора.Значение = ТипЗначения.ПривестиЗначение(Неопределено);
	ЭлементТаблицы.ТекущаяСтрока = СтрокаОтбора.ПолучитьИдентификатор();
	ТекущийЭлемент = ЭлементТаблицы;

	ОбновитьСкрипт();

	Возврат Истина;

КонецФункции

// Включает выключенное соединение с таблицей или добавляет новое: INNER по полю расшифровки присоединяемой таблицы,
// поле главной таблицы подбирается по типам (см. ПолеГлавнойТаблицыСоединения). Пустые поля строки дозаполняются.
&НаСервере
Процедура ВключитьСоединениеПоРасшифровке(Контекст, ИмяТаблицыХранения, Знач ИмяТаблицы, ИмяПоля, ПолеХранения)

	Если ИмяТаблицы = Неопределено Тогда
		Данные = Неопределено;
		Сообщение = "";
		Если Контекст.ДанныеВыбора(Данные, Сообщение) Тогда
			ИмяТаблицы = Данные.ИменаТаблиц[ИмяТаблицыХранения];
		КонецЕсли;
		ИмяТаблицы = ?(ИмяТаблицы = Неопределено, "", ИмяТаблицы);
	КонецЕсли;

	Соединения = Объект.Соединения.НайтиСтроки(Новый Структура("ИмяТаблицыХранения", ИмяТаблицыХранения));
	Если Соединения.Количество() = 0 Тогда
		Соединение = Объект.Соединения.Добавить();
		Соединение.ИмяТаблицыХранения = ИмяТаблицыХранения;
		Соединение.ИмяТаблицы = ИмяТаблицы;
	Иначе
		Соединение = Соединения[0];
	КонецЕсли;

	Соединение.Использование = Истина;
	Если ПустаяСтрока(Соединение.ВидСоединения) Тогда
		Соединение.ВидСоединения = "INNER";
	КонецЕсли;
	Если ПустаяСтрока(Соединение.ИмяТаблицы) Тогда
		Соединение.ИмяТаблицы = ИмяТаблицы;
	КонецЕсли;
	Если ПустаяСтрока(Соединение.ПолеСоединяемойТаблицы) Тогда
		Соединение.ПолеСоединяемойТаблицы = ПолеХранения;
	КонецЕсли;

	// Подбор по типам возможен, только если ключ присоединяемой таблицы - поле расшифровки.
	Если ПустаяСтрока(Соединение.ПолеГлавнойТаблицы) И Соединение.ПолеСоединяемойТаблицы = ПолеХранения Тогда
		ПолеГлавнойТаблицы = "";
		Сообщение = "";
		Если Контекст.ПолеГлавнойТаблицыСоединения(Соединение.ИмяТаблицы, ИмяПоля, ПолеХранения, ПолеГлавнойТаблицы, Сообщение) Тогда
			Соединение.ПолеГлавнойТаблицы = ПолеГлавнойТаблицы;
		Иначе
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
		КонецЕсли;
	КонецЕсли;

	Элементы.ГруппаНастройкиЗапроса.ТекущаяСтраница = Элементы.ГруппаСоединения;
	Элементы.Соединения.ТекущаяСтрока = Соединение.ПолучитьИдентификатор();
	ТекущийЭлемент = Элементы.Соединения;
	Если ПустаяСтрока(Соединение.ПолеГлавнойТаблицы) Тогда
		Элементы.Соединения.ТекущийЭлемент = Элементы.СоединенияПолеГлавнойТаблицы;
	КонецЕсли;

КонецПроцедуры

// Собирает значения полей элемента расшифровки и его родителей; поля элемента важнее полей родителей.
&НаСервере
Процедура СобратьПоляРасшифровки(ЭлементРасшифровки, Поля)

	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для Каждого ЗначениеПоля Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			Если Поля[ЗначениеПоля.Поле] = Неопределено Тогда
				Поля.Вставить(ЗначениеПоля.Поле, ЗначениеПоля.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		СобратьПоляРасшифровки(Родитель, Поля);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыМетаданныхГлавныйПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОбъектыМетаданных.ТекущиеДанные;
	Если ТекущиеДанные.Главный Тогда
		Для Каждого СтрокаОбъекта Из Объект.ОбъектыМетаданных Цикл
			Если СтрокаОбъекта.ПолучитьИдентификатор() <> Элементы.ОбъектыМетаданных.ТекущаяСтрока Тогда
				СтрокаОбъекта.Главный = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	КэшВыбора = Неопределено;
	ОбновитьСкрипт();

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыМетаданныхПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	КэшВыбора = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыМетаданныхПослеУдаления(Элемент)

	КэшВыбора = Неопределено;
	ОбновитьСкрипт();

КонецПроцедуры

&НаКлиенте
Процедура ВключатьДвиженияПриИзменении(Элемент)

	КэшВыбора = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура ВыбиратьПоляСоединенийПриИзменении(Элемент)

	Элементы.ВыбранныеПоляИмяТаблицыХранения.Видимость = Объект.ВыбиратьПоляСоединений;
	ОбновитьСкрипт();

КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСписокВыбора(Элементы.ВыбранныеПоляИмяТаблицыХранения, ТаблицыПолейВыборки());
	ЗаполнитьСписокВыбора(Элементы.ВыбранныеПоляПолеХранения, ДанныеВыбора().Поля[ТаблицаПоляВыборки(ТекущиеДанные)]);

КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.ИмяТаблицыХранения = ТаблицаПоляВыборки(Элемент.ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляИмяТаблицыХраненияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ВыбранныеПоля.ТекущиеДанные;
	ТекущиеДанные.ПолеХранения = "";
	ТекущиеДанные.Поле = "";
	ЗаполнитьСписокВыбора(Элементы.ВыбранныеПоляПолеХранения, ДанныеВыбора().Поля[ТаблицаПоляВыборки(ТекущиеДанные)]);

КонецПроцедуры

// По выбранному полю хранения заполняет имя поля 1С.
&НаКлиенте
Процедура ВыбранныеПоляПолеХраненияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ВыбранныеПоля.ТекущиеДанные;
	ИмяПоля = ДанныеВыбора().ИменаПолей[ТаблицаПоляВыборки(ТекущиеДанные) + "." + ТекущиеДанные.ПолеХранения];
	ТекущиеДанные.Поле = ?(ИмяПоля = Неопределено, "", ИмяПоля);

КонецПроцедуры

// Возвращает таблицу хранения строки полей выборки: пустая таблица - основная таблица главного объекта.
&НаКлиенте
Функция ТаблицаПоляВыборки(ТекущиеДанные)

	Если Не ПустаяСтрока(ТекущиеДанные.ИмяТаблицыХранения) Тогда
		Возврат ТекущиеДанные.ИмяТаблицыХранения;
	КонецЕсли;

	Данные = ДанныеВыбора();
	ГлавнаяТаблица = Данные.ОсновныеТаблицы[Данные.ГлавныйОбъект];

	Возврат ?(ГлавнаяТаблица = Неопределено, "", ГлавнаяТаблица);

КонецФункции

// Возвращает таблицы для полей выборки: основную таблицу главного объекта и таблицы используемых соединений;
// значение - имя таблицы хранения, представление - имя таблицы 1С.
&НаКлиенте
Функция ТаблицыПолейВыборки()

	Данные = ДанныеВыбора();
	Таблицы = Новый СписокЗначений;
	ГлавнаяТаблица = Данные.ОсновныеТаблицы[Данные.ГлавныйОбъект];
	Если ГлавнаяТаблица <> Неопределено Тогда
		Таблицы.Добавить(ГлавнаяТаблица, Данные.ГлавныйОбъект);
	КонецЕсли;

	Для Каждого Соединение Из Объект.Соединения Цикл
		Если Соединение.Использование И Таблицы.НайтиПоЗначению(Соединение.ИмяТаблицыХранения) = Неопределено Тогда
			Таблицы.Добавить(Соединение.ИмяТаблицыХранения, Соединение.ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;

	Возврат Таблицы;

КонецФункции

&НаКлиенте
Процедура ВыбранныеПоляПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ОбновитьСкрипт();

КонецПроцедуры

&НаКлиенте
Процедура ВыбранныеПоляПослеУдаления(Элемент)

	ОбновитьСкрипт();

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойОтборЗапросаПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объекты = Новый СписокЗначений;
	Для Каждого СтрокаОбъекта Из Объект.ОбъектыМетаданных Цикл
		Объекты.Добавить(СтрокаОбъекта.ПолноеИмя);
	КонецЦикла;
	ЗаполнитьСписокВыбора(Элементы.ОсновнойОтборЗапросаОбъектМетаданных, Объекты);
	ЗаполнитьСписокВыбора(Элементы.ОсновнойОтборЗапросаПолеХранения, ДанныеВыбора().Поля[ТекущиеДанные.ИмяТаблицыХранения]);

	Элементы.ОсновнойОтборЗапросаЗначение.ОграничениеТипа = ТипЗначенияСравнения(ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойОтборЗапросаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если Не НоваяСтрока Или Копирование Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.Использование = Истина;
	ТекущиеДанные.ВидСравнения = "=";
	ТекущиеДанные.ОбъектМетаданных = ДанныеВыбора().ГлавныйОбъект;
	ОсновнойОтборЗапросаОбъектМетаданныхПриИзменении(Элементы.ОсновнойОтборЗапросаОбъектМетаданных);

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойОтборЗапросаОбъектМетаданныхПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОсновнойОтборЗапроса.ТекущиеДанные;
	Данные = ДанныеВыбора();
	ИмяТаблицыХранения = Данные.ОсновныеТаблицы[ТекущиеДанные.ОбъектМетаданных];
	ТекущиеДанные.ИмяТаблицыХранения = ?(ИмяТаблицыХранения = Неопределено, "", ИмяТаблицыХранения);
	ТекущиеДанные.ПолеХранения = "";
	ЗаполнитьСписокВыбора(Элементы.ОсновнойОтборЗапросаПолеХранения, Данные.Поля[ТекущиеДанные.ИмяТаблицыХранения]);
	ПриИзмененииПоляОтбора(ТекущиеДанные, Элементы.ОсновнойОтборЗапросаЗначение);

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойОтборЗапросаПолеХраненияПриИзменении(Элемент)

	ПриИзмененииПоляОтбора(Элементы.ОсновнойОтборЗапроса.ТекущиеДанные, Элементы.ОсновнойОтборЗапросаЗначение);

КонецПроцедуры

// Для IS NULL и IS NOT NULL значение не нужно и очищается, для LIKE значение - строка.
&НаКлиенте
Процедура ОсновнойОтборЗапросаВидСравненияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ОсновнойОтборЗапроса.ТекущиеДанные;
	ТипЗначения = ТипЗначенияСравнения(ТекущиеДанные);
	Элементы.ОсновнойОтборЗапросаЗначение.ОграничениеТипа = ТипЗначения;
	Если ТекущиеДанные.ВидСравнения = "IS NULL" Или ТекущиеДанные.ВидСравнения = "IS NOT NULL" Тогда
		ТекущиеДанные.Значение = ТипЗначения.ПривестиЗначение(Неопределено);
	Иначе
		ТекущиеДанные.Значение = ТипЗначения.ПривестиЗначение(ТекущиеДанные.Значение);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОсновнойОтборЗапросаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ОбновитьСкрипт();

КонецПроцедуры

