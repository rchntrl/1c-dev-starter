	ТекущиеДанные.ИмяТаблицы = ?(ИмяТаблицы = Неопределено, "", ИмяТаблицы);
	ТекущиеДанные.ПолеСоединяемойТаблицы = "";
	ЗаполнитьСписокВыбора(Элементы.СоединенияПолеСоединяемойТаблицы, Данные.Поля[ТекущиеДанные.ИмяТаблицыХранения]);

КонецПроцедуры

