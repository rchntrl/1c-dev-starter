	КонецЕсли;

	Данные = ДанныеВыбора();
	ЗаполнитьСписокВыбора(Элементы.СоединенияИмяТаблицыХранения, Данные.Таблицы);
	ЗаполнитьСписокВыбора(Элементы.СоединенияПолеГлавнойТаблицы, Данные.Поля[Данные.ОсновныеТаблицы[Данные.ГлавныйОбъект]]);
	ЗаполнитьСписокВыбора(Элементы.СоединенияПолеСоединяемойТаблицы, Данные.Поля[ТекущиеДанные.ИмяТаблицыХранения]);

