#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = РеквизитФормыВЗначение("Объект");
	Описание = Обработка.ПрочитатьУчетныеДанные(Истина);
	ЗначенияПоУмолчанию = Обработка.ОписаниеУчетныхДанных().credentials;

	Идентификатор = Описание.id;
	Заголовок = СтрШаблон(НСтр("ru = 'Учетные данные: %1'; en = 'Credentials: %1'"), Идентификатор);

	СоздатьПоляУчетныхДанных(Описание, ЗначенияПоУмолчанию);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьПоляУчетныхДанных(Описание, ЗначенияПоУмолчанию)

	ТипСтрока = Новый ОписаниеТипов("Строка");
	СекретныеКлючи = Новый Структура(Описание.secretkeys);

	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого Поле Из Описание.credentials Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Поле.Ключ, ТипСтрока, , Поле.Ключ));
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Имена = Новый Массив;
	Для Каждого Поле Из Описание.credentials Цикл

		// Подсказка ввода со значением по умолчанию видна, если поле очищено.
		ЗначениеПоУмолчанию = ЗначенияПоУмолчанию[Поле.Ключ];
		ЭтаФорма[Поле.Ключ] = Поле.Значение;

		Элемент = Элементы.Добавить(Поле.Ключ, Тип("ПолеФормы"), Элементы.ГруппаПоля);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = Поле.Ключ;
		Если ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда
			Элемент.ПодсказкаВвода = ЗначениеПоУмолчанию;
		КонецЕсли;

		Если СекретныеКлючи.Свойство(Поле.Ключ) Тогда
			Элемент.РежимПароля = Истина;
			Если Описание.saved[Поле.Ключ] Тогда
				Элемент.ПодсказкаВвода = НСтр("ru = 'сохранено'; en = 'saved'");
			КонецЕсли;
		КонецЕсли;

		Имена.Добавить(Поле.Ключ);

	КонецЦикла;

	ИменаПолей = СтрСоединить(Имена, ",");

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	Данные = Новый Структура;
	Для Каждого Имя Из СтрРазделить(ИменаПолей, ",", Ложь) Цикл
		Данные.Вставить(Имя, ЭтаФорма[Имя]);
	КонецЦикла;

	РеквизитФормыВЗначение("Объект").ЗаписатьУчетныеДанные(Данные);

КонецПроцедуры

#КонецОбласти
