#Область СведенияОВнешнейОбработке

Функция СведенияОВнешнейОбработке() Экспорт 
	
	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("1.1.1.1");
	ПараметрыРегистрации.Наименование = "SQL_STORAGE_TOOLS";
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = НСтр("ru = 'SHOW_FORM'");
	НоваяКоманда.Идентификатор = "SQL_STORAGE_TOOLS_SHOW_FORM";
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Истина;
	
	Возврат ПараметрыРегистрации; 
	
Конецфункции 

Процедура ВыполнитьКоманду(ИмяКоманды, ПараметрыВыполнения = Неопределено) Экспорт
	
	Если ИмяКоманды = "COMMAND1" Тогда
		// COMMAND1();
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВыполнения = Неопределено Тогда
		Выполнить(ИмяКоманды + "()");
	Иначе
		// список особых команд
		Выполнить(ИмяКоманды + "(ПараметрыВыполнения)");

	КонецЕсли;

КонецПроцедуры

#КонецОбласти



#Область УчетныеДанные

// Возвращает описание учетных данных обработки, хранимых в безопасном хранилище.
//
// Возвращаемое значение:
//   Структура - описание учетных данных:
//     * id          - Строка - владелец данных в регистре БезопасноеХранилищеДанных.
//     * credentials - Структура - параметры подключения к базе SQL со значениями по умолчанию:
//                       provider - имя драйвера, см. ДрайверыSQL; по умолчанию массив имен всех драйверов;
//                       server   - имя сервера SQL, по умолчанию сервер 1С из строки соединения информационной базы
//                                  (Srvr) без порта;
//                       database - имя базы, по умолчанию имя информационной базы на сервере 1С (Ref);
//                       username, password - пользователь и пароль SQL.
//                       Пустое сохраненное значение заменяется значением по умолчанию.
//                       Значение по умолчанию - Массив: поле вводится выбором из его элементов,
//                       без сохраненного значения используется первый элемент.
//     * secretkeys  - Строка - имена секретных полей credentials через запятую:
//                       их значения не передаются в форму и вводятся в режиме пароля.
//
Функция ОписаниеУчетныхДанных() Экспорт

	ПараметрыСоединения = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	ИмяСервера = "";
	Если ПараметрыСоединения.Свойство("Srvr") Тогда
		ИмяСервера = СтрРазделить(ПараметрыСоединения.Srvr, ":")[0];
	КонецЕсли;
	ИмяБазы = "";
	Если ПараметрыСоединения.Свойство("Ref") Тогда
		ИмяБазы = ПараметрыСоединения.Ref;
	КонецЕсли;

	ИменаДрайверов = Новый Массив;
	Для Каждого Драйвер Из ДрайверыSQL() Цикл
		ИменаДрайверов.Добавить(Драйвер.Имя);
	КонецЦикла;

	УчетныеДанные = Новый Структура("provider, server, database, username, password",
		ИменаДрайверов,
		ИмяСервера,
		ИмяБазы,
		"",
		""
	);

	Возврат Новый Структура("id, credentials, secretkeys",
		ИдентификаторУчетныхДанных(),
		УчетныеДанные,
		"password"
	);

КонецФункции

// Возвращает описание учетных данных, заполненное значениями из безопасного хранилища.
//
// Параметры:
//   СкрыватьСекреты - Булево - если Истина, значения секретных полей не возвращаются.
//
// Возвращаемое значение:
//   Структура - см. ОписаниеУчетныхДанных, дополнительно:
//     * saved - Структура - ключ - имя секретного поля, значение - Булево, сохранено ли значение.
//
Функция ПрочитатьУчетныеДанные(СкрыватьСекреты = Ложь) Экспорт

	Описание = ОписаниеУчетныхДанных();
	СекретныеКлючи = Новый Структура(Описание.secretkeys);

	Ключи = Новый Массив;
	Для Каждого Поле Из Описание.credentials Цикл
		Ключи.Добавить(Поле.Ключ);
	КонецЦикла;

	СохраненныеДанные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Описание.id, СтрСоединить(Ключи, ","));

	Сохраненные = Новый Структура;
	Для Каждого Ключ Из Ключи Цикл
		Значение = СохраненныеДанные[Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Описание.credentials[Ключ] = Значение;
		ИначеЕсли ТипЗнч(Описание.credentials[Ключ]) = Тип("Массив") Тогда
			Варианты = Описание.credentials[Ключ];
			Описание.credentials[Ключ] = ?(Варианты.Количество() > 0, Варианты[0], "");
		КонецЕсли;
		Если СекретныеКлючи.Свойство(Ключ) Тогда
			Сохраненные.Вставить(Ключ, ЗначениеЗаполнено(Значение));
			Если СкрыватьСекреты Тогда
				Описание.credentials[Ключ] = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Описание.Вставить("saved", Сохраненные);

	Возврат Описание;

КонецФункции

// Записывает учетные данные в безопасное хранилище.
// Пустые значения секретных полей не перезаписывают сохраненные.
//
// Параметры:
//   Данные - Структура - значения полей, см. ОписаниеУчетныхДанных.credentials.
//
Процедура ЗаписатьУчетныеДанные(Данные) Экспорт

	Описание = ОписаниеУчетныхДанных();
	СекретныеКлючи = Новый Структура(Описание.secretkeys);

	НачатьТранзакцию();
	Попытка
		Для Каждого Поле Из Описание.credentials Цикл
			Значение = Неопределено;
			Если Не Данные.Свойство(Поле.Ключ, Значение) Тогда
				Продолжить;
			КонецЕсли;
			// Секретные значения (пароль) сохраняются как введены: пробелы по краям могут быть их частью.
			Если СекретныеКлючи.Свойство(Поле.Ключ) Тогда
				Если ПустаяСтрока(Значение) Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				Значение = СокрЛП(Значение);
			КонецЕсли;
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Описание.id, Значение, Поле.Ключ);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(ПолучитьИмяСобытия("УчетныеДанные"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ИдентификаторУчетныхДанных()

	Возврат "SQL_STORAGE_TOOLS";

КонецФункции

#КонецОбласти




#Region Журналирование

Функция	ПолучитьИмяСобытия(ИмяКоманды = Неопределено) Экспорт

	Сегмент = Новый Массив();
	Сегмент.Добавить(СведенияОВнешнейОбработке().Наименование);
	Если ЗначениеЗаполнено(ИмяКоманды) Тогда
		Сегмент.Добавить(ИмяКоманды);
	КонецЕсли;
	
	Возврат СтрСоединить(Сегмент, ".");

КонецФункции

Процедура ЗанестиВЖурналСобытий(Событие, Идентификатор, Успех, Комментарий)
	Перем МетаданныеДляЖурнала;
	
	Уровень = ?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	Попытка 
		МетаданныеДляЖурнала = Идентификатор.Метаданные();
	Исключение	
	КонецПопытки;

	ЗаписьЖурналаРегистрации(Событие, Уровень, МетаданныеДляЖурнала, Идентификатор, Комментарий);
	
	Если Не Успех И ИнтерактивныйРежим И ОстановитьПриОшибке Тогда
		ВызватьИсключение Комментарий;
	КонецЕсли;
	
КонецПроцедуры	

#EndRegion

#Region Визуализация

Процедура ПрименитьВизуализацию(Действие, ДопПараметры = Неопределено) Экспорт
	Перем НаборТаблиц, Сообщение;
	
	ДатаСеансаТекущая = ТекущаяДатаСеанса();
	ПараметрыОтчета = Новый Структура("ТекДата", ДатаСеансаТекущая);
	
	ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);
	
	Если ТребуетсяПодтянутьВнешниеДанные(Действие, ПараметрыОтчета, НаборТаблиц, Сообщение) Тогда
		Если НаборТаблиц = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВывестиДанныеЧерезСКД(Действие,, ПараметрыОтчета, НаборТаблиц,, Визуализация, ВыходныеДанные);
	
	ВыходныеДанные.Свойство("ДанныеРасшифровки", ДанныеРасшифровки);
		
КонецПроцедуры

Функция ТребуетсяПодтянутьВнешниеДанные(Действие, ПараметрыОтчета, НаборТаблиц, Сообщение)
	
	Если Действие = "STORAGE_STRUCTURE" Тогда
		Если ОбъектыМетаданных.Количество() = 0 Тогда
			Сообщение = НСтр("ru = 'Не выбраны объекты метаданных'; en = 'Metadata objects are not selected'");
			Возврат Истина;
		КонецЕсли;

		Таблица = Неопределено;
		Если ПолучитьСтруктуруХранения(ОбъектыМетаданных.ВыгрузитьКолонку("ПолноеИмя"), ВключатьДвижения, Таблица, Сообщение) Тогда
			НаборТаблиц = Новый Структура("STORAGE_STRUCTURE", Таблица);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;
КонецФункции

#EndRegion

#Область СтруктураХранения

// Возвращает поля таблиц хранения объектов метаданных в именах СУБД.
//
// Параметры:
//   ПолныеИмена      - Массив - полные имена объектов метаданных, например "Документ.ЧекККМ".
//   ВключатьДвижения - Булево - для документов добавить таблицы регистров, по которым документ делает движения.
//   Таблица          - ТаблицаЗначений - выходной: строка на каждое поле таблицы хранения, колонки
//                      ОбъектМетаданных, Связь, ИмяТаблицы, ИмяТаблицыХранения, Назначение,
//                      ИмяПоля, ИмяПоляХранения, ПутьПоляХранения (ИмяТаблицыХранения.ИмяПоляХранения), ТипПоля.
//   Сообщение        - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если структура получена.
//
Функция ПолучитьСтруктуруХранения(ПолныеИмена, ВключатьДвижения, Таблица, Сообщение) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("ОбъектМетаданных,Связь,ИмяТаблицы,ИмяТаблицыХранения,Назначение,ИмяПоля,ИмяПоляХранения,ПутьПоляХранения,ТипПоля", ",") Цикл
		Таблица.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Строка"));
	КонецЦикла;

	Попытка
		Для Каждого ПолноеИмя Из ПолныеИмена Цикл

			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
			Если МетаданныеОбъекта = Неопределено Тогда
				Сообщение = СтрШаблон(НСтр("ru = 'Объект метаданных %1 не найден'; en = 'Metadata object %1 is not found'"), ПолноеИмя);
				Возврат Ложь;
			КонецЕсли;

			ДобавитьПоляТаблицХранения(Таблица, ПолноеИмя, "Объект", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПолноеИмя));

			Если ВключатьДвижения И Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
				Регистры = Новый Массив;
				Для Каждого Регистр Из МетаданныеОбъекта.Движения Цикл
					Регистры.Добавить(Регистр.ПолноеИмя());
				КонецЦикла;
				ДобавитьПоляТаблицХранения(Таблица, ПолноеИмя, "Движения", Регистры);
			КонецЕсли;

		КонецЦикла;
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Процедура ДобавитьПоляТаблицХранения(Таблица, ПолноеИмя, Связь, ИменаМетаданных)

	Если ИменаМетаданных.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТипыПолей = Новый Соответствие;
	Для Каждого ТаблицаХранения Из ПолучитьСтруктуруХраненияБазыДанных(ИменаМетаданных, Истина) Цикл
		Для Каждого Поле Из ТаблицаХранения.Поля Цикл

			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.ОбъектМетаданных = ПолноеИмя;
			НоваяСтрока.Связь = Связь;
			НоваяСтрока.ИмяТаблицы = ТаблицаХранения.ИмяТаблицы;
			НоваяСтрока.ИмяТаблицыХранения = ТаблицаХранения.ИмяТаблицыХранения;
			НоваяСтрока.Назначение = ТаблицаХранения.Назначение;
			НоваяСтрока.ИмяПоля = Поле.ИмяПоля;
			НоваяСтрока.ИмяПоляХранения = Поле.ИмяПоляХранения;
			НоваяСтрока.ПутьПоляХранения = ТаблицаХранения.ИмяТаблицыХранения + "." + Поле.ИмяПоляХранения;
			НоваяСтрока.ТипПоля = ТипПоляПоМетаданным(Поле.Метаданные, ТипыПолей);
			Если ПустаяСтрока(НоваяСтрока.ТипПоля)
				И ЗначениеЗаполнено(Поле.ИмяПоля)
				И (ТаблицаХранения.Назначение = "Основная" Или ТаблицаХранения.Назначение = "ТабличнаяЧасть") Тогда
				НоваяСтрока.ТипПоля = Строка(ТипЗначенияПоля(ТаблицаХранения.Метаданные, Поле.ИмяПоля));
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Возвращает представление типа поля по полному имени его метаданных.
//
// Параметры:
//   ПолноеИмяПоля - Строка - полное имя метаданных поля из ПолучитьСтруктуруХраненияБазыДанных,
//                   например "Документ.ЧекККМ.Реквизит.Магазин" или "ОбщийРеквизит.ОбластьДанныхОсновныеДанные";
//                   у стандартных и служебных полей пустая строка.
//   ТипыПолей     - Соответствие - кэш: ключ - полное имя, значение - представление типа.
//                   Составной реквизит хранится в нескольких полях (_TYPE, _RTRef, _RRRef, _S) с одним именем.
//
// Возвращаемое значение:
//   Строка - представление типа или пустая строка, если тип не определен.
//
Функция ТипПоляПоМетаданным(ПолноеИмяПоля, ТипыПолей)

	Если ПустаяСтрока(ПолноеИмяПоля) Тогда
		Возврат "";
	КонецЕсли;

	ТипПоля = ТипыПолей[ПолноеИмяПоля];
	Если ТипПоля <> Неопределено Тогда
		Возврат ТипПоля;
	КонецЕсли;

	ТипПоля = "";
	ЧастиИмени = СтрРазделить(ПолноеИмяПоля, ".");
	ВидПоля = ЧастиИмени[ЧастиИмени.ВГраница() - 1];
	Если СтрРазделить("Реквизит,Измерение,Ресурс,РеквизитАдресации,ОбщийРеквизит", ",").Найти(ВидПоля) <> Неопределено Тогда
		МетаданныеПоля = Метаданные.НайтиПоПолномуИмени(ПолноеИмяПоля);
		Если МетаданныеПоля <> Неопределено Тогда
			ТипПоля = Строка(МетаданныеПоля.Тип);
		КонецЕсли;
	КонецЕсли;

	ТипыПолей.Вставить(ПолноеИмяПоля, ТипПоля);

	Возврат ТипПоля;

КонецФункции

// Возвращает тип поля основной таблицы объекта или его табличной части: реквизита, измерения, ресурса,
// стандартного или общего реквизита.
//
// Параметры:
//   МетаданныеОбъекта - Строка, ОбъектМетаданных - объект, табличная часть или полное имя, например
//                       "Документ.ЧекККМ" или имя таблицы табличной части "Документ.ЧекККМ.Товары".
//   ИмяПоля           - Строка - имя поля в 1С, например "Дата" или "Магазин".
//
// Возвращаемое значение:
//   ОписаниеТипов - тип поля; пустое описание, если поле не найдено.
//
Функция ТипЗначенияПоля(МетаданныеОбъекта, ИмяПоля) Экспорт

	ОбъектМетаданных = МетаданныеОбъекта;
	Если ТипЗнч(МетаданныеОбъекта) = Тип("Строка") Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(МетаданныеОбъекта);
		ЧастиИмени = СтрРазделить(МетаданныеОбъекта, ".");
		Если ОбъектМетаданных = Неопределено И ЧастиИмени.Количество() = 3 Тогда
			ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(СтрШаблон("%1.%2.ТабличнаяЧасть.%3",
				ЧастиИмени[0],
				ЧастиИмени[1],
				ЧастиИмени[2]));
		КонецЕсли;
	КонецЕсли;
	Если ОбъектМетаданных = Неопределено Или ПустаяСтрока(ИмяПоля) Тогда
		Возврат Новый ОписаниеТипов;
	КонецЕсли;

	ВидОбъекта = СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".")[0];
	Если СтрНачинаетсяС(ВидОбъекта, "Регистр") Тогда
		Коллекции = "Измерения,Ресурсы,Реквизиты";
	ИначеЕсли ВидОбъекта = "Задача" Тогда
		Коллекции = "Реквизиты,РеквизитыАдресации";
	ИначеЕсли СтрРазделить("Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,БизнесПроцесс", ",").Найти(ВидОбъекта) <> Неопределено Тогда
		Коллекции = "Реквизиты";
	Иначе
		Возврат Новый ОписаниеТипов;
	КонецЕсли;

	Для Каждого ИмяКоллекции Из СтрРазделить(Коллекции, ",") Цикл
		Реквизит = ОбъектМетаданных[ИмяКоллекции].Найти(ИмяПоля);
		Если Реквизит <> Неопределено Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = ИмяПоля Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;

	ОбщийРеквизит = Метаданные.ОбщиеРеквизиты.Найти(ИмяПоля);
	Если ОбщийРеквизит <> Неопределено Тогда
		Возврат ОбщийРеквизит.Тип;
	КонецЕсли;

	Возврат Новый ОписаниеТипов;

КонецФункции

// Возвращает полное имя главного объекта: по основной таблице которого строится SQL-запрос.
// Это объект с флажком Главный, иначе первый в ОбъектыМетаданных, иначе объект первой строки ОсновнойОтборЗапроса.
//
// Возвращаемое значение:
//   Строка - полное имя объекта метаданных или пустая строка.
//
Функция ГлавныйОбъект() Экспорт

	Для Каждого СтрокаОбъекта Из ОбъектыМетаданных Цикл
		Если СтрокаОбъекта.Главный Тогда
			Возврат СтрокаОбъекта.ПолноеИмя;
		КонецЕсли;
	КонецЦикла;

	Если ОбъектыМетаданных.Количество() > 0 Тогда
		Возврат ОбъектыМетаданных[0].ПолноеИмя;
	ИначеЕсли ОсновнойОтборЗапроса.Количество() > 0 Тогда
		Возврат ОсновнойОтборЗапроса[0].ОбъектМетаданных;
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает имя основной таблицы хранения объекта.
//
// Параметры:
//   ПолноеИмя          - Строка - полное имя объекта метаданных.
//   ИмяТаблицыХранения - Строка - выходной: имя основной таблицы хранения.
//   Сообщение          - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если таблица найдена.
//
Функция ОсновнаяТаблицаОбъекта(ПолноеИмя, ИмяТаблицыХранения, Сообщение) Экспорт

	Структура = Неопределено;
	Если Не ПолучитьСтруктуруХранения(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПолноеИмя), Ложь, Структура, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПоляОсновнойТаблицы = Структура.НайтиСтроки(Новый Структура("Связь, Назначение", "Объект", "Основная"));
	Если ПоляОсновнойТаблицы.Количество() = 0 Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'Не найдена основная таблица %1'; en = 'Main table of %1 is not found'"), ПолноеИмя);
		Возврат Ложь;
	КонецЕсли;

	ИмяТаблицыХранения = ПоляОсновнойТаблицы[0].ИмяТаблицыХранения;

	Возврат Истина;

КонецФункции

// Возвращает данные для списков выбора таблиц и полей на форме по структуре хранения выбранных объектов
// (с учетом ВключатьДвижения).
//
// Параметры:
//   Данные    - Структура - выходной:
//     * ГлавныйОбъект   - Строка - см. ГлавныйОбъект.
//     * ОсновныеТаблицы - Соответствие - ключ - полное имя объекта, значение - имя его основной таблицы хранения.
//     * Таблицы         - СписокЗначений - таблицы хранения для соединения: все, кроме основной таблицы
//                         главного объекта; значение - имя таблицы хранения, представление - имя таблицы 1С.
//     * ИменаТаблиц     - Соответствие - ключ - имя таблицы хранения, значение - имя таблицы 1С.
//     * Поля            - Соответствие - ключ - имя таблицы хранения, значение - СписокЗначений полей:
//                         значение - имя поля хранения, представление - "ИмяПоля (ИмяПоляХранения)".
//     * ИменаПолей      - Соответствие - ключ - ПутьПоляХранения, значение - имя поля 1С.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если данные получены.
//
Функция ДанныеВыбора(Данные, Сообщение) Экспорт

	Главный = ГлавныйОбъект();
	ПолныеИмена = ОбъектыМетаданных.ВыгрузитьКолонку("ПолноеИмя");
	Если Не ПустаяСтрока(Главный) И ПолныеИмена.Найти(Главный) = Неопределено Тогда
		ПолныеИмена.Добавить(Главный);
	КонецЕсли;

	Структура = Неопределено;
	Если Не ПолучитьСтруктуруХранения(ПолныеИмена, ВключатьДвижения, Структура, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ОсновныеТаблицы = Новый Соответствие;
	ИменаТаблиц = Новый Соответствие;
	Поля = Новый Соответствие;
	ИменаПолей = Новый Соответствие;
	ВсеТаблицы = Новый СписокЗначений;
	Для Каждого Поле Из Структура Цикл

		Если Поле.Связь = "Объект" И Поле.Назначение = "Основная" И ОсновныеТаблицы[Поле.ОбъектМетаданных] = Неопределено Тогда
			ОсновныеТаблицы.Вставить(Поле.ОбъектМетаданных, Поле.ИмяТаблицыХранения);
		КонецЕсли;

		Если ИменаТаблиц[Поле.ИмяТаблицыХранения] = Неопределено Тогда
			ИменаТаблиц.Вставить(Поле.ИмяТаблицыХранения, Поле.ИмяТаблицы);
			Поля.Вставить(Поле.ИмяТаблицыХранения, Новый СписокЗначений);
			ВсеТаблицы.Добавить(Поле.ИмяТаблицыХранения, Поле.ИмяТаблицы);
		КонецЕсли;

		Если ИменаПолей[Поле.ПутьПоляХранения] = Неопределено Тогда
			ИменаПолей.Вставить(Поле.ПутьПоляХранения, Поле.ИмяПоля);
			Поля[Поле.ИмяТаблицыХранения].Добавить(Поле.ИмяПоляХранения, ПредставлениеПоля(Поле.ИмяПоля, Поле.ИмяПоляХранения));
		КонецЕсли;

	КонецЦикла;

	ГлавнаяТаблица = ОсновныеТаблицы[Главный];
	Таблицы = Новый СписокЗначений;
	Для Каждого ЭлементТаблицы Из ВсеТаблицы Цикл
		Если ЭлементТаблицы.Значение <> ГлавнаяТаблица Тогда
			Таблицы.Добавить(ЭлементТаблицы.Значение, ЭлементТаблицы.Представление);
		КонецЕсли;
	КонецЦикла;

	Данные = Новый Структура("ГлавныйОбъект, ОсновныеТаблицы, Таблицы, ИменаТаблиц, Поля, ИменаПолей",
		Главный,
		ОсновныеТаблицы,
		Таблицы,
		ИменаТаблиц,
		Поля,
		ИменаПолей);

	Возврат Истина;

КонецФункции

Функция ПредставлениеПоля(ИмяПоля, ИмяПоляХранения)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат ИмяПоляХранения;
	КонецЕсли;

	Возврат СтрШаблон("%1 (%2)", ИмяПоля, ИмяПоляХранения);

КонецФункции

// Подбирает по типам поле основной таблицы главного объекта для соединения с полем присоединяемой таблицы:
// ссылку главного объекта, если поле на него ссылается, иначе единственное ссылочное поле главной таблицы
// того же типа, что и поле.
//
// Параметры:
//   ИмяТаблицы         - Строка - имя присоединяемой таблицы 1С, например "РегистрСведений.Product".
//   ИмяПоля            - Строка - имя поля 1С присоединяемой таблицы.
//   ПолеХранения       - Строка - имя поля хранения присоединяемой таблицы.
//   ПолеГлавнойТаблицы - Строка - выходной: имя поля хранения главной таблицы; пустая строка, если не подобрано.
//   Сообщение          - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если подбор выполнен, в том числе без результата.
//
Функция ПолеГлавнойТаблицыСоединения(ИмяТаблицы, ИмяПоля, ПолеХранения, ПолеГлавнойТаблицы, Сообщение) Экспорт

	ПолеГлавнойТаблицы = "";
	Если Не СтрЗаканчиваетсяНа(ПолеХранения, "RRef") Тогда
		Возврат Истина;
	КонецЕсли;

	ТипПоля = ТипЗначенияПоля(ИмяТаблицы, ИмяПоля);
	Если ТипПоля.Типы().Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Главный = ГлавныйОбъект();
	Структура = Неопределено;
	Если Не ПолучитьСтруктуруХранения(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Главный), Ложь, Структура, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПоляГлавнойТаблицы = Структура.НайтиСтроки(Новый Структура("Связь, Назначение", "Объект", "Основная"));
	Если ПоляГлавнойТаблицы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	ГлавнаяТаблица = ПоляГлавнойТаблицы[0].ИмяТаблицыХранения;

	ТипСсылки = ТипЗначенияПоля(Главный, "Ссылка");
	Если ТипСсылки.Типы().Количество() = 1 И ТипПоля.СодержитТип(ТипСсылки.Типы()[0]) Тогда
		Если Не ПолеСвязи(Структура, ГлавнаяТаблица, "Ссылка", ПолеГлавнойТаблицы, Сообщение) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;

	Если ТипПоля.Типы().Количество() <> 1 Или Не ОбщегоНазначения.ЭтоСсылка(ТипПоля.Типы()[0]) Тогда
		Возврат Истина;
	КонецЕсли;

	Найденные = Новый Массив;
	Для Каждого Поле Из ПоляГлавнойТаблицы Цикл
		Если ПустаяСтрока(Поле.ИмяПоля)
			Или Поле.ИмяПоля = "Ссылка"
			Или Не СтрЗаканчиваетсяНа(Поле.ИмяПоляХранения, "RRef")
			Или Найденные.Найти(Поле.ИмяПоляХранения) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗначенияПоля(Главный, Поле.ИмяПоля).СодержитТип(ТипПоля.Типы()[0]) Тогда
			Найденные.Добавить(Поле.ИмяПоляХранения);
		КонецЕсли;
	КонецЦикла;

	Если Найденные.Количество() = 1 Тогда
		ПолеГлавнойТаблицы = Найденные[0];
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СценарииУдаления

// Формирует T-SQL скрипт по виду запроса ВидЗапроса (DELETE или SELECT) для главного объекта (см. ГлавныйОбъект),
// а для QUERY1C - запрос на языке 1С по тем же настройкам (см. ЗапросВыборки1С):
// основная таблица M с отбором ОсновнойОтборЗапроса в WHERE и присоединенными таблицами Соединения
// с отбором ОтборСоединений в ON. Удаления без отбора основной таблицы или внутреннего соединения скрипт не содержит.
//
// Параметры:
//   Скрипт    - Строка - выходной: текст скрипта.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если скрипт сформирован.
//
Функция СформироватьСкрипт(Скрипт, Сообщение) Экспорт

	Скрипт = "";

	Если ВидЗапроса = "SELECT" Тогда
		Возврат СформироватьВыборку(Скрипт, Сообщение);
	ИначеЕсли ВидЗапроса = "DELETE" Тогда
		Возврат СформироватьУдаление(Скрипт, Сообщение);
	ИначеЕсли ВидЗапроса = "QUERY1C" Тогда
		Возврат СформироватьЗапрос1С(Скрипт, Сообщение);
	КонецЕсли;

	Сообщение = НСтр("ru = 'Не выбран вид запроса'; en = 'Query kind is not selected'");
	Возврат Ложь;

КонецФункции

// Собирает общие части запроса по главному объекту.
//
// Параметры:
//   ДляУдаления - Булево - для документа в структуру добавляются таблицы движений.
//   Описание    - Структура - выходной: ПолноеИмя, ВидОбъекта, Структура (см. ПолучитьСтруктуруХранения),
//                 ПоляОсновнойТаблицы, ОсновнаяТаблица, Источник (FROM с соединениями),
//                 Псевдонимы (см. ИсточникЗапроса), Где (пустая строка
//                 или перевод строки и WHERE), ЕстьОтбор (есть отбор основной таблицы или внутреннее соединение).
//   Сообщение   - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если описание собрано.
//
Функция ОписаниеЗапроса(ДляУдаления, Описание, Сообщение)

	ПолноеИмя = ГлавныйОбъект();
	Если ПустаяСтрока(ПолноеИмя) Тогда
		Сообщение = НСтр("ru = 'Не выбран главный объект'; en = 'Main object is not selected'");
		Возврат Ложь;
	КонецЕсли;
	ВидОбъекта = СтрРазделить(ПолноеИмя, ".")[0];

	Отборы = ОсновнойОтборЗапроса.Выгрузить(Новый Структура("Использование", Истина));

	Структура = Неопределено;
	Если Не ПолучитьСтруктуруХранения(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПолноеИмя), ДляУдаления И ВидОбъекта = "Документ", Структура, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПоляОсновнойТаблицы = Структура.НайтиСтроки(Новый Структура("Связь, Назначение", "Объект", "Основная"));
	Если ПоляОсновнойТаблицы.Количество() = 0 Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'Не найдена основная таблица %1'; en = 'Main table of %1 is not found'"), ПолноеИмя);
		Возврат Ложь;
	КонецЕсли;
	ОсновнаяТаблица = ПоляОсновнойТаблицы[0].ИмяТаблицыХранения;

	Источник = "";
	Псевдонимы = Неопределено;
	Если Не ИсточникЗапроса(ОсновнаяТаблица, Источник, Псевдонимы, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Где = "";
	Если Не СобратьWHERE(Отборы, Псевдонимы, Где, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВнутренниеСоединения = Соединения.НайтиСтроки(Новый Структура("Использование, ВидСоединения", Истина, "INNER"));

	Описание = Новый Структура("ПолноеИмя, ВидОбъекта, Структура, ПоляОсновнойТаблицы, ОсновнаяТаблица, Источник, Псевдонимы, Где, ЕстьОтбор",
		ПолноеИмя,
		ВидОбъекта,
		Структура,
		ПоляОсновнойТаблицы,
		ОсновнаяТаблица,
		Источник,
		Псевдонимы,
		Где,
		Отборы.Количество() > 0 Или ВнутренниеСоединения.Количество() > 0);

	Возврат Истина;

КонецФункции

// Формирует скрипт удаления главного объекта. Сценарий выбирается по виду объекта:
// справочник и документ - через @Ids с табличными частями (у документа и движениями),
// регистр сведений - только независимый, DELETE по условию.
Функция СформироватьУдаление(Скрипт, Сообщение)

	Описание = Неопределено;
	Если Не ОписаниеЗапроса(Истина, Описание, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПолноеИмя = Описание.ПолноеИмя;
	ВидОбъекта = Описание.ВидОбъекта;
	Структура = Описание.Структура;
	ОсновнаяТаблица = Описание.ОсновнаяТаблица;

	Если ВидОбъекта <> "Справочник" И ВидОбъекта <> "Документ" И ВидОбъекта <> "РегистрСведений" Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'Удаление объектов вида %1 (%2) не поддерживается'; en = 'Deletion of %1 objects (%2) is not supported'"),
			ВидОбъекта,
			ПолноеИмя);
		Возврат Ложь;
	КонецЕсли;

	Если Не Описание.ЕстьОтбор Тогда
		Сообщение = НСтр("ru = 'Для удаления нужен отбор главной таблицы или внутреннее соединение'; en = 'Deletion requires a main table filter or an inner join'");
		Возврат Ложь;
	КонецЕсли;

	ЧастиСкрипта = Новый Массив;
	ЧастиСкрипта.Добавить("SET XACT_ABORT ON;");
	ЧастиСкрипта.Добавить(ОбъявлениеСмещенияЛет());
	ЧастиСкрипта.Добавить("DECLARE @Ids TABLE (IDRRef binary(16) PRIMARY KEY);");
	ЧастиСкрипта.Добавить("BEGIN TRAN;");
	ЧастиСкрипта.Добавить("");
	ЧастиСкрипта.Добавить("-- " + ПолноеИмя);

	Если ВидОбъекта = "РегистрСведений" Тогда
		Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя).РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Регистр %1 подчинен регистратору, удаляйте его записи вместе с документами'; en = 'Register %1 is subordinate to recorder'"), ПолноеИмя);
			Возврат Ложь;
		КонецЕсли;
		ЧастиСкрипта.Добавить("DELETE M" + Символы.ПС + "FROM " + Описание.Источник + Описание.Где + ";");
	Иначе
		ПолеСсылки = "";
		Если Не ПолеСвязи(Структура, ОсновнаяТаблица, "Ссылка", ПолеСсылки, Сообщение) Тогда
			Возврат Ложь;
		КонецЕсли;

		ЧастиСкрипта.Добавить(СтрШаблон("INSERT INTO @Ids (IDRRef)
			|SELECT DISTINCT M.%1
			|FROM %2%3;", ПолеСсылки, Описание.Источник, Описание.Где));

		Для Каждого ТабличнаяЧасть Из ТаблицыСтруктуры(Структура, "Объект", "ТабличнаяЧасть") Цикл
			ПолеВладельца = "";
			Если Не ПолеСвязи(Структура, ТабличнаяЧасть.ИмяТаблицыХранения, "Ссылка", ПолеВладельца, Сообщение) Тогда
				Возврат Ложь;
			КонецЕсли;
			ЧастиСкрипта.Добавить("-- " + ТабличнаяЧасть.ИмяТаблицы);
			ЧастиСкрипта.Добавить(СтрШаблон("DELETE FROM dbo.%1 WHERE %2 IN (SELECT IDRRef FROM @Ids);", ТабличнаяЧасть.ИмяТаблицыХранения, ПолеВладельца));
		КонецЦикла;

		Регистры = ТаблицыСтруктуры(Структура, "Движения", "Основная");
		Если Регистры.Количество() > 0 Тогда
			ЧастиСкрипта.Добавить("-- Движения. Итоги регистров не пересчитываются.");
		КонецЕсли;
		Для Каждого Регистр Из Регистры Цикл
			ПолеРегистратора = "";
			Если Не ПолеСвязи(Структура, Регистр.ИмяТаблицыХранения, "Регистратор", ПолеРегистратора, Сообщение) Тогда
				Возврат Ложь;
			КонецЕсли;
			ЧастиСкрипта.Добавить("-- " + Регистр.ИмяТаблицы);
			ЧастиСкрипта.Добавить(СтрШаблон("DELETE FROM dbo.%1 WHERE %2 IN (SELECT IDRRef FROM @Ids);", Регистр.ИмяТаблицыХранения, ПолеРегистратора));
		КонецЦикла;

		ЧастиСкрипта.Добавить(СтрШаблон("DELETE FROM dbo.%1 WHERE %2 IN (SELECT IDRRef FROM @Ids);", ОсновнаяТаблица, ПолеСсылки));
	КонецЕсли;

	ЧастиСкрипта.Добавить("");
	ЧастиСкрипта.Добавить("COMMIT TRAN;");

	Скрипт = СтрСоединить(ЧастиСкрипта, Символы.ПС);

	Возврат Истина;

КонецФункции

// Формирует скрипт выборки: количество записей под отбором и первые ЛимитВыборки записей
// со всеми полями основной таблицы главного объекта. Вид объекта не ограничен.
Функция СформироватьВыборку(Скрипт, Сообщение)

	Запросы = Неопределено;
	Если Не ЗапросыВыборки(Запросы, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЧастиСкрипта = Новый Массив;
	ЧастиСкрипта.Добавить(ОбъявлениеСмещенияЛет());
	Для Каждого Запрос Из Запросы Цикл
		ЧастиСкрипта.Добавить("");
		ЧастиСкрипта.Добавить("-- " + Запрос.ПолноеИмя);
		ЧастиСкрипта.Добавить(Запрос.Количество + ";");
		ЧастиСкрипта.Добавить(Запрос.Выборка + ";");
	КонецЦикла;

	Скрипт = СтрСоединить(ЧастиСкрипта, Символы.ПС);

	Возврат Истина;

КонецФункции

// Ограничение числа записей выборки (TOP).
Функция ЛимитВыборки()

	Возврат 1000;

КонецФункции

Функция ОбъявлениеСмещенияЛет()

	Возврат "DECLARE @YearOffset int = ISNULL((SELECT TOP 1 Offset FROM dbo._YearOffset), 0);";

КонецФункции

// Возвращает тексты запросов выборки главного объекта без завершающей ";":
// Массив из Структура - ПолноеИмя, Количество (SELECT COUNT(*)), Выборка (SELECT TOP по ВыбранныеПоля или всем полям),
// Колонки (колонки выборки, см. КолонкиВыборки).
// Тексты используют переменную @YearOffset, см. ОбъявлениеСмещенияЛет.
Функция ЗапросыВыборки(Запросы, Сообщение)

	Описание = Неопределено;
	Если Не ОписаниеЗапроса(Ложь, Описание, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Колонки = Неопределено;
	Если Не КолонкиВыборки(Описание, Колонки, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Выборка = СтрШаблон("SELECT TOP (%1)", Формат(ЛимитВыборки(), "ЧГ=0")) + Символы.ПС
		+ Символы.Таб + СтрСоединить(ПоляВыборки(Колонки), "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "FROM " + Описание.Источник
		+ Описание.Где;

	Запросы = Новый Массив;
	Запросы.Добавить(Новый Структура("ПолноеИмя, Количество, Выборка, Колонки",
		Описание.ПолноеИмя,
		"SELECT COUNT(*) AS [Количество]" + Символы.ПС + "FROM " + Описание.Источник + Описание.Где,
		Выборка,
		Колонки));

	Возврат Истина;

КонецФункции

// Возвращает колонки выборки: поля из ВыбранныеПоля в порядке списка без повторов, а если в списке нет полей -
// все поля основной таблицы. Строка с пустой таблицей относится к основной таблице главного объекта.
// Поля присоединенных таблиц (Соединения) выбираются, только если включен ВыбиратьПоляСоединений,
// иначе их строки пропускаются.
//
// Параметры:
//   Описание  - Структура - см. ОписаниеЗапроса.
//   Колонки   - Массив из Структура - выходной:
//     * ИмяТаблицы      - Строка - имя таблицы 1С поля: главный объект или таблица соединения.
//     * Псевдоним       - Строка - псевдоним таблицы в запросе: M, J1, J2...
//     * ИмяПоля         - Строка - имя поля 1С.
//     * ИмяПоляХранения - Строка - имя поля хранения.
//     * Имя             - Строка - имя колонки результата (см. ПсевдонимыПолей), у поля присоединенной таблицы -
//                         с префиксом псевдонима таблицы, например J1_Номенклатура.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если все поля списка найдены.
//
Функция КолонкиВыборки(Описание, Колонки, Сообщение)

	// Поля хранения таблиц выборки, ключ - ПутьПоляХранения. Поля присоединенных таблиц добавляются
	// при первом поле такой таблицы по структуре хранения всех выбранных объектов (как в ДанныеВыбора).
	ПоляХранения = Новый Соответствие;
	Для Каждого Поле Из Описание.ПоляОсновнойТаблицы Цикл
		ПоляХранения.Вставить(Поле.ПутьПоляХранения, Поле);
	КонецЦикла;
	ЕстьПоляСоединений = Ложь;

	Выбранные = Новый Массив;
	Для Каждого СтрокаПоля Из ВыбранныеПоля Цикл

		ИмяТаблицыХранения = ?(ПустаяСтрока(СтрокаПоля.ИмяТаблицыХранения), Описание.ОсновнаяТаблица, СтрокаПоля.ИмяТаблицыХранения);
		ПутьПоля = ИмяТаблицыХранения + "." + СтрокаПоля.ПолеХранения;
		Если ПустаяСтрока(СтрокаПоля.ПолеХранения) Тогда
			Продолжить;
		КонецЕсли;

		Если ИмяТаблицыХранения <> Описание.ОсновнаяТаблица Тогда
			Если Описание.Псевдонимы[ИмяТаблицыХранения] = Неопределено Тогда
				Сообщение = СтрШаблон(НСтр("ru = 'Таблица %1 поля выборки %2 не главная и не присоединена'; en = 'Table %1 of selection field %2 is neither main nor joined'"),
					ИмяТаблицыХранения,
					ПредставлениеПоля(СтрокаПоля.Поле, СтрокаПоля.ПолеХранения));
				Возврат Ложь;
			КонецЕсли;
			Если Не ВыбиратьПоляСоединений Тогда
				Продолжить;
			КонецЕсли;
			Если Не ЕстьПоляСоединений Тогда
				Структура = Неопределено;
				Если Не ПолучитьСтруктуруХранения(ОбъектыМетаданных.ВыгрузитьКолонку("ПолноеИмя"), ВключатьДвижения, Структура, Сообщение) Тогда
					Возврат Ложь;
				КонецЕсли;
				Для Каждого Поле Из Структура Цикл
					Если ПоляХранения[Поле.ПутьПоляХранения] = Неопределено Тогда
						ПоляХранения.Вставить(Поле.ПутьПоляХранения, Поле);
					КонецЕсли;
				КонецЦикла;
				ЕстьПоляСоединений = Истина;
			КонецЕсли;
		КонецЕсли;

		Поле = ПоляХранения[ПутьПоля];
		Если Поле = Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Поле выборки %1 не найдено в таблице %2'; en = 'Selection field %1 is not found in table %2'"),
				ПредставлениеПоля(СтрокаПоля.Поле, СтрокаПоля.ПолеХранения),
				ИмяТаблицыХранения);
			Возврат Ложь;
		КонецЕсли;

		Если Выбранные.Найти(Поле) = Неопределено Тогда
			Выбранные.Добавить(Поле);
		КонецЕсли;

	КонецЦикла;

	Если Выбранные.Количество() = 0 Тогда
		Выбранные = Описание.ПоляОсновнойТаблицы;
	КонецЕсли;

	// Имена колонок считаются по полям каждой таблицы отдельно: суффиксы частей составного поля зависят
	// только от выбранных полей этой таблицы.
	ПоляТаблиц = Новый Соответствие;
	Для Каждого Поле Из Выбранные Цикл
		Если ПоляТаблиц[Поле.ИмяТаблицыХранения] = Неопределено Тогда
			ПоляТаблиц.Вставить(Поле.ИмяТаблицыХранения, Новый Массив);
		КонецЕсли;
		ПоляТаблиц[Поле.ИмяТаблицыХранения].Добавить(Поле);
	КонецЦикла;

	ИменаКолонок = Новый Соответствие;
	Для Каждого ПоляТаблицы Из ПоляТаблиц Цикл
		Префикс = ?(ПоляТаблицы.Ключ = Описание.ОсновнаяТаблица, "", Описание.Псевдонимы[ПоляТаблицы.Ключ] + "_");
		ИменаПолей = ПсевдонимыПолей(ПоляТаблицы.Значение);
		Для Каждого Поле Из ПоляТаблицы.Значение Цикл
			ИменаКолонок.Вставить(Поле.ПутьПоляХранения, Префикс + ИменаПолей[Поле.ИмяПоляХранения]);
		КонецЦикла;
	КонецЦикла;

	Колонки = Новый Массив;
	Для Каждого Поле Из Выбранные Цикл
		ЭтоОсновнаяТаблица = (Поле.ИмяТаблицыХранения = Описание.ОсновнаяТаблица);
		Колонки.Добавить(Новый Структура("ИмяТаблицы, Псевдоним, ИмяПоля, ИмяПоляХранения, Имя",
			?(ЭтоОсновнаяТаблица, Описание.ПолноеИмя, Поле.ИмяТаблицы),
			Описание.Псевдонимы[Поле.ИмяТаблицыХранения],
			Поле.ИмяПоля,
			Поле.ИмяПоляХранения,
			ИменаКолонок[Поле.ПутьПоляХранения]));
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Возвращает поля выборки "Псевдоним.ПолеХранения AS [Имя]" по колонкам выборки, см. КолонкиВыборки.
Функция ПоляВыборки(Колонки)

	Поля = Новый Массив;
	Для Каждого Колонка Из Колонки Цикл
		Поля.Добавить(СтрШаблон("%1.%2 AS [%3]",
			Колонка.Псевдоним,
			Колонка.ИмяПоляХранения,
			СтрЗаменить(Колонка.Имя, "]", "]]")));
	КонецЦикла;

	Возврат Поля;

КонецФункции

// Возвращает псевдонимы полей выборки: Соответствие, ключ - имя поля хранения, значение - имя поля 1С.
// Поля составного реквизита, у которых одно имя 1С, получают суффикс части хранения (_TYPE, _RTRef, _RRRef...);
// поле без имени 1С - имя поля хранения без первого "_".
Функция ПсевдонимыПолей(ПоляТаблицы)

	КоличествоИмен = Новый Соответствие;
	Для Каждого Поле Из ПоляТаблицы Цикл
		КоличествоИмен.Вставить(Поле.ИмяПоля, ?(КоличествоИмен[Поле.ИмяПоля] = Неопределено, 1, КоличествоИмен[Поле.ИмяПоля] + 1));
	КонецЦикла;

	Псевдонимы = Новый Соответствие;
	Для Каждого Поле Из ПоляТаблицы Цикл
		Если ПустаяСтрока(Поле.ИмяПоля) Тогда
			ПсевдонимПоля = Сред(Поле.ИмяПоляХранения, 2);
		ИначеЕсли КоличествоИмен[Поле.ИмяПоля] > 1 Тогда
			ЧастиИмени = СтрРазделить(Поле.ИмяПоляХранения, "_", Ложь);
			ПсевдонимПоля = Поле.ИмяПоля + "_" + ЧастиИмени[ЧастиИмени.ВГраница()];
		Иначе
			ПсевдонимПоля = Поле.ИмяПоля;
		КонецЕсли;
		Псевдонимы.Вставить(Поле.ИмяПоляХранения, ПсевдонимПоля);
	КонецЦикла;

	Возврат Псевдонимы;

КонецФункции

// Собирает FROM: основная таблица с псевдонимом M и используемые строки Соединения с псевдонимами J1, J2...
// Условие ON - равенство полей соединения и условия строк ОтборСоединений этой таблицы.
// Псевдонимы - выходной: Соответствие, ключ - имя таблицы хранения (основной и присоединенных), значение - псевдоним.
Функция ИсточникЗапроса(ОсновнаяТаблица, Источник, Псевдонимы, Сообщение)

	Источник = "dbo." + ОсновнаяТаблица + " AS M";
	Псевдонимы = Новый Соответствие;
	Псевдонимы.Вставить(ОсновнаяТаблица, "M");

	ИспользуемыеСоединения = Соединения.Выгрузить(Новый Структура("Использование", Истина));
	ОтборыСоединений = ОтборСоединений.Выгрузить(Новый Структура("Использование", Истина));
	Для Каждого СтрокаОтбора Из ОтборыСоединений Цикл
		Если ИспользуемыеСоединения.Найти(СтрокаОтбора.ИмяТаблицыХранения, "ИмяТаблицыХранения") = Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Таблица %1 отбора соединений не присоединена'; en = 'Join filter table %1 is not joined'"),
				СтрокаОтбора.ИмяТаблицыХранения);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Если ИспользуемыеСоединения.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Данные = Неопределено;
	Если Не ДанныеВыбора(Данные, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВидыСоединения = СтрРазделить("INNER,LEFT", ",");
	Присоединенные = Новый Соответствие;
	ЧастиИсточника = Новый Массив;
	ЧастиИсточника.Добавить(Источник);
	Для Каждого Соединение Из ИспользуемыеСоединения Цикл

		Таблица = Соединение.ИмяТаблицыХранения;
		Если Таблица = ОсновнаяТаблица Или Присоединенные[Таблица] <> Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Таблица %1 присоединена повторно или совпадает с главной'; en = 'Table %1 is joined twice or is the main table'"), Таблица);
			Возврат Ложь;
		КонецЕсли;
		Если ВидыСоединения.Найти(Соединение.ВидСоединения) = Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Недопустимый вид соединения ""%1"" для таблицы %2'; en = 'Invalid join kind ""%1"" for table %2'"),
				Соединение.ВидСоединения,
				Таблица);
			Возврат Ложь;
		КонецЕсли;
		Если Не ЕстьПолеТаблицы(Данные, ОсновнаяТаблица, Соединение.ПолеГлавнойТаблицы, Сообщение)
			Или Не ЕстьПолеТаблицы(Данные, Таблица, Соединение.ПолеСоединяемойТаблицы, Сообщение) Тогда
			Возврат Ложь;
		КонецЕсли;

		Псевдоним = "J" + Формат(Присоединенные.Количество() + 1, "ЧГ=0");
		Присоединенные.Вставить(Таблица, Псевдоним);
		Псевдонимы.Вставить(Таблица, Псевдоним);

		Условия = Новый Массив;
		Условия.Добавить(СтрШаблон("M.%1 = %2.%3", Соединение.ПолеГлавнойТаблицы, Псевдоним, Соединение.ПолеСоединяемойТаблицы));
		Если Не УсловияОтбора(ОтборыСоединений.НайтиСтроки(Новый Структура("ИмяТаблицыХранения", Таблица)), Псевдоним, Условия, Сообщение) Тогда
			Сообщение = Соединение.ИмяТаблицы + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		ЧастиИсточника.Добавить(СтрШаблон("%1 JOIN dbo.%2 AS %3 ON %4",
			Соединение.ВидСоединения,
			Таблица,
			Псевдоним,
			СтрСоединить(Условия, " AND ")));

	КонецЦикла;

	Источник = СтрСоединить(ЧастиИсточника, Символы.ПС);

	Возврат Истина;

КонецФункции

// Проверяет, что поле хранения заполнено и есть в таблице хранения (см. ДанныеВыбора).
Функция ЕстьПолеТаблицы(Данные, ИмяТаблицыХранения, ИмяПоляХранения, Сообщение)

	Если Данные.ИменаТаблиц[ИмяТаблицыХранения] = Неопределено Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'Таблица %1 не относится к выбранным объектам'; en = 'Table %1 does not belong to the selected objects'"),
			ИмяТаблицыХранения);
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(ИмяПоляХранения) Или Данные.ИменаПолей[ИмяТаблицыХранения + "." + ИмяПоляХранения] = Неопределено Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'В таблице %1 не найдено поле соединения ""%2""'; en = 'Join field ""%2"" is not found in table %1'"),
			Данные.ИменаТаблиц[ИмяТаблицыХранения],
			ИмяПоляХранения);
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Собирает WHERE из строк основного отбора: пустая строка без условий,
// иначе перевод строки и "WHERE Псевдоним.ПолеХранения ВидСравнения литерал AND ...".
// Строка отбора может относиться к основной таблице (M) или к присоединенной таблице (J1, J2...), см. ИсточникЗапроса.
Функция СобратьWHERE(СтрокиОтбора, Псевдонимы, Где, Сообщение)

	Условия = Новый Массив;
	Для Каждого СтрокаОтбора Из СтрокиОтбора Цикл

		Псевдоним = Псевдонимы[СтрокаОтбора.ИмяТаблицыХранения];
		Если Псевдоним = Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Таблица %1 основного отбора не главная и не присоединена: добавьте соединение'; en = 'Main filter table %1 is neither main nor joined: add a join'"),
				?(ПустаяСтрока(СтрокаОтбора.ОбъектМетаданных), СтрокаОтбора.ИмяТаблицыХранения, СтрокаОтбора.ОбъектМетаданных));
			Возврат Ложь;
		КонецЕсли;

		Если Не УсловияОтбора(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаОтбора), Псевдоним, Условия, Сообщение) Тогда
			Сообщение = СтрокаОтбора.ОбъектМетаданных + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Где = "";
	Если Условия.Количество() > 0 Тогда
		Где = Символы.ПС + "WHERE " + СтрСоединить(Условия, " AND ");
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Добавляет в Условия по строке отбора "Псевдоним.ПолеХранения ВидСравнения литерал",
// для IS NULL и IS NOT NULL - без литерала; значение LIKE должно быть строкой.
Функция УсловияОтбора(СтрокиОтбора, Псевдоним, Условия, Сообщение)

	ВидыСравнения = СтрРазделить("=,<>,>,>=,<,<=,LIKE,IS NULL,IS NOT NULL", ",");

	Для Каждого СтрокаОтбора Из СтрокиОтбора Цикл

		Если ПустаяСтрока(СтрокаОтбора.ПолеХранения) Тогда
			Сообщение = НСтр("ru = 'В строке отбора не выбрано поле'; en = 'Filter row field is not selected'");
			Возврат Ложь;
		КонецЕсли;

		Если ВидыСравнения.Найти(СтрокаОтбора.ВидСравнения) = Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Недопустимый вид сравнения ""%1"" для поля %2'; en = 'Invalid comparison ""%1"" for field %2'"),
				СтрокаОтбора.ВидСравнения,
				СтрокаОтбора.ПолеХранения);
			Возврат Ложь;
		КонецЕсли;

		Если СтрокаОтбора.ВидСравнения = "IS NULL" Или СтрокаОтбора.ВидСравнения = "IS NOT NULL" Тогда
			Условия.Добавить(СтрШаблон("%1.%2 %3", Псевдоним, СтрокаОтбора.ПолеХранения, СтрокаОтбора.ВидСравнения));
			Продолжить;
		КонецЕсли;

		Если СтрокаОтбора.ВидСравнения = "LIKE" И ТипЗнч(СтрокаОтбора.Значение) <> Тип("Строка") Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Для LIKE значение поля %1 должно быть строкой'; en = 'LIKE value of field %1 must be a string'"),
				СтрокаОтбора.ПолеХранения);
			Возврат Ложь;
		КонецЕсли;

		Литерал = "";
		Если Не ЛитералSQL(СтрокаОтбора.Значение, Литерал, Сообщение) Тогда
			Сообщение = СтрокаОтбора.ПолеХранения + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		Условия.Добавить(СтрШаблон("%1.%2 %3 %4", Псевдоним, СтрокаОтбора.ПолеХранения, СтрокаОтбора.ВидСравнения, Литерал));

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Переводит значение 1С в литерал T-SQL. Дата сдвигается на смещение лет базы (@YearOffset).
Функция ЛитералSQL(Значение, Литерал, Сообщение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Булево") Тогда
		Литерал = ?(Значение, "0x01", "0x00");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Литерал = Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Литерал = "N'" + СтрЗаменить(Значение, "'", "''") + "'";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Литерал = СтрШаблон("DATEADD(YEAR, @YearOffset, CAST('%1' AS datetime2))",
			Формат(Значение, "ДФ='yyyyMMdd HH:mm:ss'; ДП='00010101 00:00:00'"));
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		Литерал = ИдентификаторСсылкиSQL(Значение);
	Иначе
		Сообщение = НСтр("ru = 'Значение не заполнено или его тип не поддерживается'; en = 'Value is empty or its type is not supported'");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Возвращает значение _IDRRef ссылки: байты GUID в порядке хранения в MS SQL.
Функция ИдентификаторСсылкиSQL(Ссылка)

	Идентификатор = Строка(Ссылка.УникальныйИдентификатор());

	Возврат "0x"
		+ Сред(Идентификатор, 20, 4)
		+ Сред(Идентификатор, 25, 12)
		+ Сред(Идентификатор, 15, 4)
		+ Сред(Идентификатор, 10, 4)
		+ Сред(Идентификатор, 1, 8);

КонецФункции

// Находит имя поля хранения в таблице по имени поля 1С, например "Ссылка" или "Регистратор".
Функция ПолеСвязи(Структура, ИмяТаблицыХранения, ИмяПоля, ПолеХранения, Сообщение)

	Найденные = Структура.НайтиСтроки(Новый Структура("ИмяТаблицыХранения, ИмяПоля", ИмяТаблицыХранения, ИмяПоля));
	Если Найденные.Количество() = 0 Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'В таблице %1 не найдено поле %2'; en = 'Field %2 is not found in table %1'"),
			ИмяТаблицыХранения,
			ИмяПоля);
		Возврат Ложь;
	КонецЕсли;

	ПолеХранения = Найденные[0].ИмяПоляХранения;

	Возврат Истина;

КонецФункции

// Возвращает таблицы хранения структуры с заданными связью и назначением, по одной строке на таблицу.
Функция ТаблицыСтруктуры(Структура, Связь, Назначение)

	Таблицы = Структура.Скопировать(Новый Структура("Связь, Назначение", Связь, Назначение), "ИмяТаблицы, ИмяТаблицыХранения");
	Таблицы.Свернуть("ИмяТаблицы, ИмяТаблицыХранения");

	Возврат Таблицы;

КонецФункции

#КонецОбласти

#Область ВыборкаSQL

// Выполняет выборку главного объекта по отборам и соединениям (см. СформироватьСкрипт) через ADO
// и выводит результат в Визуализация через СКД с заголовком "<объект>: <показано> из <всего>".
// Даты сдвигаются обратно на смещение лет базы, двоичные поля выводятся строкой 0x...
// Значение ссылочного поля - ссылка 1С или навигационная ссылка (по СпособОткрытияСсылки) с представлением 0x...
// (см. ДобавитьСсылкиВыборки), оно попадает в ДанныеРасшифровки.
//
// Параметры:
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если выборка выполнена.
//
Функция ВывестиВыборкуSQL(Сообщение) Экспорт

	Запросы = Неопределено;
	Если Не ЗапросыВыборки(Запросы, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Соединение = Неопределено;
	Если Не ПодключитьсяКSQL(Соединение, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	СмещениеЛет = 0;
	Таблица = Неопределено;
	Если ВыполнитьЗапросSQL(Соединение, "SELECT TOP 1 Offset AS [Offset] FROM dbo._YearOffset", 0, Таблица, Сообщение)
		И Таблица.Количество() > 0 Тогда
		СмещениеЛет = Таблица[0].Offset;
	КонецЕсли;

	Визуализация.Очистить();
	ДанныеРасшифровки = "";

	// Смещение подставляется числом: каждый запрос - одна инструкция, без пакета с DECLARE.
	ЛитералСмещения = Формат(СмещениеЛет, "ЧН=0; ЧГ=0");

	Для Каждого Запрос Из Запросы Цикл

		ТаблицаКоличества = Неопределено;
		Если Не ВыполнитьЗапросSQL(Соединение, СтрЗаменить(Запрос.Количество, "@YearOffset", ЛитералСмещения), 0, ТаблицаКоличества, Сообщение) Тогда
			Сообщение = Запрос.ПолноеИмя + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		Таблица = Неопределено;
		Если Не ВыполнитьЗапросSQL(Соединение, СтрЗаменить(Запрос.Выборка, "@YearOffset", ЛитералСмещения), СмещениеЛет, Таблица, Сообщение) Тогда
			Сообщение = Запрос.ПолноеИмя + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		Представления = Неопределено;
		Если Не ДобавитьСсылкиВыборки(Запрос.Колонки, Таблица, Представления, Сообщение) Тогда
			Сообщение = Запрос.ПолноеИмя + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		Заголовок = СтрШаблон(НСтр("ru = '%1: %2 из %3'; en = '%1: %2 of %3'"),
			Запрос.ПолноеИмя,
			Формат(Таблица.Количество(), "ЧН=0; ЧГ=0"),
			Формат(ТаблицаКоличества[0].Количество, "ЧН=0; ЧГ=0"));

		ТабличныйДокумент = Новый ТабличныйДокумент;
		ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);
		ВывестиДанныеЧерезСКД(СхемаВыборкиSQL(Таблица, Заголовок, Представления), , , Новый Структура("SQL", Таблица), , ТабличныйДокумент, ВыходныеДанные);
		Визуализация.Вывести(ТабличныйДокумент);
		ДанныеРасшифровки = ВыходныеДанные.ДанныеРасшифровки;

	КонецЦикла;

	Попытка
		Соединение.Close();
	Исключение
		// Соединение закроется при уничтожении COM-объекта.
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Открывает ADO-соединение с базой SQL по учетным данным (см. ОписаниеУчетныхДанных) через выбранный драйвер.
// Пустой username - вход под учетной записью Windows процесса, выполняющего серверный код 1С.
Функция ПодключитьсяКSQL(Соединение, Сообщение)

	Параметры = ПрочитатьУчетныеДанные().credentials;
	Если ПустаяСтрока(Параметры.server) Или ПустаяСтрока(Параметры.database) Тогда
		Сообщение = НСтр("ru = 'Не заполнены сервер или база в учетных данных'; en = 'Server or database is not set in credentials'");
		Возврат Ложь;
	КонецЕсли;

	СтрокаСоединения = "";
	Если Не СтрокаСоединенияSQL(Параметры, СтрокаСоединения, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionTimeout = 15;
		Соединение.CommandTimeout = 120;
		Соединение.Open(СтрокаСоединения);
	Исключение
		Соединение = Неопределено;
		Сообщение = СтрШаблон("%1/%2 (%3)", Параметры.server, Параметры.database, Параметры.provider)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Возвращает драйверы подключения к MS SQL для выбора в учетных данных (поле provider).
//
// Возвращаемое значение:
//   Массив из Структура:
//     * Имя            - Строка - имя провайдера OLE DB или драйвера ODBC, хранится в provider.
//     * Представление  - Строка - представление в списке выбора.
//     * Вид            - Строка - "OLEDB" (Provider=Имя) или "ODBC" (Provider=MSDASQL;Driver={Имя}).
//     * Дополнительно  - Строка - параметры, добавляемые в конец строки соединения.
//
Функция ДрайверыSQL() Экспорт

	Драйверы = Новый Массив;
	ДобавитьДрайверSQL(Драйверы, "MSOLEDBSQL", "OLEDB", "",
		НСтр("ru = 'Microsoft OLE DB Driver 18 for SQL Server'; en = 'Microsoft OLE DB Driver 18 for SQL Server'"));
	// В версии 19 шифрование по умолчанию обязательное и без доверенного сертификата сервера подключение не открывается.
	ДобавитьДрайверSQL(Драйверы, "MSOLEDBSQL19", "OLEDB", "Use Encryption for Data=Optional",
		НСтр("ru = 'Microsoft OLE DB Driver 19 for SQL Server'; en = 'Microsoft OLE DB Driver 19 for SQL Server'"));
	ДобавитьДрайверSQL(Драйверы, "SQLNCLI11", "OLEDB", "",
		НСтр("ru = 'SQL Server Native Client 11.0'; en = 'SQL Server Native Client 11.0'"));
	ДобавитьДрайверSQL(Драйверы, "SQLOLEDB", "OLEDB", "",
		НСтр("ru = 'Microsoft OLE DB Provider for SQL Server (устаревший, только TCP/IP и Named Pipes)'; en = 'Microsoft OLE DB Provider for SQL Server (legacy, TCP/IP and Named Pipes only)'"));
	ДобавитьДрайверSQL(Драйверы, "ODBC Driver 17 for SQL Server", "ODBC", "",
		НСтр("ru = 'ODBC Driver 17 for SQL Server'; en = 'ODBC Driver 17 for SQL Server'"));
	// В версии 18 шифрование по умолчанию обязательное.
	ДобавитьДрайверSQL(Драйверы, "ODBC Driver 18 for SQL Server", "ODBC", "Encrypt=no",
		НСтр("ru = 'ODBC Driver 18 for SQL Server'; en = 'ODBC Driver 18 for SQL Server'"));

	Возврат Драйверы;

КонецФункции

Процедура ДобавитьДрайверSQL(Драйверы, Имя, Вид, Дополнительно, Представление)

	Драйверы.Добавить(Новый Структура("Имя, Представление, Вид, Дополнительно", Имя, Представление, Вид, Дополнительно));

КонецПроцедуры

// Строит строку соединения ADO по виду выбранного драйвера (см. ДрайверыSQL):
//   OLEDB: Provider=<имя>;Data Source=;Initial Catalog=;Integrated Security=SSPI | User ID=;Password=
//   ODBC:  Provider=MSDASQL;Driver={<имя>};Server=;Database=;Trusted_Connection=Yes | UID=;PWD=
//
// Параметры:
//   Параметры        - Структура - см. ОписаниеУчетныхДанных.credentials.
//   СтрокаСоединения - Строка - выходной: строка соединения.
//   Сообщение        - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если драйвер известен и строка построена.
//
Функция СтрокаСоединенияSQL(Параметры, СтрокаСоединения, Сообщение)

	Драйвер = Неопределено;
	Для Каждого ОписаниеДрайвера Из ДрайверыSQL() Цикл
		Если ОписаниеДрайвера.Имя = Параметры.provider Тогда
			Драйвер = ОписаниеДрайвера;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Драйвер = Неопределено Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'Неизвестный драйвер ""%1"" в учетных данных'; en = 'Unknown driver ""%1"" in credentials'"),
			Параметры.provider);
		Возврат Ложь;
	КонецЕсли;

	ВходWindows = ПустаяСтрока(Параметры.username);
	ЧастиСтроки = Новый Массив;
	Если Драйвер.Вид = "ODBC" Тогда
		ЧастиСтроки.Добавить("Provider=MSDASQL");
		ЧастиСтроки.Добавить("Driver=" + ЗначениеСтрокиСоединенияODBC(Драйвер.Имя, Истина));
		ЧастиСтроки.Добавить("Server=" + ЗначениеСтрокиСоединенияODBC(Параметры.server));
		ЧастиСтроки.Добавить("Database=" + ЗначениеСтрокиСоединенияODBC(Параметры.database));
		Если ВходWindows Тогда
			ЧастиСтроки.Добавить("Trusted_Connection=Yes");
		Иначе
			ЧастиСтроки.Добавить("UID=" + ЗначениеСтрокиСоединенияODBC(Параметры.username));
			ЧастиСтроки.Добавить("PWD=" + ЗначениеСтрокиСоединенияODBC(Параметры.password));
		КонецЕсли;
	Иначе
		ЧастиСтроки.Добавить("Provider=" + Драйвер.Имя);
		ЧастиСтроки.Добавить("Data Source=" + ЗначениеСтрокиСоединения(Параметры.server));
		ЧастиСтроки.Добавить("Initial Catalog=" + ЗначениеСтрокиСоединения(Параметры.database));
		Если ВходWindows Тогда
			ЧастиСтроки.Добавить("Integrated Security=SSPI");
		Иначе
			ЧастиСтроки.Добавить("User ID=" + ЗначениеСтрокиСоединения(Параметры.username));
			ЧастиСтроки.Добавить("Password=" + ЗначениеСтрокиСоединения(Параметры.password));
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(Драйвер.Дополнительно) Тогда
		ЧастиСтроки.Добавить(Драйвер.Дополнительно);
	КонецЕсли;

	СтрокаСоединения = СтрСоединить(ЧастиСтроки, ";");

	Возврат Истина;

КонецФункции

// Возвращает значение для строки соединения ODBC: в фигурных скобках с удвоением "}", если в значении есть
// ; { } или пробелы по краям (ВсегдаВСкобках - для имени драйвера), иначе как есть.
Функция ЗначениеСтрокиСоединенияODBC(Значение, ВсегдаВСкобках = Ложь)

	Если Не ВсегдаВСкобках
		И СтрНайти(Значение, ";") = 0
		И СтрНайти(Значение, "{") = 0
		И СтрНайти(Значение, "}") = 0
		И Значение = СокрЛП(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат "{" + СтрЗаменить(Значение, "}", "}}") + "}";

КонецФункции

// Возвращает значение для строки соединения OLE DB: в двойных кавычках с удвоением внутренних кавычек,
// если в значении есть ; ' " или пробелы по краям, иначе как есть.
Функция ЗначениеСтрокиСоединения(Значение)

	Если СтрНайти(Значение, ";") = 0
		И СтрНайти(Значение, "'") = 0
		И СтрНайти(Значение, """") = 0
		И Значение = СокрЛП(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат """" + СтрЗаменить(Значение, """", """""") + """";

КонецФункции

// Выполняет запрос и возвращает первый открытый набор записей таблицей значений (см. FillDataSetFromRecordSet).
Функция ВыполнитьЗапросSQL(Соединение, ТекстЗапроса, СмещениеЛет, Таблица, Сообщение)

	Отказ = Ложь;
	RecordSet = GetRecordSet(Соединение, ТекстЗапроса, Отказ, Сообщение);
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		// Инструкции пакета без результата дают закрытые наборы записей.
		Пока RecordSet <> Неопределено И RecordSet.State = 0 Цикл
			RecordSet = RecordSet.NextRecordset();
		КонецЦикла;
		Если RecordSet = Неопределено Тогда
			Сообщение = НСтр("ru = 'Запрос не вернул данных'; en = 'Query returned no data'");
			Возврат Ложь;
		КонецЕсли;
		Таблица = Неопределено;
		FillDataSetFromRecordSet(RecordSet, Таблица, СмещениеЛет);
		RecordSet.Close();
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Строит схему компоновки для таблицы значений на основе макета EmptySample (его оформление и структура):
// набор данных-объект SQL с полями по колонкам таблицы, заголовок отчета - Заголовок.
// Представления - Соответствие, ключ - колонка ссылки, значение - колонка ее двоичного значения (см. ДобавитьСсылкиВыборки):
// поле ссылки показывается двоичным значением и выводится на месте двоичной колонки, сама двоичная колонка не выводится.
Функция СхемаВыборкиSQL(Таблица, Заголовок, Представления)

	Схема = ПолучитьМакет("EmptySample");

	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "SQL";
	НаборДанных.ИмяОбъекта = "SQL";
	НаборДанных.ИсточникДанных = Схема.ИсточникиДанных[0].Имя;

	Ссылки = Новый Соответствие;
	Для Каждого Представление Из Представления Цикл
		Ссылки.Вставить(Представление.Значение, Представление.Ключ);
	КонецЦикла;

	Настройки = Схема.ВариантыНастроек["Основной"].Настройки;
	Для Каждого Колонка Из Таблица.Колонки Цикл

		ПолеНабора = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.Поле = Колонка.Имя;
		ПолеНабора.ПутьКДанным = Колонка.Имя;
		ПолеНабора.Заголовок = Колонка.Имя;
		ПолеНабора.ТипЗначения = Колонка.ТипЗначения;
		Если Представления[Колонка.Имя] <> Неопределено Тогда
			ПолеНабора.ВыражениеПредставления = Представления[Колонка.Имя];
			Продолжить;
		КонецЕсли;

		ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(?(Ссылки[Колонка.Имя] = Неопределено, Колонка.Имя, Ссылки[Колонка.Имя]));

	КонецЦикла;

	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", Заголовок);

	Возврат Схема;

КонецФункции

// Возвращает двоичное значение ADO (COMSafeArray байтов) строкой 0x... как в MS SQL.
Функция ДвоичноеЗначениеSQL(МассивБайтов)

	Байты = МассивБайтов.Выгрузить();
	Буфер = Новый БуферДвоичныхДанных(Байты.Количество());
	Для Индекс = 0 По Байты.ВГраница() Цикл
		Буфер.Установить(Индекс, Байты[Индекс]);
	КонецЦикла;

	Возврат "0x" + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер);

КонецФункции

// Добавляет в таблицу выборки ссылки 1С по ссылочным полям (_IDRRef, _Fld123RRef, _Fld123_RRRef, _RecorderRRef...):
// двоичная колонка переименовывается в "<имя>_SQL", колонка с прежним именем получает ссылку, а при
// СпособОткрытияСсылки = "НавигационнаяСсылка" - навигационную ссылку e1cib/data/... строкой. Объект ссылки -
// тип реквизита, у составного поля - по номеру таблицы хранения из соседней колонки ..._RTRef (..TRef).
// Перечисления и поля, объект которых не определить, остаются без ссылки.
//
// Параметры:
//   Колонки       - Массив из Структура - колонки выборки, см. КолонкиВыборки.
//   Таблица       - ТаблицаЗначений - результат выборки с колонками по именам колонок выборки.
//   Представления - Соответствие - выходной: ключ - колонка ссылки, значение - колонка ее двоичного значения.
//   Сообщение     - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если ссылки добавлены.
//
Функция ДобавитьСсылкиВыборки(Колонки, Таблица, Представления, Сообщение)

	Представления = Новый Соответствие;
	ПоНавигационнойСсылке = (СпособОткрытияСсылки = "НавигационнаяСсылка");

	Попытка
		Для Каждого Поле Из Колонки Цикл

			ИмяКолонки = Поле.Имя;
			Колонка = Таблица.Колонки.Найти(ИмяКолонки);
			Если Колонка = Неопределено Или ПустаяСтрока(Поле.ИмяПоля) Или Не СтрЗаканчиваетсяНа(Поле.ИмяПоляХранения, "RRef") Тогда
				Продолжить;
			КонецЕсли;

			КолонкаТипа = "";
			Для Каждого ПолеТипа Из Колонки Цикл
				Если ПолеТипа.Псевдоним = Поле.Псевдоним
					И ПолеТипа.ИмяПоля = Поле.ИмяПоля
					И СтрЗаканчиваетсяНа(ПолеТипа.ИмяПоляХранения, "TRef") Тогда
					КолонкаТипа = ПолеТипа.Имя;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Объекты = ОбъектыСсылочногоПоля(ТипЗначенияПоля(Поле.ИмяТаблицы, Поле.ИмяПоля), Не ПустаяСтрока(КолонкаТипа));
			Если Объекты.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			КолонкаSQL = ИмяКолонки + "_SQL";
			Колонка.Имя = КолонкаSQL;
			Таблица.Колонки.Добавить(ИмяКолонки);
			Представления.Вставить(ИмяКолонки, КолонкаSQL);

			Для Каждого СтрокаТаблицы Из Таблица Цикл
				Если ПустаяСтрока(КолонкаТипа) Тогда
					ОбъектСсылки = Объекты[0];
				ИначеЕсли ТипЗнч(СтрокаТаблицы[КолонкаТипа]) = Тип("Строка") И ЗначениеЗаполнено(СтрокаТаблицы[КолонкаТипа]) Тогда
					ОбъектСсылки = Объекты[ЧислоИзШестнадцатеричнойСтроки(СтрокаТаблицы[КолонкаТипа])];
				Иначе
					ОбъектСсылки = Неопределено;
				КонецЕсли;
				Если ПоНавигационнойСсылке Тогда
					СтрокаТаблицы[ИмяКолонки] = НавигационнаяСсылкаПоИдентификаторуSQL(СтрокаТаблицы[КолонкаSQL], ОбъектСсылки);
				Иначе
					СтрокаТаблицы[ИмяКолонки] = СсылкаПоИдентификаторуSQL(СтрокаТаблицы[КолонкаSQL], ОбъектСсылки);
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Возвращает объекты ссылочных типов поля, кроме перечислений: Соответствие, ключ - номер основной таблицы
// хранения объекта (_Reference123 - 123), значение - полное имя объекта. У однотипного поля (ПоНомеруТаблицы = Ложь)
// ключ 0, если ссылочный тип один; иначе соответствие пустое.
Функция ОбъектыСсылочногоПоля(ТипПоля, ПоНомеруТаблицы)

	ПолныеИмена = Новый Массив;
	Для Каждого ТипСсылки Из ТипПоля.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипСсылки);
		Если МетаданныеТипа <> Неопределено
			И ОбщегоНазначения.ЭтоСсылка(ТипСсылки)
			И Не Метаданные.Перечисления.Содержит(МетаданныеТипа) Тогда
			ПолныеИмена.Добавить(МетаданныеТипа.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;

	Объекты = Новый Соответствие;
	Если Не ПоНомеруТаблицы Тогда
		Если ПолныеИмена.Количество() = 1 И ТипПоля.Типы().Количество() = 1 Тогда
			Объекты.Вставить(0, ПолныеИмена[0]);
		КонецЕсли;
		Возврат Объекты;
	КонецЕсли;

	Если ПолныеИмена.Количество() = 0 Тогда
		Возврат Объекты;
	КонецЕсли;

	Для Каждого ТаблицаХранения Из ПолучитьСтруктуруХраненияБазыДанных(ПолныеИмена, Истина) Цикл
		Если ТаблицаХранения.Назначение = "Основная" Тогда
			Объекты.Вставить(НомерТаблицыХранения(ТаблицаХранения.ИмяТаблицыХранения), ТаблицаХранения.Метаданные);
		КонецЕсли;
	КонецЦикла;

	Возврат Объекты;

КонецФункции

// Возвращает число в конце имени таблицы хранения: "_Reference123" - 123, без числа - 0.
Функция НомерТаблицыХранения(ИмяТаблицыХранения)

	Позиция = СтрДлина(ИмяТаблицыХранения);
	Пока Позиция > 0 И СтрНайти("0123456789", Сред(ИмяТаблицыХранения, Позиция, 1)) > 0 Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Цифры = Сред(ИмяТаблицыХранения, Позиция + 1);

	Возврат ?(ПустаяСтрока(Цифры), 0, Число(Цифры));

КонецФункции

// Возвращает ссылку объекта ПолноеИмя по значению _IDRRef строкой 0x..., обратно ИдентификаторСсылкиSQL.
// Неопределено, если значение не 16 байт или объект не задан.
Функция СсылкаПоИдентификаторуSQL(Идентификатор, ПолноеИмя)

	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или СтрДлина(Идентификатор) <> 34 Или Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Байты = Сред(Идентификатор, 3);
	УникальныйИдентификаторСсылки = Новый УникальныйИдентификатор(СтрШаблон("%1-%2-%3-%4-%5",
		Сред(Байты, 25, 8),
		Сред(Байты, 21, 4),
		Сред(Байты, 17, 4),
		Сред(Байты, 1, 4),
		Сред(Байты, 5, 12)));

	Возврат ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмя).ПолучитьСсылку(УникальныйИдентификаторСсылки);

КонецФункции

// Возвращает навигационную ссылку объекта ПолноеИмя по значению _IDRRef строкой 0x...: e1cib/data/<ПолноеИмя>?ref=<hex>.
// Параметр ref - байты _IDRRef в порядке хранения в MS SQL, поэтому перестановка байтов не нужна.
// Пустая строка, если значение не 16 байт или объект не задан.
Функция НавигационнаяСсылкаПоИдентификаторуSQL(Идентификатор, ПолноеИмя)

	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или СтрДлина(Идентификатор) <> 34 Или Не ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "e1cib/data/" + ПолноеИмя + "?ref=" + НРег(Сред(Идентификатор, 3));

КонецФункции

#КонецОбласти

#Область Запрос1С

// Строит по настройкам выборки (главный объект, ВыбранныеПоля, ОсновнойОтборЗапроса, Соединения, ОтборСоединений)
// запрос на языке 1С: те же таблицы с псевдонимами M, J1, J2... и поля, но по именам 1С вместо имен хранения.
// Поля хранения без имени 1С (служебные) в запрос не попадают, части составного реквизита дают одно поле.
// Значения отбора передаются параметрами &П1, &П2...
//
// Параметры:
//   Запрос1С  - Структура - выходной:
//     * ПолноеИмя  - Строка - главный объект.
//     * Выборка    - Строка - текст запроса ВЫБРАТЬ ПЕРВЫЕ <ЛимитВыборки>.
//     * Количество - Строка - текст запроса ВЫБРАТЬ КОЛИЧЕСТВО(*).
//     * Параметры  - Структура - параметры запроса.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если запрос построен.
//
Функция ЗапросВыборки1С(Запрос1С, Сообщение) Экспорт

	Описание = Неопределено;
	Если Не ОписаниеЗапроса(Ложь, Описание, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Колонки = Неопределено;
	Если Не КолонкиВыборки(Описание, Колонки, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Данные = Неопределено;
	Если Не ДанныеВыбора(Данные, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Параметры = Новый Структура;

	// Поля: по одному на поле 1С таблицы, служебные поля хранения без имени 1С пропускаются.
	Поля = Новый Массив;
	ДобавленныеПоля = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		Если ПустаяСтрока(Колонка.ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ПутьПоля = Колонка.Псевдоним + "." + Колонка.ИмяПоля;
		Если ДобавленныеПоля[ПутьПоля] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавленныеПоля.Вставить(ПутьПоля, Истина);
		ПсевдонимПоля = ?(Колонка.Псевдоним = "M", Колонка.ИмяПоля, Колонка.Псевдоним + "_" + Колонка.ИмяПоля);
		Поля.Добавить(СтрШаблон("%1 КАК %2", ПутьПоля, ПсевдонимПоля));
	КонецЦикла;
	Если Поля.Количество() = 0 Тогда
		Сообщение = НСтр("ru = 'В выборке нет полей с именем 1С'; en = 'The selection has no fields with a 1C name'");
		Возврат Ложь;
	КонецЕсли;

	// Источник: главная таблица и используемые соединения в порядке псевдонимов (см. ИсточникЗапроса).
	ЧастиИсточника = Новый Массив;
	ЧастиИсточника.Добавить(Символы.Таб + Описание.ПолноеИмя + " КАК M");
	ОтборыСоединений = ОтборСоединений.Выгрузить(Новый Структура("Использование", Истина));
	Для Каждого Соединение Из Соединения.НайтиСтроки(Новый Структура("Использование", Истина)) Цикл

		Псевдоним = Описание.Псевдонимы[Соединение.ИмяТаблицыХранения];
		ИмяТаблицы = Данные.ИменаТаблиц[Соединение.ИмяТаблицыХранения];

		ПолеГлавной = "";
		ПолеСоединяемой = "";
		Если Не ИмяПоля1С(Данные, Описание.ОсновнаяТаблица, Соединение.ПолеГлавнойТаблицы, ПолеГлавной, Сообщение)
			Или Не ИмяПоля1С(Данные, Соединение.ИмяТаблицыХранения, Соединение.ПолеСоединяемойТаблицы, ПолеСоединяемой, Сообщение) Тогда
			Возврат Ложь;
		КонецЕсли;

		Условия = Новый Массив;
		Условия.Добавить(СтрШаблон("M.%1 = %2.%3", ПолеГлавной, Псевдоним, ПолеСоединяемой));
		Если Не УсловияОтбора1С(ОтборыСоединений.НайтиСтроки(Новый Структура("ИмяТаблицыХранения", Соединение.ИмяТаблицыХранения)),
			Псевдоним, Данные, Условия, Параметры, Сообщение) Тогда
			Сообщение = ИмяТаблицы + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		ЧастиИсточника.Добавить(Символы.ПС + Символы.Таб + СтрШаблон("%1 СОЕДИНЕНИЕ %2 КАК %3",
			?(Соединение.ВидСоединения = "INNER", "ВНУТРЕННЕЕ", "ЛЕВОЕ"),
			ИмяТаблицы,
			Псевдоним)
			+ Символы.ПС + Символы.Таб + "ПО " + СтрСоединить(Условия, Символы.ПС + Символы.Таб + Символы.Таб + "И "));

	КонецЦикла;
	Источник = Символы.ПС + "ИЗ" + Символы.ПС + СтрСоединить(ЧастиИсточника, "");

	// Основной отбор: строка относится к главной или присоединенной таблице (см. СобратьWHERE).
	Условия = Новый Массив;
	Для Каждого СтрокаОтбора Из ОсновнойОтборЗапроса.НайтиСтроки(Новый Структура("Использование", Истина)) Цикл
		Если Не УсловияОтбора1С(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаОтбора),
			Описание.Псевдонимы[СтрокаОтбора.ИмяТаблицыХранения], Данные, Условия, Параметры, Сообщение) Тогда
			Сообщение = СтрокаОтбора.ОбъектМетаданных + ": " + Сообщение;
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Где = "";
	Если Условия.Количество() > 0 Тогда
		Где = Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + СтрСоединить(Условия, Символы.ПС + Символы.Таб + "И ");
	КонецЕсли;

	Запрос1С = Новый Структура("ПолноеИмя, Выборка, Количество, Параметры",
		Описание.ПолноеИмя,
		СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1", Формат(ЛимитВыборки(), "ЧГ=0")) + Символы.ПС
			+ Символы.Таб + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб) + Источник + Где,
		"ВЫБРАТЬ" + Символы.ПС + Символы.Таб + "КОЛИЧЕСТВО(*) КАК Количество" + Источник + Где,
		Параметры);

	Возврат Истина;

КонецФункции

// Формирует текст для поля скрипта: значения параметров комментариями, запрос количества и запрос выборки.
Функция СформироватьЗапрос1С(Скрипт, Сообщение)

	Запрос1С = Неопределено;
	Если Не ЗапросВыборки1С(Запрос1С, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЧастиСкрипта = Новый Массив;
	ЧастиСкрипта.Добавить("// " + Запрос1С.ПолноеИмя);
	Для Каждого Параметр Из Запрос1С.Параметры Цикл
		ЧастиСкрипта.Добавить(СтрШаблон("// &%1 = %2", Параметр.Ключ, Параметр.Значение));
	КонецЦикла;
	ЧастиСкрипта.Добавить("");
	ЧастиСкрипта.Добавить(Запрос1С.Количество + ";");
	ЧастиСкрипта.Добавить("");
	ЧастиСкрипта.Добавить("////////////////////////////////////////////////////////////////////////////////");
	ЧастиСкрипта.Добавить(Запрос1С.Выборка);

	Скрипт = СтрСоединить(ЧастиСкрипта, Символы.ПС);

	Возврат Истина;

КонецФункции

// Выполняет запрос 1С по настройкам выборки (см. ЗапросВыборки1С) и выводит результат в Визуализация через СКД
// с заголовком "<объект>: <показано> из <всего>". Ссылочные поля - ссылки 1С, щелчок по ячейке открывает объект;
// по их значениям в ДанныеРасшифровки работает упаковка (см. УпаковатьВыборку).
//
// Параметры:
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если выборка выполнена.
//
Функция ВывестиВыборку1С(Сообщение) Экспорт

	Запрос1С = Неопределено;
	Если Не ЗапросВыборки1С(Запрос1С, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос(Запрос1С.Количество);
		Для Каждого Параметр Из Запрос1С.Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
		Выборка = Запрос.Выполнить().Выбрать();
		Всего = ?(Выборка.Следующий(), Выборка.Количество, 0);

		Запрос.Текст = Запрос1С.Выборка;
		Таблица = Запрос.Выполнить().Выгрузить();

		Заголовок = СтрШаблон(НСтр("ru = '%1: %2 из %3'; en = '%1: %2 of %3'"),
			Запрос1С.ПолноеИмя,
			Формат(Таблица.Количество(), "ЧН=0; ЧГ=0"),
			Формат(Всего, "ЧН=0; ЧГ=0"));

		Визуализация.Очистить();
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);
		ВывестиДанныеЧерезСКД(СхемаВыборкиSQL(Таблица, Заголовок, Новый Соответствие),
			,
			,
			Новый Структура("SQL", Таблица),
			,
			ТабличныйДокумент,
			ВыходныеДанные);
		Визуализация.Вывести(ТабличныйДокумент);
		ДанныеРасшифровки = ВыходныеДанные.ДанныеРасшифровки;

	Исключение
		Сообщение = Запрос1С.ПолноеИмя + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Возвращает имя поля 1С по полю хранения таблицы (см. ДанныеВыбора.ИменаПолей).
Функция ИмяПоля1С(Данные, ИмяТаблицыХранения, ИмяПоляХранения, ИмяПоля, Сообщение)

	ИмяПоля = Данные.ИменаПолей[ИмяТаблицыХранения + "." + ИмяПоляХранения];
	Если ПустаяСтрока(ИмяПоля) Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'У поля хранения %1 таблицы %2 нет имени 1С: в запросе 1С оно недоступно'; en = 'Storage field %1 of table %2 has no 1C name and is not available in a 1C query'"),
			ИмяПоляХранения,
			?(Данные.ИменаТаблиц[ИмяТаблицыХранения] = Неопределено, ИмяТаблицыХранения, Данные.ИменаТаблиц[ИмяТаблицыХранения]));
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Добавляет в Условия условия строк отбора на языке 1С: "Псевдоним.ИмяПоля <сравнение> &Пn",
// для LIKE - ПОДОБНО, для IS NULL и IS NOT NULL - ЕСТЬ NULL и НЕ ... ЕСТЬ NULL без параметра.
Функция УсловияОтбора1С(СтрокиОтбора, Псевдоним, Данные, Условия, Параметры, Сообщение)

	Если Псевдоним = Неопределено Тогда
		Сообщение = НСтр("ru = 'Таблица отбора не главная и не присоединена: добавьте соединение'; en = 'Filter table is neither main nor joined: add a join'");
		Возврат Ложь;
	КонецЕсли;

	Сравнения = Новый Соответствие;
	// Не ВидСравнения: это имя системного перечисления, переменной цикла его назначить нельзя.
	Для Каждого Оператор Из СтрРазделить("=,<>,>,>=,<,<=", ",") Цикл
		Сравнения.Вставить(Оператор, Оператор);
	КонецЦикла;
	Сравнения.Вставить("LIKE", "ПОДОБНО");

	Для Каждого СтрокаОтбора Из СтрокиОтбора Цикл

		ИмяПоля = "";
		Если Не ИмяПоля1С(Данные, СтрокаОтбора.ИмяТаблицыХранения, СтрокаОтбора.ПолеХранения, ИмяПоля, Сообщение) Тогда
			Возврат Ложь;
		КонецЕсли;
		ПутьПоля = Псевдоним + "." + ИмяПоля;

		Если СтрокаОтбора.ВидСравнения = "IS NULL" Тогда
			Условия.Добавить(ПутьПоля + " ЕСТЬ NULL");
			Продолжить;
		ИначеЕсли СтрокаОтбора.ВидСравнения = "IS NOT NULL" Тогда
			Условия.Добавить("НЕ " + ПутьПоля + " ЕСТЬ NULL");
			Продолжить;
		КонецЕсли;

		Сравнение = Сравнения[СтрокаОтбора.ВидСравнения];
		Если Сравнение = Неопределено Тогда
			Сообщение = СтрШаблон(НСтр("ru = 'Недопустимый вид сравнения ""%1"" для поля %2'; en = 'Invalid comparison ""%1"" for field %2'"),
				СтрокаОтбора.ВидСравнения,
				ИмяПоля);
			Возврат Ложь;
		КонецЕсли;

		ИмяПараметра = "П" + Формат(Параметры.Количество() + 1, "ЧГ=0");
		Параметры.Вставить(ИмяПараметра, СтрокаОтбора.Значение);
		Условия.Добавить(СтрШаблон("%1 %2 &%3", ПутьПоля, Сравнение, ИмяПараметра));

	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Region СКД_ФормированиеДанныхИВизуализация

#Region СКД

// Получает данные сформированные посредством СКД, где хранится мэпинг принимаемых полей
// @ ИмяМакета - СхемаКомпоновкиДанных
// @ ИмяВариантаОтчета - Имя варианта отчета
// @ПараметрыОтчета - Параметры для управления формируемыми данными
// @НаборТаблиц -  Внешние данные
// @Результат - ДеревоЗначений/ТаблицаЗначений - Если пусто, то не формирует данные в объект
// @ТабличныйДокумент - Если пусто, то не формирует отчет
// @ВыходныеДанные - Возможные ключи: ДанныеРасшифровки, ВнешниеНаборыДанных
Function ВывестиДанныеЧерезСКД(ИмяМакета, ИмяВариантаОтчета = "Основной", ПараметрыОтчета = Неопределено, НаборТаблиц, Результат = Неопределено, ТабличныйДокумент = Неопределено, ВыходныеДанные = Неопределено) Экспорт
	
	Если ТипЗнч(ИмяМакета) = Тип("Строка") Тогда
		МакетСКД = ПолучитьМакет(ИмяМакета); // @ИмяМакета
	ИначеЕсли ТипЗнч(ИмяМакета) = Тип("СхемаКомпоновкиДанных") Тогда
		МакетСКД = ИмяМакета;
	Иначе
		ВызватьИсключение "Параметр 1 неверного типа"
	EndIf;

	Настройки = МакетСКД.ВариантыНастроек[ИмяВариантаОтчета].Настройки; // @ИмяВариантаОтчета

	Если ТипЗнч(ПараметрыОтчета) = Тип("Структура") Тогда
		Для Каждого Ъ Из ПараметрыОтчета Цикл
			
			Попытка
				Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
					Новый ПараметрКомпоновкиДанных(Ъ.Ключ), 
					Ъ.Значение
				);
			Исключение
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
	 
	Если ВыходныеДанные = Неопределено Тогда
		ВыходныеДанные = Новый Структура();
	КонецЕсли;

	ВнешниеНаборыДанных = Новый Структура();

	Для Каждого Набор ИЗ МакетСКД.НаборыДанных Цикл
		
		Если ТипЗнч(Набор) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		// Получаем структуру полей из набора данных СКД
		ПоляОтчета = Набор.Поля;
		ВнешнийНабор = Новый ТаблицаЗначений();
		Для Каждого П Из ПоляОтчета Цикл	
			ВнешнийНабор.Колонки.Добавить(П.Поле, П.ТипЗначения, П.Заголовок);
		КонецЦикла;
		
		ВнешниеНаборыДанных.Вставить(Набор.ИмяОбъекта, ВнешнийНабор);
	КонецЦикла;
	
	Для Каждого Ъ Из ВнешниеНаборыДанных Цикл
		Таблица = Неопределено;
		Если НаборТаблиц.Свойство(Ъ.Ключ, Таблица) Тогда
			Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
				Для Каждого СтрокаТаблицы Из Таблица Цикл
					ЗаполнитьЗначенияСвойств(Ъ.Значение.Добавить(), СтрокаТаблицы);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВыходныеДанные.Свойство("ВнешниеНаборыДанных") Тогда
		ВыходныеДанные.Вставить("ВнешниеНаборыДанных", ВнешниеНаборыДанных);
	КонецЕсли;

	// формируем отчет с помощью СКД
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	
	Если Результат <> Неопределено Тогда
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			МакетСКД,
			Настройки,
			,
			,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")
		);
	
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(Результат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
	КонецЕсли;

	Если ТабличныйДокумент <> Неопределено Тогда // @ТабличныйДокумент
		ДанныеРасшифровкиКомпоновки = Новый ДанныеРасшифровкиКомпоновкиДанных();
		
		МакетКомпоновкиОтчета = КомпоновщикМакета.Выполнить(МакетСКД, Настройки, ДанныеРасшифровкиКомпоновки);
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновкиОтчета, ВнешниеНаборыДанных, ДанныеРасшифровкиКомпоновки, Истина);
		ПроцессорВыводаОтчета = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент();
		ТабличныйДокумент.Очистить();
		ПроцессорВыводаОтчета.УстановитьДокумент(ТабличныйДокумент);
		ПроцессорВыводаОтчета.Вывести(ПроцессорКомпоновки, Истина);

		Если ВыходныеДанные.Свойство("ДанныеРасшифровки") Тогда
			ДанныеРасшифровкиКД = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиКомпоновки, ВыходныеДанные.ДанныеРасшифровки);
			ВыходныеДанные.Вставить("ДанныеРасшифровки", ДанныеРасшифровкиКД);
		КонецЕсли;
	КонецЕсли;

	Return Истина;
	
EndFunction

