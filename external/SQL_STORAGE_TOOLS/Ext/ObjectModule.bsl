#Область СериализацияОбъектов

// Собирает уникальные ссылки на объекты из расшифровки отчета на доске (ДанныеРасшифровки) и упаковывает
// объекты в строку XML. Берутся значения выведенных полей: ссылки 1С и навигационные ссылки e1cib/data/...
// (см. СсылкаИзЗначенияРасшифровки), поэтому упаковывается тот отчет, который сейчас на доске: выборка SQL
// при любом СпособОткрытияСсылки, запрос 1С или объекты пакета. Пустые ссылки и перечисления пропускаются.
//
// Параметры:
//   СтрокаXML        - Строка - выходной: пакет обмена в XML.
//   КоличествоСсылок - Число - выходной: количество уникальных упакованных ссылок.
//   Сообщение        - Строка - выходной: описание ошибки.
//   ВывестиОтчет     - Булево - вывести в Визуализация отчет объектов пакета (см. ВывестиОтчетПакета).
//
// Возвращаемое значение:
//   Булево - Истина, если пакет записан.
//
Функция УпаковатьВыборку(СтрокаXML, КоличествоСсылок, Сообщение, ВывестиОтчет = Ложь) Экспорт

	КоличествоСсылок = 0;

	Расшифровка = ?(ЭтоАдресВременногоХранилища(ДанныеРасшифровки), ПолучитьИзВременногоХранилища(ДанныеРасшифровки), Неопределено);
	Если ТипЗнч(Расшифровка) <> Тип("ДанныеРасшифровкиКомпоновкиДанных") Тогда
		Сообщение = НСтр("ru = 'Сначала выполните выборку'; en = 'Run the selection first'");
		Возврат Ложь;
	КонецЕсли;

	Ссылки = Новый Соответствие;
	Попытка
		Для Каждого ЭлементРасшифровки Из Расшифровка.Элементы Цикл
			Если ТипЗнч(ЭлементРасшифровки) <> Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ЗначениеПоля Из ЭлементРасшифровки.ПолучитьПоля() Цикл
				Ссылка = СсылкаИзЗначенияРасшифровки(ЗначениеПоля.Значение);
				Если ЗначениеЗаполнено(Ссылка) И ЭтоСсылочныйОбъект(Ссылка.Метаданные()) Тогда
					Ссылки.Вставить(Ссылка, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	МассивСсылок = Новый Массив;
	Для Каждого Элемент Из Ссылки Цикл
		МассивСсылок.Добавить(Элемент.Ключ);
	КонецЦикла;

	КоличествоСсылок = МассивСсылок.Количество();
	Если КоличествоСсылок = 0 Тогда
		Сообщение = НСтр("ru = 'В отчете на доске нет заполненных ссылок на объекты'; en = 'The report on the board has no filled object references'");
		Возврат Ложь;
	КонецЕсли;

	ПакетОбмена = Неопределено;
	Если Не УпаковатьОбъекты(МассивСсылок, ВключатьДвижения, ПакетОбмена, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗаписатьПакетОбменаВXML(ПакетОбмена, СтрокаXML, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ВывестиОтчет Тогда
		Возврат ВывестиОтчетПакета(ПакетОбмена, Сообщение);
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Читает пакет обмена из XML-файла, сделанного в этой или другой базе (см. ЗаписатьПакетОбменаВXML),
// и выводит в Визуализация его объекты со сравнением с текущей базой (см. ВывестиОтчетПакета).
// В базу ничего не записывается.
//
// Параметры:
//   СтрокаXML - Строка - текст файла пакета.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если отчет выведен.
//
Функция ПредпросмотрПакета(СтрокаXML, Сообщение) Экспорт

	ПакетОбмена = Неопределено;
	Если Не ПрочитатьПакетОбменаИзXML(СтрокаXML, ПакетОбмена, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ВывестиОтчетПакета(ПакетОбмена, Сообщение);

КонецФункции

// Выводит в Визуализация отчет объектов пакета обмена со сравнением с текущей базой:
//   N            - номер строки отчета, по нему щелчок показывает данные из пакета (см. ДанныеОбъектаПакета).
//   Тип          - полное имя объекта метаданных или регистра.
//   Объект       - ссылка на объект; для набора записей регистра - регистратор.
//   Представление - по данным пакета: ссылка на объект, которого нет в базе, представления не имеет.
//   Записей      - 1 для объекта, число записей для набора.
//   ЗаписейВБазе - 1/0 - есть ли объект в базе, для набора - число записей регистратора в базе;
//                  пусто, если сравнить нельзя (строка XML старого формата, независимый регистр сведений,
//                  тип, которого нет в конфигурации).
// Строки пакета старого формата (см. обработку СериализацияОбъекта): "НомерСообщения" пропускается,
// "XML" выводится одной строкой. Пакет и соответствие строк отчета строкам пакета сохраняются в АдресПакета.
// После записи или удаления пакета (см. ЗаписатьПакетВБазу, УдалитьПакетИзБазы) добавляется колонка Результат.
//
// Параметры:
//   ПакетОбмена     - ТаблицаЗначений - см. УпаковатьОбъекты.
//   Сообщение       - Строка - выходной: описание ошибки.
//   РезультатыЗаписи - Соответствие, Неопределено - ключ - см. КлючСтрокиПакета, значение - результат записи.
//
// Возвращаемое значение:
//   Булево - Истина, если отчет выведен.
//
Функция ВывестиОтчетПакета(ПакетОбмена, Сообщение, РезультатыЗаписи = Неопределено)

	Попытка

		СуществующиеСсылки = Неопределено;
		ЗаписиРегистраторов = Неопределено;
		ЗаписиПакетаВБазе(ПакетОбмена, СуществующиеСсылки, ЗаписиРегистраторов);
		ПредставленияСсылок = ПредставленияОбъектовПакета(ПакетОбмена);

		Строки = Новый ТаблицаЗначений;
		Строки.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
		Строки.Колонки.Добавить("Объект");
		Строки.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		Строки.Колонки.Добавить("Записей", Новый ОписаниеТипов("Число"));
		Строки.Колонки.Добавить("ЗаписейВБазе");
		Строки.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
		Строки.Колонки.Добавить("ИндексОбъекта");

		Для ИндексСтроки = 0 По ПакетОбмена.Количество() - 1 Цикл

			СтрокаПакета = ПакетОбмена[ИндексСтроки];
			Если СтрокаПакета.Тип = "НомерСообщения" Тогда
				Продолжить;
			КонецЕсли;

			СтрокаОтчета = Строки.Добавить();
			СтрокаОтчета.Тип = СтрокаПакета.Тип;
			СтрокаОтчета.ИндексСтроки = ИндексСтроки;

			Если ТипЗнч(СтрокаПакета.Объект) <> Тип("ТаблицаЗначений") Тогда
				СтрокаОтчета.Представление = ?(СтрокаПакета.Тип = "XML",
					НСтр("ru = 'Объекты в XML (старый формат)'; en = 'Objects in XML (legacy format)'"),
					Строка(ТипЗнч(СтрокаПакета.Объект)));
				СтрокаОтчета.Записей = 1;
				Продолжить;
			КонецЕсли;

			Данные = СтрокаПакета.Объект;
			ЕстьМетаданные = (Метаданные.НайтиПоПолномуИмени(СтрокаПакета.Тип) <> Неопределено);
			ПометкаМетаданных = ?(ЕстьМетаданные, "",
				" " + НСтр("ru = '(нет в конфигурации)'; en = '(not in configuration)'"));

			Если Данные.Колонки.Найти("Ссылка") <> Неопределено Тогда
				Строки.Удалить(СтрокаОтчета);
				Для ИндексОбъекта = 0 По Данные.Количество() - 1 Цикл
					ДанныеОбъекта = Данные[ИндексОбъекта];
					СтрокаОтчета = Строки.Добавить();
					СтрокаОтчета.Тип = СтрокаПакета.Тип;
					СтрокаОтчета.ИндексСтроки = ИндексСтроки;
					СтрокаОтчета.ИндексОбъекта = ИндексОбъекта;
					СтрокаОтчета.Объект = ДанныеОбъекта.Ссылка;
					СтрокаОтчета.Представление = ПредставленияСсылок[ДанныеОбъекта.Ссылка] + ПометкаМетаданных;
					СтрокаОтчета.Записей = 1;
					Если ЕстьМетаданные Тогда
						СтрокаОтчета.ЗаписейВБазе = ?(СуществующиеСсылки[ДанныеОбъекта.Ссылка] = Неопределено, 0, 1);
					КонецЕсли;
				КонецЦикла;
				Продолжить;
			КонецЕсли;

			// Набор записей регистра: по регистратору или независимый (запись регистра сведений).
			СтрокаОтчета.Записей = Данные.Количество();
			Удалений = КоличествоУдаленийНабора(Данные);
			ПометкаУдалений = ?(Удалений = 0, "",
				" " + СтрШаблон(НСтр("ru = '(удалений: %1)'; en = '(deletions: %1)'"), Формат(Удалений, "ЧГ=0")));
			Если ЗначениеЗаполнено(СтрокаПакета.Регистратор) Тогда
				СтрокаОтчета.Объект = СтрокаПакета.Регистратор;
				Представление = ПредставленияСсылок[СтрокаПакета.Регистратор];
				СтрокаОтчета.Представление = ?(Представление = Неопределено, Строка(СтрокаПакета.Регистратор), Представление)
					+ ПометкаУдалений + ПометкаМетаданных;
				Если ЕстьМетаданные Тогда
					ЗаписиРегистра = ЗаписиРегистраторов[СтрокаПакета.Тип];
					КоличествоВБазе = ?(ЗаписиРегистра = Неопределено, Неопределено, ЗаписиРегистра[СтрокаПакета.Регистратор]);
					СтрокаОтчета.ЗаписейВБазе = ?(КоличествоВБазе = Неопределено, 0, КоличествоВБазе);
				КонецЕсли;
			Иначе
				СтрокаОтчета.Представление = НСтр("ru = 'Записи без регистратора'; en = 'Records without recorder'")
					+ ПометкаУдалений + ПометкаМетаданных;
			КонецЕсли;

		КонецЦикла;
		Строки.Сортировать("Тип, Представление, ИндексСтроки, ИндексОбъекта");

		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("N", Новый ОписаниеТипов("Число"));
		Таблица.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
		Таблица.Колонки.Добавить("Объект");
		Таблица.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
		Таблица.Колонки.Добавить("Записей", Новый ОписаниеТипов("Число"));
		Таблица.Колонки.Добавить("ЗаписейВБазе");
		Если РезультатыЗаписи <> Неопределено Тогда
			Таблица.Колонки.Добавить("Результат", Новый ОписаниеТипов("Строка"));
		КонецЕсли;

		СтрокиПакета = Новый Массив;
		НетВБазе = 0;
		Для Каждого СтрокаОтчета Из Строки Цикл
			СтрокаТаблицы = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаОтчета);
			СтрокаТаблицы.N = Таблица.Количество();
			Если РезультатыЗаписи <> Неопределено Тогда
				Результат = РезультатыЗаписи[КлючСтрокиПакета(СтрокаОтчета.ИндексСтроки, СтрокаОтчета.ИндексОбъекта)];
				СтрокаТаблицы.Результат = ?(Результат = Неопределено, "", Результат);
			КонецЕсли;
			Если СтрокаОтчета.ЗаписейВБазе = 0 Тогда
				НетВБазе = НетВБазе + 1;
			КонецЕсли;
			СтрокиПакета.Добавить(Новый Структура("Строка, Объект, Заголовок",
				СтрокаОтчета.ИндексСтроки,
				СтрокаОтчета.ИндексОбъекта,
				СтрокаОтчета.Тип + ": " + СтрокаОтчета.Представление));
		КонецЦикла;

		Заголовок = СтрШаблон(НСтр("ru = 'Объекты пакета: %1, нет в базе: %2'; en = 'Package objects: %1, not in the infobase: %2'"),
			Формат(Таблица.Количество(), "ЧН=0; ЧГ=0"),
			Формат(НетВБазе, "ЧН=0; ЧГ=0"));

		Визуализация.Очистить();
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);
		ВывестиДанныеЧерезСКД(СхемаВыборкиSQL(Таблица, Заголовок, Новый Соответствие),
			,
			,
			Новый Структура("SQL", Таблица),
			,
			ТабличныйДокумент,
			ВыходныеДанные);
		Визуализация.Вывести(ТабличныйДокумент);
		ДанныеРасшифровки = ВыходныеДанные.ДанныеРасшифровки;

		АдресПакета = ПоместитьВоВременноеХранилище(Новый Структура("ДанныеРасшифровки, Пакет, Строки",
				ДанныеРасшифровки,
				ПакетОбмена,
				СтрокиПакета),
			?(ЭтоАдресВременногоХранилища(АдресПакета), АдресПакета, УникальныйИдентификатор));

	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Строит табличный документ с данными строки отчета пакета на доске (см. ВывестиОтчетПакета): для объекта -
// реквизиты "Реквизит | Значение" и табличные части, для набора записей - записи, для XML старого формата - текст.
//
// Параметры:
//   Поля              - Соответствие - поля расшифровки ячейки и ее родителей: ключ - имя поля, нужно поле N.
//   ТабличныйДокумент - ТабличныйДокумент - выходной: данные из пакета.
//   Заголовок         - Строка - выходной: заголовок окна "<Тип>: <Представление>".
//
// Возвращаемое значение:
//   Булево - Истина, если на доске отчет пакета и строка найдена; Ложь - расшифровка не из отчета пакета.
//
Функция ДанныеОбъектаПакета(Поля, ТабличныйДокумент, Заголовок) Экспорт

	Если Не ЭтоАдресВременногоХранилища(АдресПакета) Или Не ЭтоАдресВременногоХранилища(ДанныеРасшифровки) Тогда
		Возврат Ложь;
	КонецЕсли;

	Пакет = ПолучитьИзВременногоХранилища(АдресПакета);
	Если ТипЗнч(Пакет) <> Тип("Структура") Или Пакет.ДанныеРасшифровки <> ДанныеРасшифровки Тогда
		Возврат Ложь;
	КонецЕсли;

	Номер = Поля["N"];
	Если ТипЗнч(Номер) <> Тип("Число") Или Номер < 1 Или Номер > Пакет.Строки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;

	ОписаниеСтроки = Пакет.Строки[Номер - 1];
	СтрокаПакета = Пакет.Пакет[ОписаниеСтроки.Строка];
	Заголовок = ОписаниеСтроки.Заголовок;

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Если ТипЗнч(СтрокаПакета.Объект) <> Тип("ТаблицаЗначений") Тогда
		ТабличныйДокумент.Область(1, 1).Текст = Строка(СтрокаПакета.Объект);
		Возврат Истина;
	КонецЕсли;

	Если ОписаниеСтроки.Объект = Неопределено Тогда
		ВывестиТаблицуПакета(ТабличныйДокумент, СтрокаПакета.Объект, Заголовок);
		Возврат Истина;
	КонецЕсли;

	ДанныеОбъекта = СтрокаПакета.Объект[ОписаниеСтроки.Объект];

	Реквизиты = Новый ТаблицаЗначений;
	Реквизиты.Колонки.Добавить(НСтр("ru = 'Реквизит'; en = 'Attribute'"));
	Реквизиты.Колонки.Добавить(НСтр("ru = 'Значение'; en = 'Value'"));
	ТабличныеЧасти = Новый Массив;
	Для Каждого Колонка Из СтрокаПакета.Объект.Колонки Цикл
		Значение = ДанныеОбъекта[Колонка.Имя];
		Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			ТабличныеЧасти.Добавить(Колонка.Имя);
			Продолжить;
		КонецЕсли;
		СтрокаРеквизита = Реквизиты.Добавить();
		СтрокаРеквизита[0] = Колонка.Имя;
		СтрокаРеквизита[1] = Значение;
	КонецЦикла;
	ВывестиТаблицуПакета(ТабличныйДокумент, Реквизиты, Заголовок);

	Для Каждого ИмяТабличнойЧасти Из ТабличныеЧасти Цикл
		ВывестиТаблицуПакета(ТабличныйДокумент, ДанныеОбъекта[ИмяТабличнойЧасти], ИмяТабличнойЧасти);
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Выводит в табличный документ под последней заполненной строкой заголовок и таблицу с шапкой из колонок.
// Вложенные таблицы выводятся числом строк.
Процедура ВывестиТаблицуПакета(ТабличныйДокумент, Таблица, Заголовок)

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	НомерСтроки = ?(ТабличныйДокумент.ВысотаТаблицы = 0, 1, ТабличныйДокумент.ВысотаТаблицы + 2);

	ОбластьЗаголовка = ТабличныйДокумент.Область(НомерСтроки, 1);
	ОбластьЗаголовка.Текст = СтрШаблон("%1 (%2)", Заголовок, Формат(Таблица.Количество(), "ЧН=0; ЧГ=0"));
	ОбластьЗаголовка.Шрифт = Новый Шрифт(ОбластьЗаголовка.Шрифт, , , Истина);
	НомерСтроки = НомерСтроки + 1;

	Для НомерКолонки = 1 По Таблица.Колонки.Количество() Цикл
		Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
		Ячейка.Текст = Таблица.Колонки[НомерКолонки - 1].Имя;
		Ячейка.Шрифт = Новый Шрифт(Ячейка.Шрифт, , , Истина);
		Ячейка.ЦветФона = WebЦвета.СветлоСерый;
		Ячейка.Обвести(Линия, Линия, Линия, Линия);
		Если ТабличныйДокумент.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки < 20 Тогда
			ТабличныйДокумент.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = 20;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерСтроки = НомерСтроки + 1;
		Для НомерКолонки = 1 По Таблица.Колонки.Количество() Цикл
			Значение = СтрокаТаблицы[НомерКолонки - 1];
			Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки);
			Если ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
				Ячейка.Текст = СтрШаблон(НСтр("ru = '<строк: %1>'; en = '<rows: %1>'"), Значение.Количество());
			Иначе
				Ячейка.Текст = Строка(Значение);
			КонецЕсли;
			Ячейка.Обвести(Линия, Линия, Линия, Линия);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Заполняет по текущей базе: СуществующиеСсылки - Соответствие ссылок объектов пакета, которые есть в базе
// (значение Истина); ЗаписиРегистраторов - Соответствие: ключ - полное имя регистра, значение - Соответствие
// "регистратор - число записей в базе". Один запрос на тип объекта и на регистр; типы и регистры,
// которых нет в конфигурации, пропускаются.
Процедура ЗаписиПакетаВБазе(ПакетОбмена, СуществующиеСсылки, ЗаписиРегистраторов)

	СуществующиеСсылки = Новый Соответствие;
	ЗаписиРегистраторов = Новый Соответствие;

	СсылкиПоТипам = Новый Соответствие;
	РегистраторыПоРегистрам = Новый Соответствие;
	Для Каждого СтрокаПакета Из ПакетОбмена Цикл

		Если ТипЗнч(СтрокаПакета.Объект) <> Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(СтрокаПакета.Тип);
		Если МетаданныеОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЭтоСсылочныйОбъект(МетаданныеОбъекта) И СтрокаПакета.Объект.Колонки.Найти("Ссылка") <> Неопределено Тогда
			ДобавитьВСоответствиеМассивов(СсылкиПоТипам, СтрокаПакета.Тип, СтрокаПакета.Объект.ВыгрузитьКолонку("Ссылка"));
		ИначеЕсли ЗначениеЗаполнено(СтрокаПакета.Регистратор) И МенеджерРегистра(МетаданныеОбъекта) <> Неопределено Тогда
			ДобавитьВСоответствиеМассивов(РегистраторыПоРегистрам, СтрокаПакета.Тип,
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрокаПакета.Регистратор));
		КонецЕсли;

	КонецЦикла;

	Запрос = Новый Запрос;
	Для Каждого Элемент Из СсылкиПоТипам Цикл
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Таблица.Ссылка КАК Ссылка
			|ИЗ
			|	" + Элемент.Ключ + " КАК Таблица
			|ГДЕ
			|	Таблица.Ссылка В (&Ссылки)";
		Запрос.УстановитьПараметр("Ссылки", Элемент.Значение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СуществующиеСсылки.Вставить(Выборка.Ссылка, Истина);
		КонецЦикла;
	КонецЦикла;

	Для Каждого Элемент Из РегистраторыПоРегистрам Цикл
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Таблица.Регистратор КАК Регистратор,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	" + Элемент.Ключ + " КАК Таблица
			|ГДЕ
			|	Таблица.Регистратор В (&Регистраторы)
			|
			|СГРУППИРОВАТЬ ПО
			|	Таблица.Регистратор";
		Запрос.УстановитьПараметр("Регистраторы", Элемент.Значение);
		ЗаписиРегистра = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаписиРегистра.Вставить(Выборка.Регистратор, Выборка.Количество);
		КонецЦикла;
		ЗаписиРегистраторов.Вставить(Элемент.Ключ, ЗаписиРегистра);
	КонецЦикла;

КонецПроцедуры

// Добавляет значения в массив соответствия по ключу, создавая массив при первом обращении.
Процедура ДобавитьВСоответствиеМассивов(Соответствие, Ключ, Значения)

	Массив = Соответствие[Ключ];
	Если Массив = Неопределено Тогда
		Массив = Новый Массив;
		Соответствие.Вставить(Ключ, Массив);
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Массив, Значения);

КонецПроцедуры

// Возвращает представления объектов пакета по их данным, а не по ссылке (объекта может не быть в базе):
// Соответствие, ключ - ссылка, значение - Наименование, иначе "Номер от Дата", иначе Код, иначе уникальный идентификатор.
Функция ПредставленияОбъектовПакета(ПакетОбмена)

	Представления = Новый Соответствие;
	Для Каждого СтрокаПакета Из ПакетОбмена Цикл

		Если ТипЗнч(СтрокаПакета.Объект) <> Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		Колонки = СтрокаПакета.Объект.Колонки;
		Если Колонки.Найти("Ссылка") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЕстьНаименование = (Колонки.Найти("Наименование") <> Неопределено);
		ЕстьНомерИДата = (Колонки.Найти("Номер") <> Неопределено И Колонки.Найти("Дата") <> Неопределено);
		ЕстьКод = (Колонки.Найти("Код") <> Неопределено);

		Для Каждого ДанныеОбъекта Из СтрокаПакета.Объект Цикл
			Если ЕстьНаименование И ЗначениеЗаполнено(ДанныеОбъекта.Наименование) Тогда
				Представление = Строка(ДанныеОбъекта.Наименование);
			ИначеЕсли ЕстьНомерИДата Тогда
				Представление = СтрШаблон(НСтр("ru = '%1 от %2'; en = '%1 dated %2'"),
					ДанныеОбъекта.Номер,
					Формат(ДанныеОбъекта.Дата, "ДЛФ=DT"));
			ИначеЕсли ЕстьКод И ЗначениеЗаполнено(ДанныеОбъекта.Код) Тогда
				Представление = Строка(ДанныеОбъекта.Код);
			ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ДанныеОбъекта.Ссылка)) Тогда
				Представление = Строка(ДанныеОбъекта.Ссылка.УникальныйИдентификатор());
			Иначе
				Представление = Строка(ДанныеОбъекта.Ссылка);
			КонецЕсли;
			Представления.Вставить(ДанныеОбъекта.Ссылка, Представление);
		КонецЦикла;

	КонецЦикла;

	Возврат Представления;

КонецФункции

// Возвращает число записей набора, помеченных к удалению колонкой _ЭтоУдаление_ (пакеты СериализацияОбъекта).
Функция КоличествоУдаленийНабора(Данные)

	Если Данные.Колонки.Найти("_ЭтоУдаление_") = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Данные.НайтиСтроки(Новый Структура("_ЭтоУдаление_", Истина)).Количество();

КонецФункции

// Возвращает ссылку по значению поля расшифровки отчета: ссылку - как есть, навигационную ссылку
// e1cib/data/<ПолноеИмя>?ref=<hex> - по байтам _IDRRef в порядке хранения в SQL (см. СсылкаПоИдентификаторуSQL).
// Для остальных значений - Неопределено.
Функция СсылкаИзЗначенияРасшифровки(Значение)

	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Тогда
		Возврат Значение;
	КонецЕсли;

	Префикс = "e1cib/data/";
	Если ТипЗнч(Значение) <> Тип("Строка") Или Не СтрНачинаетсяС(Значение, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = СтрРазделить(Сред(Значение, СтрДлина(Префикс) + 1), "?");
	Если Части.Количество() <> 2 Или Не СтрНачинаетсяС(Части[1], "ref=") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СсылкаПоИдентификаторуSQL("0x" + Сред(Части[1], 5), Части[0]);

КонецФункции

// Упаковывает объекты в пакет обмена и записывает его в строку XML.
//
// Параметры:
//   Ссылки           - Массив - ссылки на объекты ссылочных типов (справочники, документы и т. п.).
//   ВключатьДвижения - Булево - для документов добавить в пакет их движения по регистрам.
//   СтрокаXML        - Строка - выходной: пакет обмена в XML, см. ЗаписатьПакетОбменаВXML.
//   Сообщение        - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет записан.
//
Функция УпаковатьОбъектыВXML(Ссылки, ВключатьДвижения, СтрокаXML, Сообщение) Экспорт

	ПакетОбмена = Неопределено;
	Если Не УпаковатьОбъекты(Ссылки, ВключатьДвижения, ПакетОбмена, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗаписатьПакетОбменаВXML(ПакетОбмена, СтрокаXML, Сообщение);

КонецФункции

// Упаковывает данные объектов в таблицу значений - пакет обмена.
//
// Параметры:
//   Ссылки           - Массив - ссылки на объекты ссылочных типов (справочники, документы и т. п.).
//   ВключатьДвижения - Булево - для документов добавить в пакет их движения по регистрам.
//   ПакетОбмена      - ТаблицаЗначений - выходной, колонки:
//     * Тип         - Строка - полное имя объекта метаданных, например "Документ.ЧекККМ".
//     * Объект      - ТаблицаЗначений - для ссылочных объектов: результат "ВЫБРАТЬ *" по всем ссылкам
//                     этого типа (табличные части - вложенными таблицами); для регистров - выгрузка набора записей.
//     * Регистратор - ДокументСсылка, Неопределено - регистратор набора записей.
//   Сообщение        - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет сформирован.
//
Функция УпаковатьОбъекты(Ссылки, ВключатьДвижения, ПакетОбмена, Сообщение) Экспорт

	ПакетОбмена = НовыйПакетОбмена();

	Попытка

		СсылкиПоТипам = Новый Соответствие;
		Для Каждого Ссылка Из Ссылки Цикл

			МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
			Если МетаданныеОбъекта = Неопределено Или Не ЭтоСсылочныйОбъект(МетаданныеОбъекта) Тогда
				Сообщение = СтрШаблон(
					НСтр("ru = 'Значение типа %1 не является ссылкой на объект'; en = 'Value of type %1 is not an object reference'"),
					ТипЗнч(Ссылка));
				Возврат Ложь;
			КонецЕсли;

			ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
			СсылкиТипа = СсылкиПоТипам[ПолноеИмя];
			Если СсылкиТипа = Неопределено Тогда
				СсылкиТипа = Новый Массив;
				СсылкиПоТипам.Вставить(ПолноеИмя, СсылкиТипа);
			КонецЕсли;
			СсылкиТипа.Добавить(Ссылка);

		КонецЦикла;

		Для Каждого Элемент Из СсылкиПоТипам Цикл

			ДобавитьДанныеОбъектов(ПакетОбмена, Элемент.Ключ, Элемент.Значение);

			МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(Элемент.Ключ);
			Если ВключатьДвижения И Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
				ДобавитьДвиженияДокументов(ПакетОбмена, МетаданныеОбъекта, Элемент.Значение);
			КонецЕсли;

		КонецЦикла;

	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Записывает пакет обмена в строку XML: пакет сжимается в ХранилищеЗначения и сериализуется
// в разметку <root><Package>...</Package><Result>OK</Result></root>.
//
// Параметры:
//   ПакетОбмена - ТаблицаЗначений - см. УпаковатьОбъекты.
//   СтрокаXML   - Строка - выходной: пакет обмена в XML.
//   Сообщение   - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет записан.
//
Функция ЗаписатьПакетОбменаВXML(ПакетОбмена, СтрокаXML, Сообщение) Экспорт

	Попытка

		ХранилищеДанных = Новый ХранилищеЗначения(ПакетОбмена, Новый СжатиеДанных(3));

		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.УстановитьСтроку();
		ЗаписьXML.ЗаписатьНачалоЭлемента("root");

		ЗаписьXML.ЗаписатьНачалоЭлемента("Package");
		ЗаписатьXML(ЗаписьXML, ХранилищеДанных);
		ЗаписьXML.ЗаписатьКонецЭлемента();

		ЗаписьXML.ЗаписатьНачалоЭлемента("Result");
		ЗаписьXML.ЗаписатьТекст("OK");
		ЗаписьXML.ЗаписатьКонецЭлемента();

		ЗаписьXML.ЗаписатьКонецЭлемента();
		СтрокаXML = ЗаписьXML.Закрыть();

	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Читает пакет обмена из строки XML <root><Package>...</Package>...</root> (см. ЗаписатьПакетОбменаВXML):
// ХранилищеЗначения из элемента Package распаковывается в таблицу значений. Пакет с атрибутом
// Package status="empty" считается пустым. Типы объектов пакета должны быть в конфигурации текущей базы,
// иначе распаковка дает ошибку; ссылки на объекты, которых в базе нет, распаковываются битыми ссылками.
//
// Параметры:
//   СтрокаXML   - Строка - пакет обмена в XML.
//   ПакетОбмена - ТаблицаЗначений - выходной: см. УпаковатьОбъекты.
//   Сообщение   - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет прочитан.
//
Функция ПрочитатьПакетОбменаИзXML(СтрокаXML, ПакетОбмена, Сообщение) Экспорт

	ПакетОбмена = Неопределено;
	ЕстьПакет = Ложь;
	ХранилищеДанных = Неопределено;

	Попытка

		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Или ЧтениеXML.Имя <> "Package" Тогда
				Продолжить;
			КонецЕсли;
			ЕстьПакет = Истина;
			Если ЧтениеXML.ПолучитьАтрибут("status") = "empty" Тогда
				Прервать;
			КонецЕсли;
			// Пропуск пробельных символов, если файл переформатирован.
			Пока ЧтениеXML.Прочитать() И ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Цикл
			КонецЦикла;
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				ХранилищеДанных = ПрочитатьXML(ЧтениеXML);
			КонецЕсли;
			Прервать;
		КонецЦикла;
		ЧтениеXML.Закрыть();

	Исключение
		Сообщение = НСтр("ru = 'Не удалось прочитать XML пакета'; en = 'Failed to read the package XML'")
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Если Не ЕстьПакет Тогда
		Сообщение = НСтр("ru = 'В XML нет элемента Package: это не пакет обмена'; en = 'The XML has no Package element: it is not an exchange package'");
		Возврат Ложь;
	ИначеЕсли ХранилищеДанных = Неопределено Тогда
		Сообщение = НСтр("ru = 'Пакет пуст'; en = 'The package is empty'");
		Возврат Ложь;
	ИначеЕсли ТипЗнч(ХранилищеДанных) <> Тип("ХранилищеЗначения") Тогда
		Сообщение = СтрШаблон(НСтр("ru = 'В элементе Package значение типа %1 вместо ХранилищеЗначения'; en = 'The Package element holds %1 instead of ValueStorage'"),
			ТипЗнч(ХранилищеДанных));
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Данные = ХранилищеДанных.Получить();
	Исключение
		Сообщение = НСтр("ru = 'Не удалось распаковать пакет: возможно, в нем есть типы, которых нет в конфигурации этой базы'; en = 'Failed to unpack the package: it may contain types missing from this infobase configuration'")
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("ТаблицаЗначений")
		Или Данные.Колонки.Найти("Тип") = Неопределено
		Или Данные.Колонки.Найти("Объект") = Неопределено
		Или Данные.Колонки.Найти("Регистратор") = Неопределено Тогда
		Сообщение = НСтр("ru = 'Пакет не является таблицей с колонками Тип, Объект, Регистратор'; en = 'The package is not a table with Тип, Объект, Регистратор columns'");
		Возврат Ложь;
	КонецЕсли;

	ПакетОбмена = Данные;

	Возврат Истина;

КонецФункции

// Записывает в текущую базу пакет, отчет которого сейчас на доске (см. ВывестиОтчетПакета), и выводит
// тот же отчет с колонкой Результат. Объекты пишутся по одному в режиме ОбменДанными.Загрузка без регистрации
// изменений в планах обмена: объект, которого нет в базе, создается с той же ссылкой, существующий -
// перезаписывается данными пакета (реквизиты и табличные части). Наборы записей по регистратору
// перезаписываются целиком, записи независимого регистра сведений - по ключу записи
// (с _ЭтоУдаление_ - удаляются). Строки XML старого формата: каждый объект пишется как есть.
// Ошибка строки не останавливает запись остальных (кроме флажка ОстановитьПриОшибке, см. ЗанестиВЖурналСобытий).
//
// Параметры:
//   Записано  - Число - выходной: число записанных объектов и наборов.
//   Ошибок    - Число - выходной: число строк с ошибкой.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет обработан (в том числе с ошибками строк).
//
Функция ЗаписатьПакетВБазу(Записано, Ошибок, Сообщение) Экспорт

	Записано = 0;
	Ошибок = 0;

	ПакетОбмена = Неопределено;
	Если Не ПакетНаДоске(ПакетОбмена, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяСобытия = ПолучитьИмяСобытия("ЗаписьПакета");
	РезультатыЗаписи = Новый Соответствие;

	Для ИндексСтроки = 0 По ПакетОбмена.Количество() - 1 Цикл

		СтрокаПакета = ПакетОбмена[ИндексСтроки];
		Если СтрокаПакета.Тип = "НомерСообщения" Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаПакета.Тип = "XML" Тогда
			Количество = 0;
			Сообщение = "";
			Если ЗаписатьОбъектыXML(СтрокаПакета.Объект, Количество, Сообщение) Тогда
				Записано = Записано + Количество;
				РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки),
					СтрШаблон(НСтр("ru = 'Записано: %1'; en = 'Written: %1'"), Количество));
			Иначе
				Ошибок = Ошибок + 1;
				РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки), Сообщение);
				ЗанестиВЖурналСобытий(ИмяСобытия, Неопределено, Ложь, Сообщение);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(СтрокаПакета.Тип);
		Если МетаданныеОбъекта = Неопределено Или ТипЗнч(СтрокаПакета.Объект) <> Тип("ТаблицаЗначений") Тогда
			Ошибок = Ошибок + 1;
			Сообщение = СтрШаблон(НСтр("ru = '%1: нет в конфигурации, строка пропущена'; en = '%1: not in configuration, row skipped'"),
				СтрокаПакета.Тип);
			РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки), Сообщение);
			ЗанестиВЖурналСобытий(ИмяСобытия, Неопределено, Ложь, Сообщение);
			Продолжить;
		КонецЕсли;

		Если ЭтоСсылочныйОбъект(МетаданныеОбъекта) Тогда

			Для ИндексОбъекта = 0 По СтрокаПакета.Объект.Количество() - 1 Цикл
				ДанныеОбъекта = СтрокаПакета.Объект[ИндексОбъекта];
				Результат = "";
				Сообщение = "";
				Если ЗаписатьОбъектПакета(МетаданныеОбъекта, СтрокаПакета.Объект, ДанныеОбъекта, Результат, Сообщение) Тогда
					Записано = Записано + 1;
					РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки, ИндексОбъекта), Результат);
				Иначе
					Ошибок = Ошибок + 1;
					РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки, ИндексОбъекта), Сообщение);
					ЗанестиВЖурналСобытий(ИмяСобытия, ДанныеОбъекта.Ссылка, Ложь, Сообщение);
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли МенеджерРегистра(МетаданныеОбъекта) <> Неопределено Тогда

			Сообщение = "";
			Если ЗначениеЗаполнено(СтрокаПакета.Регистратор) Тогда
				Выполнено = ЗаписатьНаборПакета(МетаданныеОбъекта, СтрокаПакета.Регистратор, СтрокаПакета.Объект, Сообщение);
			Иначе
				Выполнено = ЗаписатьЗаписиРегистраСведений(МетаданныеОбъекта, СтрокаПакета.Объект, Ложь, Сообщение);
			КонецЕсли;
			Если Выполнено Тогда
				Записано = Записано + 1;
				РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки),
					СтрШаблон(НСтр("ru = 'Записано записей: %1'; en = 'Records written: %1'"), СтрокаПакета.Объект.Количество()));
			Иначе
				Ошибок = Ошибок + 1;
				РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки), Сообщение);
				ЗанестиВЖурналСобытий(ИмяСобытия, СтрокаПакета.Регистратор, Ложь, Сообщение);
			КонецЕсли;

		Иначе

			Ошибок = Ошибок + 1;
			Сообщение = СтрШаблон(НСтр("ru = '%1: запись объектов этого вида не поддерживается'; en = '%1: writing objects of this kind is not supported'"),
				СтрокаПакета.Тип);
			РезультатыЗаписи.Вставить(КлючСтрокиПакета(ИндексСтроки), Сообщение);
			ЗанестиВЖурналСобытий(ИмяСобытия, Неопределено, Ложь, Сообщение);

		КонецЕсли;

	КонецЦикла;

	ЗанестиВЖурналСобытий(ИмяСобытия,
		Неопределено,
		Истина,
		СтрШаблон(НСтр("ru = 'Пакет записан: записано %1, ошибок %2'; en = 'Package written: %1 written, %2 errors'"), Записано, Ошибок));

	Сообщение = "";
	Возврат ВывестиОтчетПакета(ПакетОбмена, Сообщение, РезультатыЗаписи);

КонецФункции

// Удаляет из текущей базы объекты пакета, отчет которого сейчас на доске (см. ВывестиОтчетПакета), и выводит
// тот же отчет с колонкой Результат. Все - в режиме ОбменДанными.Загрузка без регистрации изменений.
// ТолькоПометка = Истина: объекты помечаются на удаление (УстановитьПометкуУдаления; документ при этом
// распроводится), наборы записей не трогаются. ТолькоПометка = Ложь: объекты удаляются непосредственно, без контроля
// ссылок на них (движения документа платформа удаляет вместе с ним), наборы записей по регистратору очищаются,
// записи независимого регистра сведений удаляются по ключу. Объектов, которых нет в базе, удаление не касается.
// Строки XML старого формата не удаляются. Ошибка строки не останавливает остальные
// (кроме флажка ОстановитьПриОшибке, см. ЗанестиВЖурналСобытий).
//
// Параметры:
//   ТолькоПометка - Булево - пометить на удаление вместо непосредственного удаления.
//   Обработано    - Число - выходной: число удаленных (помеченных) объектов и очищенных наборов.
//   Ошибок        - Число - выходной: число строк с ошибкой.
//   Сообщение     - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет обработан (в том числе с ошибками строк).
//
Функция УдалитьПакетИзБазы(ТолькоПометка, Обработано, Ошибок, Сообщение) Экспорт

	Обработано = 0;
	Ошибок = 0;

	ПакетОбмена = Неопределено;
	Если Не ПакетНаДоске(ПакетОбмена, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяСобытия = ПолучитьИмяСобытия("УдалениеПакета");
	Результаты = Новый Соответствие;
	НетВБазе = НСтр("ru = 'Нет в базе'; en = 'Not in the infobase'");
	Пропущено = НСтр("ru = 'Пропущено'; en = 'Skipped'");

	Для ИндексСтроки = 0 По ПакетОбмена.Количество() - 1 Цикл

		СтрокаПакета = ПакетОбмена[ИндексСтроки];
		Если СтрокаПакета.Тип = "НомерСообщения" Тогда
			Продолжить;
		КонецЕсли;

		МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(СтрокаПакета.Тип);
		Если МетаданныеОбъекта = Неопределено Или ТипЗнч(СтрокаПакета.Объект) <> Тип("ТаблицаЗначений") Тогда
			Результаты.Вставить(КлючСтрокиПакета(ИндексСтроки), Пропущено);
			Продолжить;
		КонецЕсли;

		Если ЭтоСсылочныйОбъект(МетаданныеОбъекта) Тогда

			Для ИндексОбъекта = 0 По СтрокаПакета.Объект.Количество() - 1 Цикл
				Ссылка = СтрокаПакета.Объект[ИндексОбъекта].Ссылка;
				Ключ = КлючСтрокиПакета(ИндексСтроки, ИндексОбъекта);
				Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
					Результаты.Вставить(Ключ, НетВБазе);
					Продолжить;
				КонецЕсли;
				Результат = "";
				Сообщение = "";
				Если УдалитьОбъектПакета(Ссылка, ТолькоПометка, Результат, Сообщение) Тогда
					Обработано = Обработано + 1;
					Результаты.Вставить(Ключ, Результат);
				Иначе
					Ошибок = Ошибок + 1;
					Результаты.Вставить(Ключ, Сообщение);
					ЗанестиВЖурналСобытий(ИмяСобытия, Ссылка, Ложь, Сообщение);
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли МенеджерРегистра(МетаданныеОбъекта) <> Неопределено И Не ТолькоПометка Тогда

			Сообщение = "";
			Если ЗначениеЗаполнено(СтрокаПакета.Регистратор) Тогда
				Выполнено = ЗаписатьНаборПакета(МетаданныеОбъекта, СтрокаПакета.Регистратор, Неопределено, Сообщение);
			Иначе
				Выполнено = ЗаписатьЗаписиРегистраСведений(МетаданныеОбъекта, СтрокаПакета.Объект, Истина, Сообщение);
			КонецЕсли;
			Если Выполнено Тогда
				Обработано = Обработано + 1;
				Результаты.Вставить(КлючСтрокиПакета(ИндексСтроки), НСтр("ru = 'Записи удалены'; en = 'Records deleted'"));
			Иначе
				Ошибок = Ошибок + 1;
				Результаты.Вставить(КлючСтрокиПакета(ИндексСтроки), Сообщение);
				ЗанестиВЖурналСобытий(ИмяСобытия, СтрокаПакета.Регистратор, Ложь, Сообщение);
			КонецЕсли;

		Иначе
			Результаты.Вставить(КлючСтрокиПакета(ИндексСтроки), Пропущено);
		КонецЕсли;

	КонецЦикла;

	ЗанестиВЖурналСобытий(ИмяСобытия,
		Неопределено,
		Истина,
		СтрШаблон(НСтр("ru = 'Пакет удален (только пометка: %1): обработано %2, ошибок %3'; en = 'Package deleted (mark only: %1): %2 processed, %3 errors'"),
			ТолькоПометка,
			Обработано,
			Ошибок));

	Сообщение = "";
	Возврат ВывестиОтчетПакета(ПакетОбмена, Сообщение, Результаты);

КонецФункции

// Помечает объект на удаление или удаляет его непосредственно в режиме загрузки.
// Результат - "Помечен на удаление" или "Удален".
Функция УдалитьОбъектПакета(Ссылка, ТолькоПометка, Результат, Сообщение)

	Попытка
		УдаляемыйОбъект = Ссылка.ПолучитьОбъект();
		УстановитьРежимЗагрузки(УдаляемыйОбъект);
		Если ТолькоПометка Тогда
			УдаляемыйОбъект.УстановитьПометкуУдаления(Истина);
			Результат = НСтр("ru = 'Помечен на удаление'; en = 'Marked for deletion'");
		Иначе
			УдаляемыйОбъект.Удалить();
			Результат = НСтр("ru = 'Удален'; en = 'Deleted'");
		КонецЕсли;
	Исключение
		Сообщение = СтрШаблон("%1 %2: %3",
			Ссылка.Метаданные().ПолноеИмя(),
			Ссылка.УникальныйИдентификатор(),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Возвращает пакет, отчет которого сейчас на доске (см. ВывестиОтчетПакета); Ложь - на доске другой отчет.
Функция ПакетНаДоске(ПакетОбмена, Сообщение)

	Пакет = ?(ЭтоАдресВременногоХранилища(АдресПакета), ПолучитьИзВременногоХранилища(АдресПакета), Неопределено);
	Если ТипЗнч(Пакет) <> Тип("Структура") Или Пакет.ДанныеРасшифровки <> ДанныеРасшифровки Тогда
		Сообщение = НСтр("ru = 'На доске нет отчета пакета: откройте пакет или выберите ""Объекты пакета""'; en = 'The board has no package report: open a package or choose ""Package objects""'");
		Возврат Ложь;
	КонецЕсли;

	ПакетОбмена = Пакет.Пакет;

	Возврат Истина;

КонецФункции

// Ключ строки отчета пакета для результатов записи: "<индекс строки пакета>/<индекс объекта>".
Функция КлючСтрокиПакета(ИндексСтроки, ИндексОбъекта = Неопределено)

	Возврат Формат(ИндексСтроки, "ЧН=0; ЧГ=0") + "/" + ?(ИндексОбъекта = Неопределено, "", Формат(ИндексОбъекта, "ЧН=0; ЧГ=0"));

КонецФункции

// Записывает объект ссылочного типа из строки данных пакета: создает с той же ссылкой или перезаписывает
// существующий. Результат - "Создан" или "Изменен".
Функция ЗаписатьОбъектПакета(МетаданныеОбъекта, Данные, ДанныеОбъекта, Результат, Сообщение)

	Попытка

		Ссылка = ДанныеОбъекта.Ссылка;
		Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			ЗаписываемыйОбъект = Ссылка.ПолучитьОбъект();
			Результат = НСтр("ru = 'Изменен'; en = 'Changed'");
		Иначе
			ЭтоГруппа = (Данные.Колонки.Найти("ЭтоГруппа") <> Неопределено И ДанныеОбъекта.ЭтоГруппа = Истина);
			ЗаписываемыйОбъект = НовыйОбъектПакета(МетаданныеОбъекта, ЭтоГруппа);
			ЗаписываемыйОбъект.УстановитьСсылкуНового(Ссылка);
			Результат = НСтр("ru = 'Создан'; en = 'Created'");
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(ЗаписываемыйОбъект, ДанныеОбъекта, СвойстваОбъектаПакета(МетаданныеОбъекта, Данные));
		Для Каждого Колонка Из Данные.Колонки Цикл
			Если ТипЗнч(ДанныеОбъекта[Колонка.Имя]) = Тип("ТаблицаЗначений") Тогда
				ЗаписываемыйОбъект[Колонка.Имя].Загрузить(ДанныеОбъекта[Колонка.Имя]);
			КонецЕсли;
		КонецЦикла;

		УстановитьРежимЗагрузки(ЗаписываемыйОбъект);
		ЗаписываемыйОбъект.Записать();

	Исключение
		Сообщение = СтрШаблон("%1 %2: %3",
			МетаданныеОбъекта.ПолноеИмя(),
			ДанныеОбъекта.Ссылка.УникальныйИдентификатор(),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Создает новый объект ссылочного типа менеджером объекта метаданных; для иерархических справочников
// и планов видов характеристик с ЭтоГруппа - группу.
Функция НовыйОбъектПакета(МетаданныеОбъекта, ЭтоГруппа)

	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеОбъекта.ПолноеИмя());

	Если Метаданные.Справочники.Содержит(МетаданныеОбъекта)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта) Тогда
		Возврат ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Возврат Менеджер.СоздатьДокумент();
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МетаданныеОбъекта) Тогда
		Возврат Менеджер.СоздатьСчет();
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МетаданныеОбъекта) Тогда
		Возврат Менеджер.СоздатьВидРасчета();
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(МетаданныеОбъекта) Тогда
		Возврат Менеджер.СоздатьУзел();
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(МетаданныеОбъекта) Тогда
		Возврат Менеджер.СоздатьБизнесПроцесс();
	ИначеЕсли Метаданные.Задачи.Содержит(МетаданныеОбъекта) Тогда
		Возврат Менеджер.СоздатьЗадачу();
	КонецЕсли;

	ВызватьИсключение СтрШаблон(НСтр("ru = 'Создание объектов %1 не поддерживается'; en = 'Creating %1 objects is not supported'"),
		МетаданныеОбъекта.ПолноеИмя());

КонецФункции

// Возвращает через запятую реквизиты и стандартные реквизиты объекта, которые есть в колонках данных пакета,
// кроме недоступных для записи (Ссылка, Предопределенный, ЭтоГруппа, ВерсияДанных, ЭтотУзел).
Функция СвойстваОбъектаПакета(МетаданныеОбъекта, Данные)

	Исключения = Новый Структура("Ссылка, Предопределенный, ЭтоГруппа, ВерсияДанных, ЭтотУзел, МоментВремени, Представление");
	Свойства = Новый Массив;
	Для Каждого Колонка Из Данные.Колонки Цикл
		Если Исключения.Свойство(Колонка.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если МетаданныеОбъекта.Реквизиты.Найти(Колонка.Имя) <> Неопределено
			Или ЕстьСтандартныйРеквизит(МетаданныеОбъекта, Колонка.Имя) Тогда
			Свойства.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Свойства, ",");

КонецФункции

Функция ЕстьСтандартныйРеквизит(МетаданныеОбъекта, Имя)

	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если Реквизит.Имя = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Перезаписывает набор записей регистра по регистратору записями из пакета; Записи = Неопределено - очищает набор.
Функция ЗаписатьНаборПакета(МетаданныеРегистра, Регистратор, Записи, Сообщение)

	Попытка
		НаборЗаписей = МенеджерРегистра(МетаданныеРегистра).СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
		Если Записи <> Неопределено Тогда
			НаборЗаписей.Загрузить(Записи);
		КонецЕсли;
		УстановитьРежимЗагрузки(НаборЗаписей);
		НаборЗаписей.Записать(Истина);
	Исключение
		Сообщение = СтрШаблон("%1 (%2): %3",
			МетаданныеРегистра.ПолноеИмя(),
			Регистратор,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Записывает записи независимого регистра сведений по одной: набор с отбором по измерениям основного отбора
// и периоду перезаписывается записью из пакета; запись с _ЭтоУдаление_ = Истина удаляется (пустой набор).
// ТолькоУдаление = Истина - все записи пакета удаляются из базы по их ключам.
Функция ЗаписатьЗаписиРегистраСведений(МетаданныеРегистра, Записи, ТолькоУдаление, Сообщение)

	Если Не Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
		Сообщение = СтрШаблон(НСтр("ru = '%1: набор записей без регистратора'; en = '%1: record set without recorder'"),
			МетаданныеРегистра.ПолноеИмя());
		Возврат Ложь;
	КонецЕсли;

	Периодический = (МетаданныеРегистра.ПериодичностьРегистраСведений
		<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
	ЕстьКолонкаУдаления = (Записи.Колонки.Найти("_ЭтоУдаление_") <> Неопределено);

	Попытка
		НаборЗаписей = МенеджерРегистра(МетаданныеРегистра).СоздатьНаборЗаписей();
		Для Каждого Запись Из Записи Цикл

			НаборЗаписей.Очистить();
			Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
				Если Измерение.ОсновнойОтбор Тогда
					НаборЗаписей.Отбор[Измерение.Имя].Установить(Запись[Измерение.Имя]);
				КонецЕсли;
			КонецЦикла;
			Если Периодический Тогда
				НаборЗаписей.Отбор.Период.Установить(Запись.Период);
			КонецЕсли;

			Если Не ТолькоУдаление И Не (ЕстьКолонкаУдаления И Запись._ЭтоУдаление_ = Истина) Тогда
				ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Запись);
			КонецЕсли;

			УстановитьРежимЗагрузки(НаборЗаписей);
			НаборЗаписей.Записать(Истина);

		КонецЦикла;
	Исключение
		Сообщение = МетаданныеРегистра.ПолноеИмя() + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Записывает объекты из строки XML старого формата (элемент root с объектами XDTO-сериализации).
Функция ЗаписатьОбъектыXML(СтрокаXML, Количество, Сообщение)

	Количество = 0;
	Если ТипЗнч(СтрокаXML) <> Тип("Строка") Тогда
		Сообщение = НСтр("ru = 'Строка XML пакета не содержит текста'; en = 'The package XML row has no text'");
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(СтрокаXML);
		ЧтениеXML.ПерейтиКСодержимому();
		Если ЧтениеXML.Имя = "root" Тогда
			ЧтениеXML.Прочитать();
		КонецЕсли;
		Пока ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
			ОбъектДанных = ПрочитатьXML(ЧтениеXML);
			Если ОбъектДанных <> Неопределено Тогда
				УстановитьРежимЗагрузки(ОбъектДанных);
				ОбъектДанных.Записать();
				Количество = Количество + 1;
			КонецЕсли;
			ЧтениеXML.ПерейтиКСодержимому();
		КонецЦикла;
		ЧтениеXML.Закрыть();
	Исключение
		Сообщение = СтрШаблон(НСтр("ru = 'XML: записано %1, затем ошибка: %2'; en = 'XML: %1 written, then error: %2'"),
			Количество,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Включает режим загрузки (без проверок и обработчиков записи) и отключает регистрацию изменений в планах обмена.
Процедура УстановитьРежимЗагрузки(Объект)

	Объект.ОбменДанными.Загрузка = Истина;
	Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов", Истина);

КонецПроцедуры

Функция НовыйПакетОбмена()

	ПакетОбмена = Новый ТаблицаЗначений;
	ПакетОбмена.Колонки.Добавить("Тип");
	ПакетОбмена.Колонки.Добавить("Объект");
	ПакетОбмена.Колонки.Добавить("Регистратор");

	Возврат ПакетОбмена;

КонецФункции

Функция ЭтоСсылочныйОбъект(МетаданныеОбъекта)

	Возврат Метаданные.Справочники.Содержит(МетаданныеОбъекта)
		Или Метаданные.Документы.Содержит(МетаданныеОбъекта)
		Или Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта)
		Или Метаданные.ПланыСчетов.Содержит(МетаданныеОбъекта)
		Или Метаданные.ПланыВидовРасчета.Содержит(МетаданныеОбъекта)
		Или Метаданные.ПланыОбмена.Содержит(МетаданныеОбъекта)
		Или Метаданные.БизнесПроцессы.Содержит(МетаданныеОбъекта)
		Или Метаданные.Задачи.Содержит(МетаданныеОбъекта);

КонецФункции

// Добавляет в пакет одну строку с данными всех объектов одного типа.
Процедура ДобавитьДанныеОбъектов(ПакетОбмена, ПолноеИмя, Ссылки)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	" + ПолноеИмя + " КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка В (&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Данные = Запрос.Выполнить().Выгрузить();
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаПакета = ПакетОбмена.Добавить();
	СтрокаПакета.Тип = ПолноеИмя;
	СтрокаПакета.Объект = Данные;

КонецПроцедуры

// Добавляет в пакет непустые наборы записей регистров, по которым документы делают движения.
Процедура ДобавитьДвиженияДокументов(ПакетОбмена, МетаданныеДокумента, Ссылки)

	Для Каждого МетаданныеРегистра Из МетаданныеДокумента.Движения Цикл

		МенеджерРегистра = МенеджерРегистра(МетаданныеРегистра);
		Если МенеджерРегистра = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПолноеИмяРегистра = МетаданныеРегистра.ПолноеИмя();
		Для Каждого Ссылка Из Ссылки Цикл

			НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;

			СтрокаПакета = ПакетОбмена.Добавить();
			СтрокаПакета.Тип = ПолноеИмяРегистра;
			СтрокаПакета.Регистратор = Ссылка;
			СтрокаПакета.Объект = НаборЗаписей.Выгрузить();

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Функция МенеджерРегистра(МетаданныеРегистра)

	Если Метаданные.РегистрыНакопления.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыНакопления[МетаданныеРегистра.Имя];
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыСведений[МетаданныеРегистра.Имя];
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыБухгалтерии[МетаданныеРегистра.Имя];
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(МетаданныеРегистра) Тогда
		Возврат РегистрыРасчета[МетаданныеРегистра.Имя];
	КонецЕсли;

	Возврат Неопределено;

