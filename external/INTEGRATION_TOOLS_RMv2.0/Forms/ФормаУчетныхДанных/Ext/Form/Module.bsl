#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = РеквизитФормыВЗначение("Объект");
	Заголовок = НСтр("ru = 'Учетные данные'; en = 'Credentials'");

	ГруппаСтраниц = Элементы.Добавить("ГруппаСтраниц", Тип("ГруппаФормы"));
	ГруппаСтраниц.Вид = ВидГруппыФормы.Страницы;

	СписокИдентификаторов = Новый Массив;
	СписокИменПолей = Новый Массив;
	Индекс = 0;

	Для Каждого КлючИЗначение Из Обработка.ОписаниеУчетныхЗаписей() Цикл

		Идентификатор = КлючИЗначение.Ключ;
		СписокИдентификаторов.Добавить(Идентификатор);

		Страница = Элементы.Добавить("Страница" + Индекс, Тип("ГруппаФормы"), ГруппаСтраниц);
		Страница.Вид = ВидГруппыФормы.Страница;
		Страница.Заголовок = Идентификатор;

		Описание = Обработка.ПрочитатьУчетныеДанные(Идентификатор, Истина);
		ЗначенияПоУмолчанию = КлючИЗначение.Значение.credentials;

		СписокИменПолей.Добавить(СоздатьПоляУчетныхДанных(Описание, ЗначенияПоУмолчанию, Страница, Индекс));

		Индекс = Индекс + 1;

	КонецЦикла;

	Идентификаторы = СтрСоединить(СписокИдентификаторов, ",");
	// Имена полей у вкладок могут различаться (разный состав credentials) -
	// список на вкладку через ";", имена внутри вкладки через ",".
	ИменаПолей = СтрСоединить(СписокИменПолей, ";");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)

	СохранитьНаСервере();
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает на вкладке поля ввода учетных данных одной учетной записи.
// Имена реквизитов формы и элементов получают префикс "П<Индекс>_", чтобы не
// пересекаться между вкладками разных учетных записей.
//
// Параметры:
//   Описание           - Структура - см. ОписаниеУчетныхДанных обработки.
//   ЗначенияПоУмолчанию - Структура - credentials из ОписаниеУчетныхДанных обработки без сохраненных значений.
//   РодительскаяСтраница - ГруппаФормы - вкладка, на которой создаются поля.
//   Индекс             - Число - порядковый номер вкладки, для префикса имен.
//
// Возвращаемое значение:
//   Строка - имена полей credentials этой вкладки через запятую.
//
&НаСервере
Функция СоздатьПоляУчетныхДанных(Описание, ЗначенияПоУмолчанию, РодительскаяСтраница, Индекс)

	ТипСтрока = Новый ОписаниеТипов("Строка");
	СекретныеКлючи = Новый Структура(Описание.secretkeys);
	Префикс = "П" + Индекс + "_";

	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого Поле Из Описание.credentials Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Префикс + Поле.Ключ, ТипСтрока, , Поле.Ключ));
	КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Имена = Новый Массив;
	Для Каждого Поле Из Описание.credentials Цикл

		ИмяРеквизита = Префикс + Поле.Ключ;

		// Подсказка ввода со значением по умолчанию видна, если поле очищено.
		ЗначениеПоУмолчанию = ЗначенияПоУмолчанию[Поле.Ключ];
		ЭтаФорма[ИмяРеквизита] = Поле.Значение;

		Элемент = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), РодительскаяСтраница);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = ИмяРеквизита;
		Если ЗначениеЗаполнено(ЗначениеПоУмолчанию) Тогда
			Элемент.ПодсказкаВвода = ЗначениеПоУмолчанию;
		КонецЕсли;

		Если СекретныеКлючи.Свойство(Поле.Ключ) Тогда
			Элемент.РежимПароля = Истина;
			Если Описание.saved[Поле.Ключ] Тогда
				Элемент.ПодсказкаВвода = НСтр("ru = 'сохранено'; en = 'saved'");
			КонецЕсли;
		КонецЕсли;

		Имена.Добавить(Поле.Ключ);

	КонецЦикла;

	Возврат СтрСоединить(Имена, ",");

КонецФункции

&НаСервере
Процедура СохранитьНаСервере()

	СписокИменПолей = СтрРазделить(ИменаПолей, ";", Ложь);
	Обработка = РеквизитФормыВЗначение("Объект");

	Индекс = 0;
	Для Каждого Идентификатор Из СтрРазделить(Идентификаторы, ",", Ложь) Цикл

		Префикс = "П" + Индекс + "_";
		Данные = Новый Структура;
		Для Каждого Имя Из СтрРазделить(СписокИменПолей[Индекс], ",", Ложь) Цикл
			Данные.Вставить(Имя, ЭтаФорма[Префикс + Имя]);
		КонецЦикла;

		Обработка.ЗаписатьУчетныеДанные(Данные, Идентификатор);

		Индекс = Индекс + 1;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти
