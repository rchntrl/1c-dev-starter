Функция ВосстановлениеUnixTimeStamp(Знач Свойство, Значение, ДополнительныеПарамтеры) Экспорт
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат ДатаИзUnixTS(Значение / 1000); // Unix TS
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ПрочитатьДатуJSON(Значение, ФорматДатыJSON.ISO); // date iso
	Иначе
		Возврат Значение;
	КонецЕсли;

