#Область Журналирование

Функция	ПолучитьИмяСобытия(ИмяКоманды = Неопределено) Экспорт

	Сегмент = Новый Массив();
	Сегмент.Добавить(СведенияОВнешнейОбработке().Наименование);
	Если ЗначениеЗаполнено(ИмяКоманды) Тогда
		Сегмент.Добавить(ИмяКоманды);
	КонецЕсли;
	
	Возврат СтрСоединить(Сегмент, ".");

КонецФункции

Процедура ЗанестиВЖурналСобытий(Событие, Идентификатор, Успех, Комментарий)
	Перем МетаданныеДляЖурнала;
	
	Уровень = ?(Успех, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	Попытка 
		МетаданныеДляЖурнала = Идентификатор.Метаданные();
	Исключение	
	КонецПопытки;

	ЗаписьЖурналаРегистрации(Событие, Уровень, МетаданныеДляЖурнала, Идентификатор, Комментарий);
	
	Если Не Успех И ОстановитьПриОшибке Тогда
		ВызватьИсключение Комментарий;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Область Визуализация

Функция НавигацияВОтчетеПоСсылке(ТабДок, АбсолютныйАдрес, ИмяМакета, ИмяОбъекта, Сообщение) Экспорт
	
	НаборТаблиц = Новый Структура(ИмяОбъекта);
	
	Если FollowRelatedLink(АбсолютныйАдрес, НаборТаблиц[ИмяОбъекта], Сообщение) Тогда
	
		ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);	
		ВывестиДанныеЧерезСКД(ИмяМакета,,, НаборТаблиц,, ТабДок, ВыходныеДанные);	
		ВыходныеДанные.Свойство("ДанныеРасшифровки", АдресВременноеХранилище);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Процедура ПрименитьВизуализацию(Действие, ДопПараметры = Неопределено) Экспорт
	Перем НаборТаблиц, Сообщение;

	// Пример динамической генерации схемы СКД по неизвестному заранее составу колонок
	// (см. ВыборкаSQL, СхемаВыборкиSQL) - для отчета с фиксированными полями объекта
	// используется обычный макет, см. ТребуетсяПодтянутьВнешниеДанные и SQL_TABLE_SIZES.
	Отказ = Ложь;
	Если ОбработатьДействиеSQL(Действие, Отказ) Тогда
		Возврат;
	КонецЕсли;

	ДатаСеансаТекущая = ТекущаяДатаСеанса();
	ПараметрыОтчета = Новый Структура("ТекДата", ДатаСеансаТекущая);
	
	ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);
	
	Если ТребуетсяПодтянутьВнешниеДанные(Действие, ПараметрыОтчета, НаборТаблиц, Сообщение) Тогда
		Если НаборТаблиц = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВывестиДанныеЧерезСКД(Действие,, ПараметрыОтчета, НаборТаблиц,, Визуализация, ВыходныеДанные);
	
	ВыходныеДанные.Свойство("ДанныеРасшифровки", ДанныеРасшифровки);
		
КонецПроцедуры

Функция ТребуетсяПодтянутьВнешниеДанные(Действие, ПараметрыОтчета, НаборТаблиц, Сообщение)

	Перем Отклик;

	Если Действие = "COMMAND1" Тогда
		Если Не ПроверитьЗаполнение() Тогда
			Сообщение = "Заполните параметры";
			Возврат Истина;
		КонецЕсли;

	ИначеЕсли Действие = "SQL_TABLE_SIZES" Тогда

		// Пример отчета по макету с заранее описанными полями объекта SQL
		// (см. ВыборкаSQL о подключении к SQL-учетной записи).
		Соединение = Неопределено;
		Если Не ПодключитьсяКSQL(Соединение, Сообщение) Тогда
			НаборТаблиц = Неопределено;
			Возврат Истина;
		КонецЕсли;

		КартаЗапросов = Новый Структура;
		ДобавитьВКартуЗапросов(КартаЗапросов, "SQL", "
			|SELECT
			|	t.name AS ИмяТаблицы,
			|	p.rows AS КоличествоСтрок,
			|	CAST((SUM(a.total_pages) * 8) / 1024.0 AS DECIMAL(18, 2)) AS ОбъемВсегоМБ,
			|	CAST((SUM(CASE WHEN i.index_id <= 1 THEN a.data_pages ELSE 0 END) * 8) / 1024.0 AS DECIMAL(18, 2)) AS ОбъемДанныхМБ,
			|	CAST((SUM(a.total_pages - CASE WHEN i.index_id <= 1 THEN a.data_pages ELSE 0 END) * 8) / 1024.0 AS DECIMAL(18, 2)) AS ОбъемИндексовМБ
			|FROM
			|	sys.tables t
			|INNER JOIN
			|	sys.indexes i ON t.object_id = i.object_id
			|INNER JOIN
			|	sys.partitions p ON i.object_id = p.object_id AND i.index_id = p.index_id
			|INNER JOIN
			|	sys.allocation_units a ON p.partition_id = a.container_id
			|WHERE
			|	t.is_ms_shipped = 0
			|GROUP BY
			|	t.name, p.rows
			|ORDER BY
			|	ОбъемВсегоМБ DESC;
			|");

		НаборТаблиц = Новый Структура;
		Если Не ВыполнитьКартуЗапросов(Соединение, КартаЗапросов, НаборТаблиц, Сообщение) Тогда
			НаборТаблиц = Неопределено;
		КонецЕсли;

		Попытка
			Соединение.Close();
		Исключение
			// Соединение закроется при уничтожении COM-объекта.
		КонецПопытки;

		Возврат Истина;

	ИначеЕсли Действие = "CBR_RATES" Тогда

		// Пример отчета по макету с заранее описанными полями, данные - из общедоступного
		// HTTP-сервиса без авторизации (см. ВыборкаHTTP).
		Таблица = Неопределено;
		Если Не ПолучитьКурсыЦБ(Таблица, Сообщение) Тогда
			НаборТаблиц = Неопределено;
			Возврат Истина;
		КонецЕсли;

		НаборТаблиц = Новый Структура("CBR", Таблица);
		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;
КонецФункции

#Область ПомощникAPI

Function wrapfor(this, ServiceName = "MyService")
	
	this = New Structure("ServiceName, URI, Headers",
		ServiceName
	);
	
	// headers
	this.headers = new Map();
	
EndFunction 

Function GetUnixTimeDecodeParams(СписокСвойств = "Date")
	
	ИменаПолейТипаДата = Новый Массив();
	ИменаПолейТипаДата = СтрРазделить(СписокСвойств, ",");
	
	UnixTimeDecodeParams = Новый Структура();
	UnixTimeDecodeParams.Вставить("ИменаСвойствДляОбработкиВосстановления", ИменаПолейТипаДата);
	UnixTimeDecodeParams.Вставить("ИмяФункцииВосстановления", "ВосстановлениеUnixTimeStamp");
	UnixTimeDecodeParams.Вставить("МодульФункцииВосстановления", ЭтотОбъект);
	
	Return UnixTimeDecodeParams;
EndFunction

Функция FollowRelatedLink(AbsoluteURL, Отклик, Сообщение)
	var this, HTTPОтвет;
	wrapfor(this);

	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Заголовки", this.headers);	
	ДопПараметры.Вставить("ПараметрыПреобразованияJSON", GetUnixTimeDecodeParams());
	
	Попытка
		Отклик = getJSONQuery(AbsoluteURL,, ДопПараметры, HTTPОтвет);
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщение = СтрШаблон("StatusCode %1", HTTPОтвет.КодСостояния);
			Возврат Ложь;
		КонецЕсли;
		Если ИнтерактивныйРежим Тогда
			JSONRequest = AbsoluteURL;
			JSONResponse = HTTPОтвет.ПолучитьТелоКакСтроку();			
		КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки(); 
		Возврат Ложь;	
	КонецПопытки;

	Возврат Истина;
КонецФункции

