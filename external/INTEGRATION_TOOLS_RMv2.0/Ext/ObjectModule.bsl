#Область HTTPЗапросы


Функция КодироватьПараметрыЗапроса(ПараметрыЗапроса) Export
	
	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЧастиПараметрыЗапроса = Новый Массив;
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		Если ТипЗнч(Параметр.Значение) = Тип("Массив") Тогда
			Значения = Параметр.Значение;
		Иначе
			Значения = Новый Массив;
			Значения.Добавить(Параметр.Значение);
		КонецЕсли;
		
		Для Каждого Значение Из Значения Цикл
			Если СтрНайти(Параметр.Ключ,"date") <> 0 И СтрНайти(Значение,"+") <> 0 И СтрНайти(Значение,":") <> 0 И СтрНайти(Значение,"T") <> 0 Тогда
				ЗначениеПараметра = КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
			Иначе
				ЗначениеПараметра = КодироватьСтроку(Значение, СпособКодированияСтроки.URLВКодировкеURL);
			КонецЕсли;	
			ЧастиПараметрыЗапроса.Добавить(СтрШаблон("%1=%2", Параметр.Ключ, ЗначениеПараметра));
		КонецЦикла;
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиПараметрыЗапроса, "&");
	
КонецФункции

Функция РазобратьURL(Знач URLСтрока)
	Результат = Новый Структура("host, port, endpoint, isSSL", "", 0, "", Ложь);
	
	// Удаляем пробелы в начале и конце
	URLСтрока = СокрЛП(URLСтрока);
	
	// Определяем протокол (isSSL)
	Если Лев(URLСтрока, 8) = "https://" Тогда
		Результат.isSSL = Истина;
		URLСтрока = Сред(URLСтрока, 9);
	ИначеЕсли Лев(URLСтрока, 7) = "http://" Тогда
		Результат.isSSL = Ложь;
		URLСтрока = Сред(URLСтрока, 8);
	Иначе
		// Если протокол не указан, считаем что http
		Результат.isSSL = Ложь;
	КонецЕсли;
	
	// Ищем первый слеш после хоста/порта
	ПозСлеша = Найти(URLСтрока, "/");
	
	// Выделяем хост и порт (часть до первого слеша)
	Если ПозСлеша > 0 Тогда
		ХостПорт = Лев(URLСтрока, ПозСлеша - 1);
		Результат.endpoint = Сред(URLСтрока, ПозСлеша + 1);
	Иначе
		ХостПорт = URLСтрока;
		Результат.endpoint = "";
	КонецЕсли;
	
	// Разбираем хост и порт
	ПозДвоеточия = Найти(ХостПорт, ":");
	
	Если ПозДвоеточия > 0 Тогда
		Результат.host = Лев(ХостПорт, ПозДвоеточия - 1);
		Результат.port = Число(Сред(ХостПорт, ПозДвоеточия + 1));
	Иначе
		Результат.host = ХостПорт;
		// Устанавливаем порт по умолчанию в зависимости от протокола
		Если Результат.isSSL Тогда
			Результат.port = 443;
		Иначе
			Результат.port = 80;
		КонецЕсли;
	КонецЕсли;
	
	// Если endpoint не начинается со слеша, добавляем его для единообразия
	Если ПустаяСтрока(Результат.endpoint) = Ложь И Лев(Результат.endpoint, 1) <> "/" Тогда
		Результат.endpoint = "/" + Результат.endpoint;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

function GetJSONQuery(absoluteURL, ДанныеЗапроса, ДопПараметры = Неопределено, HTTPОтвет = Неопределено) 

	Перем СтопкаХостов, Таймаут, ПараметрыПреобразованияJSON;
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура();
	КонецЕсли;
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Encoding",	"identity");
	Заголовки.Вставить("Content-Type",		"application/json");
	Заголовки.Вставить("Connection",		"keep-alive");
	Заголовки.Вставить("Accept",			"*/*");
	Если ДопПараметры.Свойство("Заголовки") Тогда
		for each k in ДопПараметры.Заголовки do
			Заголовки.Вставить(k.key, k.value);
		endDo;
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("Таймаут", Таймаут) Тогда
		Таймаут = 30;
	КонецЕсли;
	
	СтруктураURL = РазобратьURL(absoluteURL);

	HTTPЗапрос = Новый HTTPЗапрос(СтруктураURL.endpoint + "?" + КодироватьПараметрыЗапроса(ДанныеЗапроса), Заголовки);
	
	Если СтруктураURL.isSSL Тогда
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровОС();
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, СертификатыУЦ);
		HTTPСоединение = Новый HTTPСоединение(СтруктураURL.host, СтруктураURL.port,,,,Таймаут, ЗащищенноеСоединение);
	Иначе	
		HTTPСоединение = Новый HTTPСоединение(СтруктураURL.host, СтруктураURL.port,,,, Таймаут);
	КонецЕсли;
	
	HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
	Попытка
		Тело = HTTPОтвет.ПолучитьТелоКакПоток();
		Если ДопПараметры <> Неопределено Тогда
			ДопПараметры.Свойство("ПараметрыПреобразованияJSON", ПараметрыПреобразованияJSON);
		КонецЕсли;
		Отклик = JsonВОбъект(Тело,,ПараметрыПреобразованияJSON);
	Исключение
	КонецПопытки;
	
	Возврат Отклик;
endfunction

function postJSONQuery(absoluteURL, ДанныеЗапроса, ДопПараметры = Неопределено, HTTPОтвет = Неопределено) 

	Перем Таймаут, ПараметрыПреобразованияJSON;
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Encoding",	"identity");
	Заголовки.Вставить("Content-Type",		"application/json");
	Заголовки.Вставить("Connection",		"keep-alive");
	Заголовки.Вставить("Accept",			"*/*");
	Если ДопПараметры.Свойство("Заголовки") Тогда
		for each k in ДопПараметры.Заголовки do
			Заголовки.Вставить(k.key, k.value);
		endDo;
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("Таймаут", Таймаут) Тогда
		Таймаут = 30;
	КонецЕсли;
	
		
	JSONRequest = ОбъектВJson(ДанныеЗапроса);
	
	СтруктураURL = РазобратьURL(absoluteURL);
	HTTPЗапрос	= Новый HTTPЗапрос(СтруктураURL.endpoint, Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(JSONRequest);	
	

	Если СтруктураURL.isSSL Тогда
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровОС();
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, СертификатыУЦ);
		HTTPСоединение = Новый HTTPСоединение(СтруктураURL.host, СтруктураURL.port,,,,Таймаут, ЗащищенноеСоединение);
	Иначе	
		HTTPСоединение = Новый HTTPСоединение(СтруктураURL.host, СтруктураURL.port,,,, Таймаут);
	КонецЕсли;

	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);


	Попытка
		Тело = HTTPОтвет.ПолучитьТелоКакПоток();
		Если ДопПараметры <> Неопределено Тогда
			ДопПараметры.Свойство("ПараметрыПреобразованияJSON", ПараметрыПреобразованияJSON);
		КонецЕсли;
		Отклик = JsonВОбъект(Тело,,ПараметрыПреобразованияJSON);
	Исключение	
	КонецПопытки;
	
	Возврат Отклик;

endfunction


