#Область ВыборкаSQL

// Обёртка над ВывестиВыборкуSQL для вызова из ПрименитьВизуализацию: определяет, какой из
// готовых SQL-отчетов соответствует действию визуализации, и выполняет его.
//
// Параметры:
//   Действие - Строка - проверяемое действие визуализации.
//   Отказ    - Булево - выходной: Истина, если действие распознано, но отчет завершился
//               с ошибкой (сообщение об ошибке выводится пользователю внутри обёртки).
//
// Возвращаемое значение:
//   Булево - Истина, если Действие соответствует одному из готовых SQL-отчетов
//             (независимо от успеха выполнения - см. Отказ) и дальше его проверять не нужно;
//             Ложь - Действие можно проверять дальше другими способами.
//
Функция ОбработатьДействиеSQL(Действие, Отказ)

	Отказ = Ложь;

	Если Действие = "SQL_TEST" Тогда
		ТекстЗапроса = "EXEC sp_who2";
		ЗаголовокОтчета = НСтр("ru = 'Соединения SQL (sp_who2)'; en = 'SQL connections (sp_who2)'");
	ИначеЕсли Действие = "SQL_LOCK_TEST" Тогда
		ТекстЗапроса = "EXEC sp_lock";
		ЗаголовокОтчета = НСтр("ru = 'Блокировки SQL (sp_lock)'; en = 'SQL locks (sp_lock)'");
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Сообщение = "";
	Если Не ВывестиВыборкуSQL(ТекстЗапроса, ЗаголовокОтчета, Сообщение) Тогда
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
		Отказ = Истина;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Пример: подключается к SQL-учетной записи (см. ИдентификаторУчетныхДанныхSQL), выполняет
// гарантированно непустой запрос и выводит результат в Визуализация через СКД, схема
// которой строится динамически по колонкам результата запроса (см. СхемаВыборкиSQL) -
// в отличие от макета SQL_TABLE_SIZES с заранее описанными полями (см.
// ТребуетсяПодтянутьВнешниеДанные), здесь состав колонок не известен заранее.
// EXEC sp_who2 и EXEC sp_lock - системные процедуры SQL Server, их результат не зависит
// от схемы конкретной базы.
// Вызывается из ОбработатьДействиеSQL при выборе действий "SQL_TEST" и "SQL_LOCK_TEST".
//
// Параметры:
//   ТекстЗапроса - Строка - текст запроса или вызова хранимой процедуры.
//   Заголовок    - Строка - заголовок отчета, см. СхемаВыборкиSQL.
//   Сообщение    - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Истина, если выборка выполнена.
//
Функция ВывестиВыборкуSQL(ТекстЗапроса, Заголовок, Сообщение) Экспорт

	Соединение = Неопределено;
	Если Не ПодключитьсяКSQL(Соединение, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Таблица = Неопределено;
	Если Не ВыполнитьЗапросSQL(Соединение, ТекстЗапроса, Таблица, Сообщение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Визуализация.Очистить();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ВывестиДанныеЧерезСКД(
		СхемаВыборкиSQL(Таблица, Заголовок),
		,
		,
		Новый Структура("SQL", Таблица),
		,
		ТабличныйДокумент
	);
	Визуализация.Вывести(ТабличныйДокумент);

	Попытка
		Соединение.Close();
	Исключение
		// Соединение закроется при уничтожении COM-объекта.
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Открывает ADO-соединение с базой SQL по учетным данным (см. ОписаниеУчетныхДанных).
// Пустой username - вход под учетной записью Windows процесса сервера 1С.
Функция ПодключитьсяКSQL(Соединение, Сообщение)

	Параметры = ПрочитатьУчетныеДанные(ИдентификаторУчетныхДанныхSQL()).credentials;
	Если ПустаяСтрока(Параметры.server) Или ПустаяСтрока(Параметры.database) Тогда
		Сообщение = НСтр("ru = 'Не заполнены сервер или база в учетных данных'; en = 'Server or database is not set in credentials'");
		Возврат Ложь;
	КонецЕсли;

	ЧастиСтроки = Новый Массив;
	ЧастиСтроки.Добавить("Provider=MSOLEDBSQL");
	ЧастиСтроки.Добавить("Data Source=" + Параметры.server);
	ЧастиСтроки.Добавить("Initial Catalog=" + Параметры.database);
	Если ПустаяСтрока(Параметры.username) Тогда
		ЧастиСтроки.Добавить("Integrated Security=SSPI");
	Иначе
		ЧастиСтроки.Добавить("User ID=" + Параметры.username);
		ЧастиСтроки.Добавить("Password=" + Параметры.password);
	КонецЕсли;

	Попытка
		Соединение = Новый COMОбъект("ADODB.Connection");
		Соединение.ConnectionTimeout = 15;
		Соединение.CommandTimeout = 120;
		Соединение.Open(СтрСоединить(ЧастиСтроки, ";"));
	Исключение
		Сообщение = Параметры.server + "/" + Параметры.database + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Выполняет запрос и возвращает первый открытый набор записей таблицей значений (см. FillDataSetFromRecordSet).
Функция ВыполнитьЗапросSQL(Соединение, ТекстЗапроса, Таблица, Сообщение)

	Отказ = Ложь;
	RecordSet = GetRecordSet(Соединение, ТекстЗапроса, Отказ, Сообщение);
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		// Инструкции пакета без результата дают закрытые наборы записей.
		Пока RecordSet <> Неопределено И RecordSet.State = 0 Цикл
			RecordSet = RecordSet.NextRecordset();
		КонецЦикла;
		Если RecordSet = Неопределено Тогда
			Сообщение = НСтр("ru = 'Запрос не вернул данных'; en = 'Query returned no data'");
			Возврат Ложь;
		КонецЕсли;
		Таблица = Неопределено;
		FillDataSetFromRecordSet(RecordSet, Таблица);
		RecordSet.Close();
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Строит схему компоновки для таблицы значений на основе макета EmptySample (его оформление и структура):
// набор данных-объект SQL с полями по колонкам таблицы, все поля выбраны, заголовок отчета - Заголовок.
Функция СхемаВыборкиSQL(Таблица, Заголовок)

	Схема = ПолучитьМакет("EmptySample");

	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "SQL";
	НаборДанных.ИмяОбъекта = "SQL";
	НаборДанных.ИсточникДанных = Схема.ИсточникиДанных[0].Имя;

	Настройки = Схема.ВариантыНастроек["Основной"].Настройки;
	Для Каждого Колонка Из Таблица.Колонки Цикл

		ПолеНабора = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеНабора.Поле = Колонка.Имя;
		ПолеНабора.ПутьКДанным = Колонка.Имя;
		ПолеНабора.Заголовок = Колонка.Имя;
		ПолеНабора.ТипЗначения = Колонка.ТипЗначения;

		ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);

	КонецЦикла;

	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("Заголовок", Заголовок);

	Возврат Схема;

КонецФункции

#КонецОбласти

#Область ВыборкаHTTP

// Получает текущие курсы валют ЦБ РФ (общедоступный сервис, без авторизации) и заполняет
// Таблицу строками по валютам. Состав полей ответа фиксирован, поэтому, в отличие от
// ВыборкаSQL, результат выводится по обычному макету с заранее описанными полями
// (см. ТребуетсяПодтянутьВнешниеДанные и макет CBR_RATES).
//
// Параметры:
//   Таблица   - ТаблицаЗначений - выходной: Код, Название, Номинал, Курс, КурсПредыдущий.
//   Сообщение - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Ложь, если запрос выполнить или разобрать не удалось.
//
Функция ПолучитьКурсыЦБ(Таблица, Сообщение)

	Попытка
		HTTPОтвет = Неопределено;
		Отклик = getJSONQuery("https://www.cbr-xml-daily.ru/daily_json.js", Неопределено,, HTTPОтвет);
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Если HTTPОтвет = Неопределено Или HTTPОтвет.КодСостояния <> 200 Тогда
		Сообщение = СтрШаблон("StatusCode %1", ?(HTTPОтвет <> Неопределено, HTTPОтвет.КодСостояния, "?"));
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Отклик) <> Тип("Соответствие") Тогда
		Сообщение = НСтр("ru = 'Не удалось разобрать ответ сервиса курсов ЦБ'; en = 'Could not parse CBR rates response'");
		Возврат Ложь;
	КонецЕсли;

	Валюты = Отклик.Получить("Valute");
	Если Валюты = Неопределено Тогда
		Сообщение = НСтр("ru = 'В ответе сервиса курсов ЦБ нет Valute'; en = 'CBR rates response has no Valute'");
		Возврат Ложь;
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Название", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Номинал", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Курс", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("КурсПредыдущий", Новый ОписаниеТипов("Число"));

	Для Каждого КлючИЗначение Из Валюты Цикл

		Валюта = КлючИЗначение.Значение;
		СтрокаТЧ = Таблица.Добавить();
		СтрокаТЧ.Код = Валюта.Получить("CharCode");
		СтрокаТЧ.Название = Валюта.Получить("Name");
		СтрокаТЧ.Номинал = Валюта.Получить("Nominal");
		СтрокаТЧ.Курс = Валюта.Получить("Value");
		СтрокаТЧ.КурсПредыдущий = Валюта.Получить("Previous");

	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СКД_ФормированиеДанныхИВизуализация

#Область СКД


 //Получает структуру полей для заполнения
 //Если задать @ИмяОбъекта "КонтактнаяИнформация", он находит @Колонки с таким же префиксом.
 //Например для таких полей как
 //КонтактнаяИнформацияАдрес, КонтактнаяИнформацияТелефон и КонтактнаяИнформацияЭлектроннаяПочта
 //Схема будет иметь вид
 //{ 
 //   	Адрес: "КонтактнаяИнформацияАдрес",
 //		Телефон: "КонтактнаяИнформацияТелефон",
 //   	ЭлектроннаяПочта: "КонтактнаяИнформацияЭлектроннаяПочта"
 //}
Функция СоздатьСхемуЗаполненияОбъекта(ИмяОбъекта, Колонки)
	СхемуЗаполнения = Новый Структура();

	Для Каждого Поле Из Колонки Цикл
		Если СтрНайти(Поле.Имя, ИмяОбъекта) > 0 Тогда
			ИмяСвойства = СтрЗаменить(Поле.Имя, ИмяОбъекта, "");
			
			Если ИмяСвойства = "" Тогда Продолжить КонецЕсли;
			
			СхемуЗаполнения.Вставить(ИмяСвойства, Поле.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СхемуЗаполнения;
КонецФункции

// @Схема - Структура
// @СтрокаТаблицы - Строка таблицы значений или дерева значений
Функция ЗаполнитьПоляОбъектаПоСхеме(Схема, СтрокаТаблицы, ПропускатьПустые = Истина) Экспорт
	
	ДанныеОбъекта = Новый Структура();
	
	Для Каждого КлючИЗначение Из Схема Цикл

		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
			ЗначениеПоля = ЗаполнитьПоляОбъектаПоСхеме(КлючИЗначение.Значение, СтрокаТаблицы, ПропускатьПустые);
		ИначеЕсли ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			ЗначениеПоля = Новый Массив();
			Если ТипЗнч(СтрокаТаблицы) = Тип("СтрокаДереваЗначений") Тогда
				Для Каждого ПодСтрокаТаблицы Из СтрокаТаблицы.Строки Цикл
					ЭлементСписка = ЗаполнитьПоляОбъектаПоСхеме(КлючИЗначение.Значение[0], ПодСтрокаТаблицы, ПропускатьПустые);
					ЗначениеПоля.Добавить(ЭлементСписка);
				КонецЦикла;
			ИначеЕсли ТипЗнч(СтрокаТаблицы) = Тип("КоллекцияСтрокДереваЗначений") Тогда
				Для Каждого ПодСтрокаТаблицы Из СтрокаТаблицы Цикл
					ЭлементСписка = ЗаполнитьПоляОбъектаПоСхеме(КлючИЗначение.Значение[0], ПодСтрокаТаблицы, ПропускатьПустые);
					ЗначениеПоля.Добавить(ЭлементСписка);
				КонецЦикла;
			EndIf;
		Иначе
			ЗначениеПоля = СтрокаТаблицы[КлючИЗначение.Значение];
		EndIf;

		Если Не ПропускатьПустые Или ЗначениеЗаполнено(ЗначениеПоля) Тогда
			ДанныеОбъекта.Вставить(КлючИЗначение.Ключ, ЗначениеПоля);
		КонецЕсли;

	КонецЦикла;
	
	Возврат ДанныеОбъекта;
КонецФункции

// Заменяет в схеме заполнения вложенные схемы-коллекции массивом из одной схемы строки,
// чтобы ЗаполнитьПоляОбъектаПоСхеме заполнила их подчинёнными строками дерева.
//
// Параметры:
//   Схема          - Структура - схема заполнения, изменяется на месте.
//   ИменаКоллекций - Строка - имена ключей-коллекций через запятую, без учёта регистра.
//
Процедура РаспознатьКоллекциюВСхеме(Схема, ИменаКоллекций = "rows,items")

	Имена = Новый Соответствие;
	Для Каждого Имя Из СтрРазделить(ИменаКоллекций, ",", Ложь) Цикл
		Имена.Вставить(НРег(СокрЛП(Имя)), Истина);
	КонецЦикла;

	Если Имена.Количество() > 0 Тогда
		ЗаменитьКоллекцииВСхеме(Схема, Имена);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаменитьКоллекцииВСхеме(Схема, Имена)

	КлючиКоллекций = Новый Массив;

	Для Каждого КлючИЗначение Из Схема Цикл

		Значение = КлючИЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			ЗаменитьКоллекцииВСхеме(Значение, Имена);
			Если Имена[НРег(КлючИЗначение.Ключ)] <> Неопределено Тогда
				КлючиКоллекций.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
			// Коллекция уже распознана: обходим только схемы её строк.
			Для Каждого СхемаСтроки Из Значение Цикл
				Если ТипЗнч(СхемаСтроки) = Тип("Структура") Тогда
					ЗаменитьКоллекцииВСхеме(СхемаСтроки, Имена);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Ключ Из КлючиКоллекций Цикл
		Схема.Вставить(Ключ, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Схема[Ключ]));
	КонецЦикла;

КонецПроцедуры

//
Процедура РаспознатьСхемуЗаполнения(СхемыЗаполнения, ВыбранныеПоляОтчета)
	
	Для Каждого ПолеОтчета Из ВыбранныеПоляОтчета Цикл
		Если Тип("ВыбранноеПолеКомпоновкиДанных") = ТипЗнч(ПолеОтчета) Тогда
			ПутьКДанным = Строка(ПолеОтчета.Поле);
			Сегменты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКДанным, ".");
			Если Сегменты.Количество() > 1 Тогда
				РазложитьСегментыВСхему(СхемыЗаполнения, Сегменты, Сегменты.Получить(0));
			КонецЕсли;
		Иначе
			РаспознатьСхемуЗаполнения(СхемыЗаполнения, ПолеОтчета.Элементы);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция РазложитьСегментыВСхему(СхемыЗаполнения, Сегменты, ИмяСхемы, Путь = "")
	
	Перем Схема;

	Если ПустаяСтрока(Путь) Тогда
		Путь = СтрСоединить(Сегменты, "");
	КонецЕсли;
	
	Сегменты.Удалить(0);
	Если Сегменты.Количество() = 0 Тогда
		Возврат Путь;
	КонецЕсли;
	

	Ключ = Сегменты.Получить(0);
	
	Если СхемыЗаполнения.Свойство(ИмяСхемы, Схема) Тогда	
		Если ТипЗнч(Схема) = Тип("Строка") Тогда
			Схема = Новый Структура();
		КонецЕсли;
		Если Не Схема.Свойство(Ключ) Тогда
			Схема.Вставить(Ключ, Путь);
		КонецЕсли;
	Иначе
		Схема = Новый Структура(Ключ, Путь);
		СхемыЗаполнения.Вставить(ИмяСхемы, Схема);
	КонецЕсли;

	Схема[Ключ] = РазложитьСегментыВСхему(Схема, Сегменты, Ключ, Путь);	
	
	Возврат Схема;

		
КонецФункции	

	

//@Данные - Массив|Соответствие
//@ВнешниеНаборыДанных - Структура
//@ИмяОбъекта - Строка
//@ИмяОбъектаСКД - Строка
//@ВнешнийКлюч - Строка
Процедура РекурсивноеЗаполнениеОбъектовНабораДанных(Данные, ВнешниеНаборыДанных, ИмяОбъектаСКД = "", ЗначениеВнешнегоКлюча = Неопределено)
	
	Перем ИсточникДанных;
	Если Не ПустаяСтрока(ИмяОбъектаСКД) Тогда
		ВнешниеНаборыДанных.Свойство(ИмяОбъектаСКД, ИсточникДанных);
	КонецЕсли;
	
	Если ИсточникДанных = Неопределено Или Данные = Неопределено Тогда
		Если ТипЗнч(Данные) = Тип("Соответствие") Или ТипЗнч(Данные) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из Данные Цикл
				РекурсивноеЗаполнениеОбъектовНабораДанных(КлючИЗначение.Значение, ВнешниеНаборыДанных, КлючИЗначение.Ключ);
			КонецЦикла;
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Соответствие") Или ТипЗнч(Данные) = Тип("Структура") Тогда
		
		НоваяСтрока = ИсточникДанных.Добавить(); // @НоваяСтрока
		НоваяСтрока.КлючСвязиОбъекта = Новый УникальныйИдентификатор();
		Если ЗначениеЗаполнено(ЗначениеВнешнегоКлюча) Тогда
			Попытка
				НоваяСтрока.ВнешнийКлючСвязи = ЗначениеВнешнегоКлюча;
			Исключение
			КонецПопытки;
		КонецЕсли;

		Для Каждого КлючИЗначение Из Данные Цикл

			Если ИсточникДанных.Колонки.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
				РекурсивноеЗаполнениеОбъектовНабораДанных(КлючИЗначение.Значение, ВнешниеНаборыДанных, КлючИЗначение.Ключ, НоваяСтрока.КлючСвязиОбъекта);
			Иначе
				// База
				ОбнаруженаТаблица = ВстроитьЗначениеВОсновнуюСтроку(КлючИЗначение.Значение, НоваяСтрока, КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;

	Иначе
		МассивРезультатов = Данные;

		Для Каждого ЭлементМассива Из МассивРезультатов Цикл
			НоваяСтрока = ИсточникДанных.Добавить(); // @НоваяСтрока
			НоваяСтрока.КлючСвязиОбъекта = Новый УникальныйИдентификатор();
			Если ЗначениеЗаполнено(ЗначениеВнешнегоКлюча) Тогда
				Попытка
					НоваяСтрока.ВнешнийКлючСвязи = ЗначениеВнешнегоКлюча;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			Если Тип(ЭлементМассива) = Тип("КлючИЗначение") Тогда
				
				ВстроитьЗначениеВОсновнуюСтроку(ЭлементМассива.Значение, НоваяСтрока, ЭлементМассива.Ключ);
				Попытка 
					НоваяСтрока.ИмяОбъекта = ЭлементМассива.Ключ;
				Исключение
				КонецПопытки;
				Продолжить;
			КонецЕсли;
			
			Для Каждого КлючИЗначение Из ЭлементМассива Цикл

				Если ИсточникДанных.Колонки.Найти(КлючИЗначение.Ключ) = Неопределено Тогда

					РекурсивноеЗаполнениеОбъектовНабораДанных(КлючИЗначение.Значение, ВнешниеНаборыДанных, КлючИЗначение.Ключ, НоваяСтрока.КлючСвязиОбъекта);

				Иначе
					// База
					ОбнаруженыТаблицы = Новый Массив();
					Если ВстроитьЗначениеВОсновнуюСтроку(КлючИЗначение.Значение, НоваяСтрока, КлючИЗначение.Ключ, ОбнаруженыТаблицы) Тогда
						Для Каждого ПТ Из ОбнаруженыТаблицы Цикл
							РекурсивноеЗаполнениеОбъектовНабораДанных(ПТ.Данные, ВнешниеНаборыДанных, ПТ.ИмяОбъектаДанных, НоваяСтрока.КлючСвязиОбъекта);
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	

	КонецЕсли;

	
КонецПроцедуры

// @Данные - Соответствие
// @НоваяСтрока - СтрокаТаблицыЗначений|СтрокаДереваЗначений
// @ПутьКДанным - Имя поля объекта
Функция ВстроитьЗначениеВОсновнуюСтроку(Данные, НоваяСтрока, РодительскоеИмя = "", ВыходныеДанные = Неопределено)

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Данные Цикл

			Если ТипЗнч(КлючИЗначение.Значение) = Тип("Соответствие") Тогда
				ВстроитьЗначениеВОсновнуюСтроку(КлючИЗначение.Значение, НоваяСтрока, РодительскоеИмя + КлючИЗначение.Ключ, ВыходныеДанные);
			ИначеЕсли ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
				ВозвращаемоеЗначение = Новый Структура("Данные,ИмяОбъектаДанных", КлючИЗначение.Значение, РодительскоеИмя + КлючИЗначение.Ключ);
				Если ВыходныеДанные <> Неопределено Тогда
					ВыходныеДанные.Добавить(ВозвращаемоеЗначение);
				КонецЕсли;
			Иначе
				Попытка
					НоваяСтрока[РодительскоеИмя + КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				Исключение
					ОбщегоНазначения.СообщитьПользователю(РодительскоеИмя + КлючИЗначение.Ключ);
				КонецПопытки;
			КонецЕсли;

		КонецЦикла;

	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		Значение = "";
		Для Каждого Элемент Из Данные Цикл
			Значение = Значение + XMLString(Элемент) + ";";
		КонецЦикла;
		НоваяСтрока[РодительскоеИмя] = Значение;
	Иначе
		НоваяСтрока[РодительскоеИмя] = Данные;
	КонецЕсли;
;
	Если ВыходныеДанные <> Неопределено Тогда
		Возврат ВыходныеДанные.Количество() > 0;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Получает данные сформированные посредством СКД, где хранится мэпинг принимаемых полей
// @ ИмяМакета - СхемаКомпоновкиДанных
// @ ИмяВариантаОтчета - Имя варианта отчета
// @ПараметрыОтчета - Параметры для управления формируемыми данными
// @НаборТаблиц -  Внешние данные
// @Результат - ДеревоЗначений/ТаблицаЗначений - Если пусто, то не формирует данные в объект
// @ТабличныйДокумент - Если пусто, то не формирует отчет
// @ВыходныеДанные - Возможные ключи: ДанныеРасшифровки, СхемыЗаполнения, ВнешниеНаборыДанных
Function ВывестиДанныеЧерезСКД(ИмяМакета, ИмяВариантаОтчета = "Основной", ПараметрыОтчета = Неопределено, НаборТаблиц, Результат = Неопределено, ТабличныйДокумент = Неопределено, ВыходныеДанные = Неопределено) Экспорт
	
	Если ТипЗнч(ИмяМакета) = Тип("Строка") Тогда
		МакетСКД = ПолучитьМакет(ИмяМакета); // @ИмяМакета
	ИначеЕсли ТипЗнч(ИмяМакета) = Тип("СхемаКомпоновкиДанных") Тогда
		МакетСКД = ИмяМакета;
	Иначе
		ВызватьИсключение "Параметр 1 неверного типа"
	EndIf;

	Настройки = МакетСКД.ВариантыНастроек[ИмяВариантаОтчета].Настройки; // @ИмяВариантаОтчета

	Если ТипЗнч(ПараметрыОтчета) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ПараметрыОтчета Цикл

			Попытка
				Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(
					Новый ПараметрКомпоновкиДанных(КлючИЗначение.Ключ),
					КлючИЗначение.Значение
				);
			Исключение
			КонецПопытки;
			
		КонецЦикла;
	КонецЕсли;
	
	 
	Если ВыходныеДанные = Неопределено Тогда
		ВыходныеДанные = Новый Структура();
	КонецЕсли;

	Если ВыходныеДанные.Свойство("СхемыЗаполнения") Тогда
		СхемыЗаполнения = Новый Структура();
		РаспознатьСхемуЗаполнения(СхемыЗаполнения, Настройки.Выбор.Элементы);
		ВыходныеДанные.Вставить("СхемыЗаполнения", СхемыЗаполнения);
	КонецЕсли;

	ВнешниеНаборыДанных = Новый Структура();

	Для Каждого Набор ИЗ МакетСКД.НаборыДанных Цикл
		
		Если ТипЗнч(Набор) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		
		// Получаем структуру полей из набора данных СКД
		ПоляОтчета = Набор.Поля;
		ВнешнийНабор = Новый ТаблицаЗначений();
		Для Каждого ОписаниеПоля Из ПоляОтчета Цикл
			ВнешнийНабор.Колонки.Добавить(ОписаниеПоля.Поле, ОписаниеПоля.ТипЗначения, ОписаниеПоля.Заголовок);
		КонецЦикла;
		
		ВнешниеНаборыДанных.Вставить(Набор.ИмяОбъекта, ВнешнийНабор);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ВнешниеНаборыДанных Цикл
		Таблица = Неопределено;
		Если НаборТаблиц.Свойство(КлючИЗначение.Ключ, Таблица) Тогда
			Если ТипЗнч(Таблица) = Тип("Соответствие") Или ТипЗнч(Таблица) = Тип("Массив") Тогда
				РекурсивноеЗаполнениеОбъектовНабораДанных(Таблица, ВнешниеНаборыДанных, КлючИЗначение.Ключ);
			ИначеЕсли ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
				Для Каждого СтрокаТаблицы Из Таблица Цикл
					ЗаполнитьЗначенияСвойств(КлючИЗначение.Значение.Добавить(), СтрокаТаблицы);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ВыходныеДанные.Свойство("ВнешниеНаборыДанных") Тогда
		ВыходныеДанные.Вставить("ВнешниеНаборыДанных", ВнешниеНаборыДанных);
	КонецЕсли;

	// формируем отчет с помощью СКД
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	
	Если Результат <> Неопределено Тогда
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(
			МакетСКД,
			Настройки,
			,
			,
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")
		);
	
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(Результат);
		ПроцессорВывода.Вывести(ПроцессорКомпоновки);
		
	КонецЕсли;

	Если ТабличныйДокумент <> Неопределено Тогда // @ТабличныйДокумент
		ДанныеРасшифровкиКомпоновки = Новый ДанныеРасшифровкиКомпоновкиДанных();
		
		МакетКомпоновкиОтчета = КомпоновщикМакета.Выполнить(МакетСКД, Настройки, ДанныеРасшифровкиКомпоновки);
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновкиОтчета, ВнешниеНаборыДанных, ДанныеРасшифровкиКомпоновки, Истина);
		ПроцессорВыводаОтчета = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент();
		ТабличныйДокумент.Очистить();
		ПроцессорВыводаОтчета.УстановитьДокумент(ТабличныйДокумент);
		ПроцессорВыводаОтчета.Вывести(ПроцессорКомпоновки, Истина);

		Если ВыходныеДанные.Свойство("ДанныеРасшифровки") Тогда
			ДанныеРасшифровкиКД = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиКомпоновки, ВыходныеДанные.ДанныеРасшифровки);
			ВыходныеДанные.Вставить("ДанныеРасшифровки", ДанныеРасшифровкиКД);
		КонецЕсли;
	КонецЕсли;

	Return Истина;
	
EndFunction

#КонецОбласти


#Область СопоставлениеДанныхSQL


Функция GetRecordSet(Соединение, Знач ТекстЗапроса, Отказ = Ложь, Сообщение = "")
	Var RecordSet;

	Попытка
		RecordSet = Новый ComObject("ADODB.RecordSet");
		RecordSet.ActiveConnection = Соединение;
		RecordSet.CursorType	= 3; // A static cursor allowing forward and backward scrolling of a fixed, unchangeable set of records
		RecordSet.LockType		= 1; // Read-only data
		RecordSet.Open(ТекстЗапроса);
		Возврат RecordSet;
	Исключение
		RecordSet = Неопределено;
		Отказ = Истина;
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат RecordSet;
КонецФункции

Функция ОписаниеТипаПоADO(Поле)

	ТипADO = Поле.Type;

	МассивТипов = Новый Массив;
	КвалификаторыЧисла = Неопределено;
	КвалификаторыСтроки = Неопределено;
	КвалификаторыДаты = Неопределено;

	// Целые
	Если ТипADO = 2 Или ТипADO = 3 Или ТипADO = 16 Или ТипADO = 17 Или ТипADO = 20 Тогда
		МассивТипов.Добавить(Тип("Число"));
		КвалификаторыЧисла = Новый КвалификаторыЧисла(18, 0);

	// Вещественные, decimal, numeric, money
	ИначеЕсли ТипADO = 4 Или ТипADO = 5 Или ТипADO = 6 Или ТипADO = 14 Или ТипADO = 131 Тогда
		МассивТипов.Добавить(Тип("Число"));
		КвалификаторыЧисла = Новый КвалификаторыЧисла(28, 8);

	// Дата / время
	ИначеЕсли ТипADO = 7 Или ТипADO = 133 Или ТипADO = 134 Или ТипADO = 135 Тогда
		МассивТипов.Добавить(Тип("Дата"));
		КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);

	// Булево
	ИначеЕсли ТипADO = 11 Тогда
		МассивТипов.Добавить(Тип("Булево"));

	// Строки: char, varchar, wchar, varwchar, bstr, GUID
	ИначеЕсли ТипADO = 8 Или ТипADO = 72 Или ТипADO = 129 Или ТипADO = 130
		Или ТипADO = 200 Или ТипADO = 202 Тогда
		МассивТипов.Добавить(Тип("Строка"));
		КвалификаторыСтроки = Новый КвалификаторыСтроки(?(Поле.DefinedSize > 0, Поле.DefinedSize, 0));

	// Длинные строки (text/ntext)
	ИначеЕсли ТипADO = 201 Или ТипADO = 203 Тогда
		МассивТипов.Добавить(Тип("Строка"));

	// Бинарные и всё остальное: пустое описание не ограничивает тип,
	// Null в него уже входит
	Иначе
		Возврат Новый ОписаниеТипов;
	КонецЕсли;

	// Значение NULL из базы
	МассивТипов.Добавить(Тип("Null"));

	Возврат Новый ОписаниеТипов(МассивТипов, КвалификаторыЧисла, КвалификаторыСтроки, КвалификаторыДаты);

КонецФункции

// Заполняет НаборДанных из RecordSet; если НаборДанных не задан, колонки создаются по полям RecordSet.
// Двоичные значения записываются строкой 0x..., даты уменьшаются на СмещениеЛет лет.
Процедура FillDataSetFromRecordSet(RecordSet, НаборДанных, СмещениеЛет = 0)

	Если RecordSet = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Индексы полей ADO для колонок НаборДанных; Неопределено - соответствие по номеру
	// (НаборДанных передан готовым, его колонки не из RecordSet.Fields).
	ИндексыПолей = Неопределено;

	Если НаборДанных = Неопределено Тогда

		НаборДанных = Новый ТаблицаЗначений();
		ИндексыПолей = Новый Массив;
		Индекс = 0;
		Для Каждого Поле Из RecordSet.Fields Цикл
			Попытка
				// Имя поля ADO может быть недопустимым или повторяться (например,
				// поле "SPID" дважды в результате "sp_who2") - такое поле пропускаем.
				НаборДанных.Колонки.Добавить(Поле.Name, ОписаниеТипаПоADO(Поле));
				ИндексыПолей.Добавить(Индекс);
			Исключение
			КонецПопытки;
			Индекс = Индекс + 1;
		КонецЦикла;

	КонецЕсли;

	Колонки = НаборДанных.Колонки;

	Пока НЕ RecordSet.EOF Цикл

		// Новая строка табличной части
		СтрокаТЧ = НаборДанных.Добавить();

		Для Индекс = 0 По Колонки.Количество() - 1 Цикл

			Колонка = Колонки[Индекс];
			Если ИндексыПолей = Неопределено Тогда
				ИндексПоля = Индекс;
			Иначе
				ИндексПоля = ИндексыПолей[Индекс];
			КонецЕсли;

			Попытка
				Значение = RecordSet.Fields(ИндексПоля).Value;
				Если ТипЗнч(Значение) = Тип("COMSafeArray") Тогда
					Значение = ДвоичноеЗначениеSQL(Значение);
				ИначеЕсли ТипЗнч(Значение) = Тип("Дата") И СмещениеЛет <> 0 Тогда
					Значение = ДобавитьМесяц(Значение, -12 * СмещениеЛет);
				КонецЕсли;
				СтрокаТЧ[Колонка.Имя] = Значение;
			Исключение

			КонецПопытки;

		КонецЦикла;

		RecordSet.MoveNext();

	КонецЦикла;

КонецПроцедуры

// Возвращает двоичное значение ADO (COMSafeArray байтов) строкой 0x... как в MS SQL.
Функция ДвоичноеЗначениеSQL(МассивБайтов)

	Байты = МассивБайтов.Выгрузить();
	Буфер = Новый БуферДвоичныхДанных(Байты.Количество());
	Для Индекс = 0 По Байты.ВГраница() Цикл
		Буфер.Установить(Индекс, Байты[Индекс]);
	КонецЦикла;

	Возврат "0x" + ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буфер);

КонецФункции

Процедура ДобавитьВКартуЗапросов(Карта, ИмяОбъекта, ТекстЗапроса, П1 = Неопределено, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено) Экспорт

	ПереданныеПараметры = Новый Массив();
	ПереданныеПараметры.Добавить(П1);
	ПереданныеПараметры.Добавить(П2);
	ПереданныеПараметры.Добавить(П3);
	ПереданныеПараметры.Добавить(П4);

	ПараметрыЗапроса = Новый Массив();
	Для Каждого Параметр Из ПереданныеПараметры Цикл
		Если ЗначениеЗаполнено(Параметр) Тогда
			ПараметрыЗапроса.Добавить(Параметр);
		КонецЕсли;
	КонецЦикла;

	Для Индекс = 0 По ПараметрыЗапроса.ВГраница() Цикл
		Если ТипЗнч(ПараметрыЗапроса[Индекс]) = Тип("Массив") Тогда
			ПараметрыЗапроса[Индекс] = СтрСоединить(ПараметрыЗапроса[Индекс], ", ");
		КонецЕсли;
	КонецЦикла;

	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтрокуИзМассива(ТекстЗапроса, ПараметрыЗапроса);
	Карта.Вставить(ИмяОбъекта, ТекстЗапроса);

КонецПроцедуры

// Выполняет каждый запрос КартыЗапросов (см. ДобавитьВКартуЗапросов) и заполняет
// соответствующий набор в ВнешниеНаборыДанных (см. FillDataSetFromRecordSet).
//
// Параметры:
//   Connection         - COMObject - открытое ADO-соединение (см. ПодключитьсяКSQL).
//   КартаЗапросов      - Соответствие - ключ - имя объекта СКД, значение - текст запроса.
//   ВнешниеНаборыДанных - Структура - заполняемые наборы, ключи совпадают с КартаЗапросов.
//   Сообщение          - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Ложь, если хотя бы один запрос выполнить не удалось.
//
Функция ВыполнитьКартуЗапросов(Connection, КартаЗапросов, ВнешниеНаборыДанных, Сообщение) Экспорт

	Если Connection = Неопределено Тогда
		Сообщение = НСтр("ru = 'Нет соединения с внешней базой'; en = 'No connection to the external database'");
		Возврат Ложь;
	КонецЕсли;

	Для Каждого КлючИЗначение Из КартаЗапросов Цикл

		Отказ = Ложь;
		RecordSet = GetRecordSet(Connection, КлючИЗначение.Значение, Отказ, Сообщение);
		Если Отказ Тогда
			Сообщение = КлючИЗначение.Ключ + Символы.ПС + Сообщение;
			Возврат Ложь;
		КонецЕсли;

		Если Не ВнешниеНаборыДанных.Свойство(КлючИЗначение.Ключ) Тогда
			ВнешниеНаборыДанных.Вставить(КлючИЗначение.Ключ, Неопределено);
		КонецЕсли;

		Попытка
			FillDataSetFromRecordSet(RecordSet, ВнешниеНаборыДанных[КлючИЗначение.Ключ]);
			RecordSet.Close();
		Исключение
			Сообщение = КлючИЗначение.Ключ + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Возврат Ложь;
		КонецПопытки;

	КонецЦикла;

	Возврат Истина;

КонецФункции


