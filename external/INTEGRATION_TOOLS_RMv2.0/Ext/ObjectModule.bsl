	Иначе	
		HTTPСоединение = Новый HTTPСоединение(СтруктураURL.host, СтруктураURL.port,,,, Таймаут);
	КонецЕсли;

	HTTPОтвет = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);


	Попытка
		Тело = HTTPОтвет.ПолучитьТелоКакПоток();
		Если ДопПараметры <> Неопределено Тогда
			ДопПараметры.Свойство("ПараметрыПреобразованияJSON", ПараметрыПреобразованияJSON);
		КонецЕсли;
		Отклик = JsonВОбъект(Тело,,ПараметрыПреобразованияJSON);
	Исключение	
	КонецПопытки;
	
	Возврат Отклик;

endfunction


