Функция GetRecordSet(Соединение, Знач ТекстЗапроса, Отказ = Ложь, Сообщение = "")
	Var RecordSet;

	Попытка
		RecordSet = Новый ComObject("ADODB.RecordSet");
		RecordSet.ActiveConnection = Соединение;
		RecordSet.CursorType	= 3; // A static cursor allowing forward and backward scrolling of a fixed, unchangeable set of records
		RecordSet.LockType		= 1; // Read-only data
		RecordSet.Open(ТекстЗапроса);
		Возврат RecordSet;
	Исключение
		RecordSet = Неопределено;
		Отказ = Истина;
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат RecordSet;
КонецФункции

Функция ОписаниеТипаПоADO(Поле)

	ТипADO = Поле.Type;

	МассивТипов = Новый Массив;
	КвалификаторыЧисла = Неопределено;
	КвалификаторыСтроки = Неопределено;
	КвалификаторыДаты = Неопределено;

	// Целые
	Если ТипADO = 2 Или ТипADO = 3 Или ТипADO = 16 Или ТипADO = 17 Или ТипADO = 20 Тогда
		МассивТипов.Добавить(Тип("Число"));
		КвалификаторыЧисла = Новый КвалификаторыЧисла(18, 0);

	// Вещественные, decimal, numeric, money
	ИначеЕсли ТипADO = 4 Или ТипADO = 5 Или ТипADO = 6 Или ТипADO = 14 Или ТипADO = 131 Тогда
		МассивТипов.Добавить(Тип("Число"));
		КвалификаторыЧисла = Новый КвалификаторыЧисла(28, 8);

	// Дата / время
	ИначеЕсли ТипADO = 7 Или ТипADO = 133 Или ТипADO = 134 Или ТипADO = 135 Тогда
		МассивТипов.Добавить(Тип("Дата"));
		КвалификаторыДаты = Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя);

	// Булево
	ИначеЕсли ТипADO = 11 Тогда
		МассивТипов.Добавить(Тип("Булево"));

	// Строки: char, varchar, wchar, varwchar, bstr, GUID
	ИначеЕсли ТипADO = 8 Или ТипADO = 72 Или ТипADO = 129 Или ТипADO = 130
		Или ТипADO = 200 Или ТипADO = 202 Тогда
		МассивТипов.Добавить(Тип("Строка"));
		КвалификаторыСтроки = Новый КвалификаторыСтроки(?(Поле.DefinedSize > 0, Поле.DefinedSize, 0));

	// Длинные строки (text/ntext)
	ИначеЕсли ТипADO = 201 Или ТипADO = 203 Тогда
		МассивТипов.Добавить(Тип("Строка"));

	// Бинарные и всё остальное: пустое описание не ограничивает тип,
	// Null в него уже входит
	Иначе
		Возврат Новый ОписаниеТипов;
	КонецЕсли;

	// Значение NULL из базы
	МассивТипов.Добавить(Тип("Null"));

	Возврат Новый ОписаниеТипов(МассивТипов, КвалификаторыЧисла, КвалификаторыСтроки, КвалификаторыДаты);

КонецФункции

Процедура FillDataSetFromRecordSet(RecordSet, НаборДанных)

	Если RecordSet = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НаборДанных = Неопределено Тогда
		
		НаборДанных = Новый ТаблицаЗначений();
		Для Каждого Поле Из RecordSet.Fields Цикл
			НаборДанных.Колонки.Добавить(Поле.Name, ОписаниеТипаПоADO(Поле));
		КонецЦикла;
		
	КонецЕсли;
	
	Колонки = НаборДанных.Колонки;
	
	Пока НЕ RecordSet.EOF Цикл
		
		// Новая строка табличной части
		СтрокаТЧ = НаборДанных.Добавить();

		Для Каждого К из Колонки Цикл
			
			Попытка
				СтрокаТЧ[К.Имя] = RecordSet.Fields(К.Имя).Value;
			Исключение

			КонецПопытки;

		КонецЦикла;

		RecordSet.MoveNext();

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВКартуЗапросов(Карта, ИмяОбъекта, ТекстЗапроса, П1 = Неопределено, П2 = Неопределено, П3 = Неопределено, П4 = Неопределено) Экспорт
	
	ПараметрыЗапроса = Новый Массив();
	Для Ё = 1 По 4 Цикл
		
		Выполнить("
		|Если ЗначениеЗаполнено(П" + Ё + ") Тогда
		|	ПараметрыЗапроса.Добавить(П" + Ё + ");
		|КонецЕсли;");
	
	КонецЦикла;
	
	Для Ъ = 0 По ПараметрыЗапроса.ВГраница() Цикл
		Если ТипЗнч(ПараметрыЗапроса[Ъ]) = Тип("Массив") Тогда
			ПараметрыЗапроса[Ъ] = СтрСоединить(ПараметрыЗапроса[Ъ], ", ");
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтрокуИзМассива(ТекстЗапроса, ПараметрыЗапроса);
	Карта.Вставить(ИмяОбъекта, ТекстЗапроса);
	
КонецПроцедуры	

Процедура ВыполнитьКартуЗапросов(Connection, КартаЗапросов, ВнешниеНаборыДанных) Экспорт
	var SQLQueryText;
	
	Если Connection = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Ъ Из КартаЗапросов Цикл

		Если Не ВнешниеНаборыДанных.Свойство(Ъ.Ключ) Тогда
			ВнешниеНаборыДанных.Вставить(Ъ.Ключ, Неопределено);
		КонецЕсли;
		RecordSet = GetRecordSet(Connection, Ъ.Значение);
		FillDataSetFromRecordSet(RecordSet, ВнешниеНаборыДанных[Ъ.Ключ]);
		
	КонецЦикла;
	
КонецПроцедуры	


