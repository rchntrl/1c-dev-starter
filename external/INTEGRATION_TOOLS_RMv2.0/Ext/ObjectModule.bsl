	HTTPЗапрос	= Новый HTTPЗапрос(СтруктураURL.endpoint, Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(JSONRequest);	
	

	Если СтруктураURL.isSSL Тогда
		СертификатыУЦ = Новый СертификатыУдостоверяющихЦентровОС();
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, СертификатыУЦ);
