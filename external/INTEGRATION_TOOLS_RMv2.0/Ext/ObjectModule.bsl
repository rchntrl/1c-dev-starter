#Область УчетныеДанные

// Возвращает описание учетных данных обработки, хранимых в безопасном хранилище.
// Состав credentials зависит от Идентификатор: см. ИдентификаторУчетныхДанныхПоУмолчанию
// (Keycloak) и ИдентификаторУчетныхДанныхSQL (ADO-подключение к SQL).
//
// Параметры:
//   Идентификатор - Строка, Неопределено - владелец данных в регистре БезопасноеХранилищеДанных;
//                     если не задан, используется ИдентификаторУчетныхДанныхПоУмолчанию().
//
// Возвращаемое значение:
//   Структура - описание учетных данных:
//     * id          - Строка - владелец данных в регистре БезопасноеХранилищеДанных.
//     * credentials - Структура - учетные данные со значениями по умолчанию.
//                       Пустое сохраненное значение заменяется значением по умолчанию.
//     * secretkeys  - Строка - имена секретных полей credentials через запятую:
//                       их значения не передаются в форму и вводятся в режиме пароля.
//
Функция ОписаниеУчетныхДанных(Идентификатор = Неопределено) Экспорт

	Если Идентификатор = Неопределено Тогда
		Идентификатор = ИдентификаторУчетныхДанныхПоУмолчанию();
	КонецЕсли;

	Если Идентификатор = ИдентификаторУчетныхДанныхSQL() Тогда

		// Параметры ADO-подключения, см. ПодключитьсяКSQL.
		УчетныеДанные = Новый Структура("server, database, username, password",
			"",
			"",
			"",
			""
		);

		Возврат Новый Структура("id, credentials, secretkeys",
			Идентификатор,
			УчетныеДанные,
			"password"
		);

	КонецЕсли;

	// Keycloak (password grant) по умолчанию.
	УчетныеДанные = Новый Структура("token_url, username, password, scope, client_id, client_secret",
		"",
		"",
		"",
		"openid",
		"",
		""
	);

	Возврат Новый Структура("id, credentials, secretkeys",
		Идентификатор,
		УчетныеДанные,
		"password,client_secret"
	);

КонецФункции

// Возвращает описания всех учетных записей обработки по их идентификаторам.
// Шаблон возвращает две записи для примера — Keycloak по умолчанию и SQL;
// обработка с другим набором учетных записей переопределяет этот метод.
//
// Возвращаемое значение:
//   Структура - ключ - идентификатор учетной записи, значение - см. ОписаниеУчетныхДанных.
//
Функция ОписаниеУчетныхЗаписей() Экспорт

	Результат = Новый Структура;

	Идентификатор = ИдентификаторУчетныхДанныхПоУмолчанию();
	Результат.Вставить(Идентификатор, ОписаниеУчетныхДанных(Идентификатор));

	ИдентификаторSQL = ИдентификаторУчетныхДанныхSQL();
	Результат.Вставить(ИдентификаторSQL, ОписаниеУчетныхДанных(ИдентификаторSQL));

	Возврат Результат;

КонецФункции

// Возвращает описание учетных данных, заполненное значениями из безопасного хранилища.
//
// Параметры:
//   Идентификатор    - Строка, Неопределено - см. ОписаниеУчетныхДанных.
//   СкрыватьСекреты - Булево - если Истина, значения секретных полей не возвращаются.
//
// Возвращаемое значение:
//   Структура - см. ОписаниеУчетныхДанных, дополнительно:
//     * saved - Структура - ключ - имя секретного поля, значение - Булево, сохранено ли значение.
//
Функция ПрочитатьУчетныеДанные(Идентификатор = Неопределено, СкрыватьСекреты = Ложь) Экспорт

	Описание = ОписаниеУчетныхДанных(Идентификатор);
	СекретныеКлючи = Новый Структура(Описание.secretkeys);

	Ключи = Новый Массив;
	Для Каждого Поле Из Описание.credentials Цикл
		Ключи.Добавить(Поле.Ключ);
	КонецЦикла;

	СохраненныеДанные = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Описание.id, СтрСоединить(Ключи, ","));

	Сохраненные = Новый Структура;
	Для Каждого Ключ Из Ключи Цикл
		Значение = СохраненныеДанные[Ключ];
		Если ЗначениеЗаполнено(Значение) Тогда
			Описание.credentials[Ключ] = Значение;
		КонецЕсли;
		Если СекретныеКлючи.Свойство(Ключ) Тогда
			Сохраненные.Вставить(Ключ, ЗначениеЗаполнено(Значение));
			Если СкрыватьСекреты Тогда
				Описание.credentials[Ключ] = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Описание.Вставить("saved", Сохраненные);

	Возврат Описание;

КонецФункции

// Записывает учетные данные в безопасное хранилище и сбрасывает полученный токен.
// Пустые значения секретных полей не перезаписывают сохраненные.
//
// Параметры:
//   Данные        - Структура - значения полей, см. ОписаниеУчетныхДанных.credentials.
//   Идентификатор - Строка, Неопределено - см. ОписаниеУчетныхДанных.
//
Процедура ЗаписатьУчетныеДанные(Данные, Идентификатор = Неопределено) Экспорт

	Описание = ОписаниеУчетныхДанных(Идентификатор);
	СекретныеКлючи = Новый Структура(Описание.secretkeys);

	НачатьТранзакцию();
	Попытка
		Для Каждого Поле Из Описание.credentials Цикл
			Значение = Неопределено;
			Если Не Данные.Свойство(Поле.Ключ, Значение) Тогда
				Продолжить;
			КонецЕсли;
			Значение = СокрЛП(Значение);
			Если СекретныеКлючи.Свойство(Поле.Ключ) И ПустаяСтрока(Значение) Тогда
				Продолжить;
			КонецЕсли;
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Описание.id, Значение, Поле.Ключ);
		КонецЦикла;
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Описание.id, "access_token,token_expires");
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(ПолучитьИмяСобытия("УчетныеДанные"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Возвращает действующий токен доступа из безопасного хранилища.
//
// Параметры:
//   ТокенДоступа - Строка - выходной: access_token; пустая строка, если токена нет или срок истек.
//   Сообщение    - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Ложь, если токен прочитать не удалось.
//
Функция ПрочитатьТокенДоступа(ТокенДоступа, Сообщение)

	ТокенДоступа = "";

	Попытка
		Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторУчетныхДанныхПоУмолчанию(),
			"access_token,token_expires"
		);
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Если ЗначениеЗаполнено(Токен.access_token)
		И ТипЗнч(Токен.token_expires) = Тип("Дата")
		И ТекущаяДатаСеанса() < Токен.token_expires Тогда
		ТокенДоступа = Токен.access_token;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Записывает токен доступа и срок его истечения в безопасное хранилище.
//
// Параметры:
//   ТокенДоступа  - Строка - access_token.
//   СрокИстечения - Дата - дата сеанса, до которой токен считается действующим.
//   Сообщение     - Строка - выходной: описание ошибки.
//
// Возвращаемое значение:
//   Булево - Ложь, если токен записать не удалось.
//
Функция ЗаписатьТокенДоступа(ТокенДоступа, СрокИстечения, Сообщение)

	Идентификатор = ИдентификаторУчетныхДанныхПоУмолчанию();

	Попытка
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Идентификатор, ТокенДоступа, "access_token");
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Идентификатор, СрокИстечения, "token_expires");
	Исключение
		Сообщение = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Функция ИдентификаторУчетныхДанныхПоУмолчанию()

	Возврат "INTEGRATION_TOOLS_RM_v2";

КонецФункции

