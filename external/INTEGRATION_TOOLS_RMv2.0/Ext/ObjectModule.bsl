#Region Визуализация

Функция НавигацияВОтчетеПоСсылке(ТабДок, АбсолютныйАдрес, ИмяМакета, ИмяОбъекта, Сообщение) Экспорт
	
	НаборТаблиц = Новый Структура(ИмяОбъекта);
	
	Если FollowRelatedLink(АбсолютныйАдрес, НаборТаблиц[ИмяОбъекта], Сообщение) Тогда
	
		ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);	
		ВывестиДанныеЧерезСКД(ИмяМакета,,, НаборТаблиц,, ТабДок, ВыходныеДанные);	
		ВыходныеДанные.Свойство("ДанныеРасшифровки", АдресВременноеХранилище);
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Процедура ПрименитьВизуализацию(Действие, ДопПараметры = Неопределено) Экспорт
	Перем НаборТаблиц, Сообщение;
	
	ДатаСеансаТекущая = ТекущаяДатаСеанса();
	ПараметрыОтчета = Новый Структура("ТекДата", ДатаСеансаТекущая);
	
	ВыходныеДанные = Новый Структура("ДанныеРасшифровки", УникальныйИдентификатор);
	
	Если ТребуетсяПодтянутьВнешниеДанные(Действие, ПараметрыОтчета, НаборТаблиц, Сообщение) Тогда
		Если НаборТаблиц = Неопределено Тогда
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ВывестиДанныеЧерезСКД(Действие,, ПараметрыОтчета, НаборТаблиц,, Визуализация, ВыходныеДанные);
	
	ВыходныеДанные.Свойство("ДанныеРасшифровки", ДанныеРасшифровки);
		
КонецПроцедуры

Функция ТребуетсяПодтянутьВнешниеДанные(Действие, ПараметрыОтчета, НаборТаблиц, Сообщение)
	
	Перем Отклик;

	Если Действие = "COMMAND1" Тогда
		Если Не ПроверитьЗаполнение() Тогда
			Сообщение = "Заполните параметры";
			Возврат Истина;
		КонецЕсли;

	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

#Region API_Helper

Function wrapfor(this, ServiceName = "MyService")
	
	this = New Structure("ServiceName, URI, Headers",
		ServiceName
	);
	
	// headers
	this.headers = new Map();
	
EndFunction 

Function GetUnixTimeDecodeParams(СписокСвойств = "Date")
	
	ИменаПолейТипаДата = Новый Массив();
	ИменаПолейТипаДата = СтрРазделить(СписокСвойств, ",");
	
	UnixTimeDecodeParams = Новый Структура();
	UnixTimeDecodeParams.Вставить("ИменаСвойствДляОбработкиВосстановления", ИменаПолейТипаДата);
	UnixTimeDecodeParams.Вставить("ИмяФункцииВосстановления", "ВосстановлениеUnixTimeStamp");
	UnixTimeDecodeParams.Вставить("МодульФункцииВосстановления", ЭтотОбъект);
	
	Return UnixTimeDecodeParams;
EndFunction

Функция FollowRelatedLink(AbsoluteURL, Отклик, Сообщение)
	var this, HTTPОтвет;
	wrapfor(this);

	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Заголовки", this.headers);	
	ДопПараметры.Вставить("ПараметрыПреобразованияJSON", GetUnixTimeDecodeParams());
	
	Попытка
		Отклик = getJSONQuery(AbsoluteURL,, ДопПараметры, HTTPОтвет);
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщение = СтрШаблон("StatusCode %1", HTTPОтвет.КодСостояния);
			Возврат Ложь;
		КонецЕсли;
		Если ИнтерактивныйРежим Тогда
			JSONRequest = AbsoluteURL;
			JSONResponse = HTTPОтвет.ПолучитьТелоКакСтроку();			
		КонецЕсли;
	Исключение
		Сообщение = ОписаниеОшибки(); 
		Возврат Ложь;	
	КонецПопытки;

	Возврат Истина;
КонецФункции

Function IsDataGotten(path, RequestData, ResponseData, Сообщение)
	var this, HTTPОтвет;
	wrapfor(this);
	
	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Заголовки", this.headers);
	ДопПараметры.Вставить("Таймаут", 180);	
	ДопПараметры.Вставить("ПараметрыПреобразованияJSON", GetUnixTimeDecodeParams());
	
	Попытка
		ResponseData = getJSONQuery(this.URI + path, RequestData, ДопПараметры, HTTPОтвет);
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Сообщение = СтрШаблон("StatusCode %1", HTTPОтвет.КодСостояния);
			Возврат Ложь;
		КонецЕсли;
			
		Если ИнтерактивныйРежим Тогда
			JSONResponse = HTTPОтвет.ПолучитьТелоКакСтроку();
		КонецЕсли;

	Исключение
		Сообщение = ОписаниеОшибки();
		Возврат Ложь;	
	КонецПопытки;
	
	Возврат Истина;
EndFunction

